new file mode 100644
index 0000000..006a8b3
--- /dev/null
+++ b/src-tauri/icons/app-icon.svg
@@ -0,0 +1,28 @@
+<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
+  <defs>
+    <linearGradient id="obsidian" x1="128" y1="96" x2="896" y2="928" gradientUnits="userSpaceOnUse">
+      <stop stop-color="#1B1B1D"/>
+      <stop offset="0.55" stop-color="#0B0B0C"/>
+      <stop offset="1" stop-color="#151413"/>
+    </linearGradient>
+    <linearGradient id="gold" x1="270" y1="236" x2="770" y2="808" gradientUnits="userSpaceOnUse">
+      <stop stop-color="#F0D7A1"/>
+      <stop offset="0.5" stop-color="#D1B273"/>
+      <stop offset="1" stop-color="#9D7840"/>
+    </linearGradient>
+    <filter id="shadow" x="-40%" y="-40%" width="180%" height="180%">
+      <feGaussianBlur stdDeviation="22"/>
+    </filter>
+  </defs>
+  <rect x="38" y="38" width="948" height="948" rx="224" fill="#050506"/>
+  <rect x="66" y="66" width="892" height="892" rx="202" fill="url(#obsidian)" stroke="#3A3328" stroke-width="4"/>
+  <path d="M188 760 760 188h108L296 760H188Z" fill="#D1B273" opacity=".04"/>
+  <path d="M248 812 812 248" stroke="#D1B273" stroke-width="3" opacity=".15"/>
+  <circle cx="512" cy="512" r="304" fill="#D1B273" opacity=".1" filter="url(#shadow)"/>
+  <circle cx="512" cy="512" r="292" fill="#0C0C0D" stroke="url(#gold)" stroke-width="18"/>
+  <path d="M333 316h258v84H431v84h134v82H431v166h-98V316Z" fill="url(#gold)"/>
+  <path d="M554 431 742 544 554 657V431Z" fill="url(#gold)"/>
+  <path d="M589 372 760 475" stroke="#E9CF99" stroke-width="12" stroke-linecap="round" opacity=".34"/>
+  <circle cx="292" cy="744" r="10" fill="#E9CF99"/>
+  <path d="M326 744h370" stroke="#D1B273" stroke-width="9" stroke-linecap="round" opacity=".42"/>
+</svg>
