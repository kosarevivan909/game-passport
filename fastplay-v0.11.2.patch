+++ b/scripts/updater-manifest.mjs
@@ -0,0 +1,31 @@
+import { readFile, writeFile, stat } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export function makeManifest(version, tag, assets) {
+  if (!/^\d+\.\d+\.\d+$/.test(version) || !/^[\w.-]+$/.test(tag)) throw new Error('Invalid release identity');
+  const platforms = {};
+  for (const [kind, asset] of Object.entries(assets)) {
+    if (!['nsis', 'msi'].includes(kind) || !asset.name.includes(version) || !asset.signature?.trim()) throw new Error('Missing or invalid signed installer');
+    const expectedName = kind === 'nsis' ? `FastPlay_${version}_x64-setup.exe` : `FastPlay_${version}_x64_ru-RU.msi`;
+    if (asset.name !== expectedName) throw new Error('Unexpected installer name');
+    platforms[`windows-x86_64-${kind}`] = {
+      signature: asset.signature.trim(),
+      url: `https://github.com/kosarevivan909/game-passport/releases/download/${tag}/${encodeURIComponent(asset.name)}`,
+    };
+  }
+  if (!platforms['windows-x86_64-nsis'] || !platforms['windows-x86_64-msi']) throw new Error('Both installer types required');
+  return { version, notes: 'Обновление FastPlay. Профили и игровые настройки не удаляются.', pub_date: new Date().toISOString(), platforms };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const [directory, tag] = process.argv.slice(2);
+  if (!directory || !tag) throw new Error('Usage: updater-manifest.mjs artifact-directory release-tag');
+  const { version } = JSON.parse(await readFile(new URL('../package.json', import.meta.url), 'utf8'));
+  const assets = {};
+  for (const [kind, name] of Object.entries({ nsis: `FastPlay_${version}_x64-setup.exe`, msi: `FastPlay_${version}_x64_ru-RU.msi` })) {
+    if ((await stat(resolve(directory, name))).size === 0) throw new Error('Empty installer');
+    assets[kind] = { name, signature: await readFile(resolve(directory, `${name}.sig`), 'utf8') };
+  }
+  await writeFile(resolve(directory, 'latest.json'), JSON.stringify(makeManifest(version, tag, assets), null, 2) + '\n');
+}
