+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeManifest } from './updater-manifest.mjs';
+const assets = {
+  nsis: { name: 'FastPlay_0.11.2_x64-setup.exe', signature: 'signed-exe' },
+  msi: { name: 'FastPlay_0.11.2_x64_ru-RU.msi', signature: 'signed-msi' },
+};
+test('retains installer type and immutable release URLs', () => {
+  const value = makeManifest('0.11.2', 'public-33', assets);
+  assert.match(value.platforms['windows-x86_64-nsis'].url, /public-33\/FastPlay_0.11.2_x64-setup.exe$/);
+  assert.match(value.platforms['windows-x86_64-msi'].url, /\.msi$/);
+  assert.equal(value.platforms['windows-x86_64-msi'].signature, 'signed-msi');
+  assert.equal(value.platforms['windows-x86_64'], undefined);
+});
+test('rejects absent signatures, missing installer types and wrong version', () => {
+  assert.throws(() => makeManifest('0.11.2', 'public-33', { nsis: assets.nsis }));
+  assert.throws(() => makeManifest('0.11.2', 'public-33', { ...assets, nsis: { ...assets.nsis, signature: '' } }));
+  assert.throws(() => makeManifest('0.11.3', 'public-33', assets));
+  assert.throws(() => makeManifest('0.11.2', '../other', assets));
+});
