@@ -0,0 +1,78 @@
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { beforeEach, afterEach, describe, expect, it, vi } from "vitest";
+import { useAppUpdate } from "../services/useAppUpdate";
+const mocks = vi.hoisted(() => ({ check: vi.fn(), desktop: vi.fn(), status: vi.fn() }));
+vi.mock("@tauri-apps/plugin-updater", () => ({ check: mocks.check }));
+vi.mock("../services/platform", () => ({ isTauriDesktop: mocks.desktop }));
+vi.mock("../services/applyLock", () => ({ applyLock: { status: mocks.status } }));
+
+describe("in-app updates", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.desktop.mockReturnValue(true);
+    mocks.status.mockResolvedValue({ state: "success", active: false });
+    mocks.check.mockResolvedValue(null);
+  });
+  afterEach(() => vi.useRealTimers());
+  it("automatically checks when idle, without installing", async () => {
+    vi.useFakeTimers();
+    const downloadAndInstall = vi.fn();
+    mocks.check.mockResolvedValue({ version: "0.12.0", close: vi.fn(), downloadAndInstall });
+    const { result } = renderHook(() => useAppUpdate(false));
+    await act(() => vi.advanceTimersByTimeAsync(3000));
+    expect(result.current.state).toBe("available");
+    expect(downloadAndInstall).not.toHaveBeenCalled();
+  });
+  it("does not check in browser preview", async () => {
+    mocks.desktop.mockReturnValue(false);
+    const { result } = renderHook(() => useAppUpdate(false));
+    await act(() => result.current.checkNow());
+    expect(mocks.check).not.toHaveBeenCalled();
+  });
+  it("blocks updates during operations and unsaved edits", async () => {
+    const { result } = renderHook(() => useAppUpdate(true));
+    await act(() => result.current.checkNow());
+    await act(() => result.current.install());
+    expect(mocks.check).not.toHaveBeenCalled();
+  });
+  it("does not call a failed network check an up-to-date version", async () => {
+    mocks.check.mockRejectedValue(new Error("offline"));
+    const { result } = renderHook(() => useAppUpdate(false));
+    await act(() => result.current.checkNow());
+    expect(result.current.state).toBe("error");
+    mocks.check.mockResolvedValue(null);
+    await act(() => result.current.checkNow());
+    expect(result.current.state).toBe("current");
+  });
+  it.each([{ active: true }, { active: false, interrupted: {} }, { state: "error" }])("rechecks native operation lock before installation: %j", async (lock) => {
+    const downloadAndInstall = vi.fn();
+    mocks.check.mockResolvedValue({ version: "0.12.0", close: vi.fn(), downloadAndInstall });
+    mocks.status.mockResolvedValue({ state: "success", ...lock });
+    const { result } = renderHook(() => useAppUpdate(false));
+    await act(() => result.current.checkNow());
+    await act(() => result.current.install());
+    expect(downloadAndInstall).not.toHaveBeenCalled();
+    expect(result.current.state).toBe("error");
+  });
+  it("signature/download failure is an error, not success", async () => {
+    const downloadAndInstall = vi.fn().mockRejectedValue(new Error("invalid signature"));
+    mocks.check.mockResolvedValue({ version: "0.12.0", close: vi.fn(), downloadAndInstall });
+    const { result } = renderHook(() => useAppUpdate(false));
+    await act(() => result.current.checkNow());
+    await act(() => result.current.install());
+    expect(downloadAndInstall).toHaveBeenCalledOnce();
+    expect(result.current.state).toBe("error");
+  });
+  it("releases a pending check result after unmount", async () => {
+    let resolve!: (value: unknown) => void;
+    mocks.check.mockImplementation(() => new Promise((r) => { resolve = r; }));
+    const close = vi.fn().mockResolvedValue(undefined);
+    const { result, unmount } = renderHook(() => useAppUpdate(false));
+    let task!: Promise<void>;
+    act(() => { task = result.current.checkNow(); });
+    unmount();
+    resolve({ close });
+    await task;
+    await waitFor(() => expect(close).toHaveBeenCalledOnce());
+  });
+});
