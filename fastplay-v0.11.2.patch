new file mode 100644
index 0000000..a427564
--- /dev/null
+++ b/src/services/useAppUpdate.ts
@@ -0,0 +1,87 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { check, type Update } from "@tauri-apps/plugin-updater";
+import { isTauriDesktop } from "./platform";
+import { applyLock } from "./applyLock";
+
+export type UpdateState = "idle" | "checking" | "available" | "current" | "installing" | "error";
+
+// Automatic checks, explicit installation only on an idle dashboard.
+export function useAppUpdate(blocked: boolean) {
+  const [state, setState] = useState<UpdateState>("idle");
+  const [version, setVersion] = useState("");
+  const [message, setMessage] = useState("");
+  const [percent, setPercent] = useState<number>();
+  const update = useRef<Update | null>(null);
+  const busy = useRef(false);
+  const mounted = useRef(false);
+  const blockedRef = useRef(blocked);
+  blockedRef.current = blocked;
+  const enabled = isTauriDesktop();
+
+  const checkNow = useCallback(async () => {
+    if (!enabled || busy.current || blockedRef.current) return;
+    busy.current = true;
+    setState("checking");
+    setMessage("");
+    try {
+      const next = await check({ timeout: 20_000 });
+      if (!mounted.current) { await next?.close(); return; }
+      await update.current?.close();
+      update.current = next;
+      setVersion(next?.version ?? "");
+      setState(next ? "available" : "current");
+    } catch {
+      if (mounted.current) {
+        setState("error");
+        setMessage("Не удалось проверить обновления. Приложением можно пользоваться. Повторите позже.");
+      }
+    } finally { busy.current = false; }
+  }, [enabled]);
+
+  const install = useCallback(async () => {
+    if (!enabled || busy.current || blockedRef.current || !update.current) return;
+    busy.current = true;
+    setState("installing");
+    setPercent(undefined);
+    setMessage("Скачиваем обновление. FastPlay закроется для установки; профили сохранятся.");
+    try {
+      const lock = await applyLock.status();
+      if (lock.state !== "success" || lock.active || lock.interrupted || blockedRef.current) throw new Error("operation-active");
+      let downloaded = 0;
+      let total: number | undefined;
+      await update.current.downloadAndInstall((event) => {
+        if (!mounted.current) return;
+        if (event.event === "Started") total = event.data.contentLength;
+        if (event.event === "Progress") {
+          downloaded += event.data.chunkLength;
+          if (total) setPercent(Math.min(100, Math.round(downloaded / total * 100)));
+        }
+        if (event.event === "Finished") setMessage("Загрузка завершена. Проверяем подпись и запускаем установку…");
+      }, { timeout: 10 * 60 * 1000 });
+      // Launching the installer is not proof that installation succeeded.
+      if (mounted.current) setMessage("Установщик запущен. Дождитесь его завершения и откройте FastPlay.");
+    } catch {
+      if (mounted.current) {
+        setState("error");
+        setMessage("Обновление не установлено. Проверьте интернет и завершите операции с профилями, затем повторите проверку.");
+      }
+      busy.current = false;
+    }
+  }, [enabled]);
+
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+      void Promise.resolve(update.current?.close()).catch(() => undefined);
+      update.current = null;
+    };
+  }, []);
+  useEffect(() => {
+    if (blocked) return;
+    const startup = window.setTimeout(() => void checkNow(), 3_000);
+    const interval = window.setInterval(() => void checkNow(), 6 * 60 * 60 * 1000);
+    return () => { window.clearTimeout(startup); window.clearInterval(interval); };
+  }, [blocked, checkNow]);
+  return { enabled, state, version, message, percent, checkNow, install };
+}
