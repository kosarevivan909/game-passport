       <div className="sidebar-bottom"><div className={`cloud-state ${cloudState}`}>{cloudState === "connected" ? <Cloud size={17} /> : <CloudOff size={17} />}<span><strong>{cloudLabel(cloudState)}</strong><small>{cloudDetail(cloudState)}</small></span></div><div className="account"><span>{user.email.slice(0, 1).toUpperCase()}</span><div><strong>{user.email.split("@")[0]}</strong><small>{user.email}</small></div><button className="icon-button" aria-label="Выйти" onClick={onSignOut}><LogOut size={17} /></button></div></div>
     </aside>
-    {view === "setup" ? <InitialSetup mode={services.mode} cloudState={cloudState} refreshCloud={refreshCloud} onContinue={() => { localStorage.setItem("game-passport.initial-setup.v1", new Date().toISOString()); setView("profiles"); }} /> : view === "validation" ? <FieldValidationWizard profiles={profiles} mode={services.mode} onRun={(profile, type) => beginOperation(profile, type, "validation")} /> : view === "diagnostics" ? <Diagnostics mode={services.mode} cloudState={cloudState} /> : <main className="content-view">
+    {view === "setup" ? <InitialSetup mode={services.mode} cloudState={cloudState} refreshCloud={refreshCloud} onContinue={() => { localStorage.setItem("game-passport.initial-setup.v1", new Date().toISOString()); setView("profiles"); }} /> : view === "validation" ? <FieldValidationWizard profiles={profiles} mode={services.mode} onRun={(profile, type) => beginOperation(profile, type, "validation")} /> : view === "diagnostics" ? <Diagnostics mode={services.mode} cloudState={cloudState} license={license} /> : <main className="content-view">
       <div className="page-heading"><div><p className="eyebrow">БИБЛИОТЕКА НАСТРОЕК</p><h1>Игровые профили</h1><p>Ваши настройки готовы для следующего компьютера.</p></div><div className="heading-actions"><button className="button primary" disabled={profiles.length >= 5} onClick={() => setModal({})}><Plus size={18} /> Новый профиль</button></div></div>
       <div className="limit-strip"><span><strong>{profiles.length}</strong> из 5 профилей</span><div><i style={{ width: `${profiles.length * 20}%` }} /></div><small>{profiles.length >= 5 ? "Достигнут лимит профилей" : `Свободно мест: ${5 - profiles.length}`}</small></div>
       {error && <div className="form-error page-error" role="alert">{error}<button onClick={() => setError("")}>Закрыть</button></div>}
-      {loading ? <div className="loading-grid"><span /><span /><span /></div> : profiles.length === 0 ? <section className="empty-state"><div className="empty-icon"><Save size={28} /></div><p className="eyebrow">ПАСПОРТ ПУСТ</p><h2>Создайте первый игровой профиль</h2><p>Создайте профиль CS2 или PUBG, закройте игру, затем сохраните настройки игры, экрана, NVIDIA и мыши.</p><button className="button primary" onClick={() => setModal({})}><Plus size={18} /> Создать профиль</button></section> : <section className="profile-grid">{profiles.map((profile) => <ProfileCard key={profile.id} profile={profile} onCapture={() => beginOperation(profile, "capture")} onApply={() => beginOperation(profile, "apply")} onRestore={() => beginOperation(profile, "restore")} onEdit={() => setModal({ profile })} onDelete={() => void remove(profile)} />)}<button className="add-card" disabled={profiles.length >= 5} onClick={() => setModal({})}><Plus size={25} /><strong>Добавить профиль</strong><span>{profiles.length >= 5 ? "Достигнут максимум" : "Создать ещё один набор"}</span></button></section>}
-      <section className="foundation-note"><div><Activity size={20} /><span><strong>Экран + NVIDIA + мышь + CS2 + PUBG · Windows</strong>Настройки применяются безопасно до запуска игры, с локальными резервными копиями.</span></div><button className="text-button" onClick={() => setView("diagnostics")}>Открыть диагностику →</button></section>
+      {interrupted && <section className="recovery-banner"><TriangleAlert size={23} /><div><strong>Предыдущее применение было прервано</strong><span>Управление Windows уже разблокировано. Можно восстановить единый набор резервных копий операции для профиля «{interrupted.profileName}».</span></div>{profiles.find((profile) => profile.id === interrupted.profileId) && <button className="button secondary" onClick={() => setOperation({ profile: profiles.find((profile) => profile.id === interrupted.profileId)!, type: "restore", returnView: "profiles", recovery: true })}>Восстановить</button>}<button className="text-button" onClick={() => void applyLock.clearInterrupted().then(() => setInterrupted(undefined))}>Закрыть сообщение</button></section>}
+      {loading ? <div className="loading-grid"><span /><span /><span /></div> : profiles.length === 0 ? <section className="empty-state"><div className="empty-icon"><Save size={28} /></div><p className="eyebrow">ПРОФИЛЕЙ ПОКА НЕТ</p><h2>Создайте первый игровой профиль</h2><ol><li>Настройте компьютер под себя.</li><li>Закройте игру.</li><li>Нажмите «Сохранить текущие настройки».</li></ol><button className="button primary" onClick={() => { setCaptureAfterCreate(true); setModal({}); }}><Save size={18} /> Сохранить текущие настройки</button></section> : <section className="profile-grid">{profiles.map((profile) => <ProfileCard key={profile.id} profile={profile} onCapture={() => beginOperation(profile, "capture")} onApply={() => beginOperation(profile, "apply")} onRestore={() => beginOperation(profile, "restore")} onEdit={() => setModal({ profile })} onDelete={() => setDeleting(profile)} />)}<button className="add-card" disabled={profiles.length >= 5} onClick={() => setModal({})}><Plus size={25} /><strong>Добавить профиль</strong><span>{profiles.length >= 5 ? "Достигнут максимум" : "Создать ещё один набор"}</span></button></section>}
+      <section className="foundation-note"><div><Activity size={20} /><span><strong>Экран + NVIDIA + CS2 + PUBG + Valorant · Windows</strong>Настройки применяются до запуска игры, проверяются повторным чтением и имеют локальные резервные копии.</span></div><button className="text-button" onClick={() => setView("diagnostics")}>Открыть диагностику →</button></section>
     </main>}
-    {modal && <ProfileModal profile={modal.profile} onClose={() => setModal(null)} onSave={save} />}
+    {modal && <ProfileModal profile={modal.profile} onClose={() => { setCaptureAfterCreate(false); setModal(null); }} onSave={save} />}
+    {deleting && <div className="modal-backdrop" role="presentation" onMouseDown={(event) => event.target === event.currentTarget && setDeleting(null)}><section className="modal confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-profile-title"><p className="eyebrow">УДАЛЕНИЕ ПРОФИЛЯ</p><h2 id="delete-profile-title">Удалить «{deleting.name}»?</h2><p className="muted">Профиль исчезнет из облака и со всех компьютеров. Это действие нельзя отменить.</p><div className="modal-actions"><button className="button secondary" onClick={() => setDeleting(null)}>Отмена</button><button className="button danger-button" onClick={() => void remove(deleting)}>Удалить профиль</button></div></section></div>}
+    {onboarding && <Onboarding onComplete={() => setOnboarding(false)} />}
   </div>;
 }
 
