+    fn most_recent_account_id(steam_root: &Path) -> Option<u32> {
+        let text = fs::read_to_string(steam_root.join("config").join("loginusers.vdf")).ok()?;
+        let mut current_id = None;
+        for line in text.lines() {
+            let tokens = quoted_tokens(line);
+            if tokens.len() == 1 && tokens[0].chars().all(|value| value.is_ascii_digit()) {
+                current_id = tokens[0]
+                    .parse::<u64>()
+                    .ok()
+                    .map(|steam_id| (steam_id & u32::MAX as u64) as u32);
+            } else if tokens.len() >= 2
+                && tokens[0].eq_ignore_ascii_case("MostRecent")
+                && tokens[1] == "1"
+            {
+                return current_id.filter(|id| *id != 0);
+            }
+        }
+        None
+    }
