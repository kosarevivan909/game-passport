+int gp_nvapi_apply_display_controls(const GpNvSnapshot* snapshot,
+                                    GpNvDisplayControlsReport* report,
+                                    char* error, size_t error_size);
 
 #ifdef __cplusplus
 }
diff --git a/src-tauri/src/apply_lock.rs b/src-tauri/src/apply_lock.rs
new file mode 100644
index 0000000..74f3ed5
--- /dev/null
+++ b/src-tauri/src/apply_lock.rs
@@ -0,0 +1,438 @@
+use chrono::Utc;
+use serde::{Deserialize, Serialize};
+use std::{
+    fs,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicBool, AtomicU8, Ordering},
+        mpsc, Mutex,
+    },
+    thread::JoinHandle,
+};
+
+const MARKER_FILE: &str = "apply-operation.json";
+const REASON_NONE: u8 = 0;
+const REASON_EMERGENCY: u8 = 1;
+const REASON_WATCHDOG: u8 = 2;
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static OPERATION_ACTIVE: AtomicBool = AtomicBool::new(false);
+static CANCELLED: AtomicBool = AtomicBool::new(false);
+static REASON: AtomicU8 = AtomicU8::new(REASON_NONE);
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ApplyLockRequest {
+    pub profile_id: String,
+    pub profile_name: String,
+    pub game: String,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct InterruptedApply {
+    pub profile_id: String,
+    pub profile_name: String,
+    pub game: String,
+    pub started_at: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ApplyLockStatus {
+    pub state: String,
+    pub message: String,
+    pub active: bool,
+    pub cancelled: bool,
+    pub reason: Option<String>,
+    pub interrupted: Option<InterruptedApply>,
+}
+
+enum Control {
+    Heartbeat,
+    Stop,
+}
+
+struct Session {
+    sender: mpsc::Sender<Control>,
+    worker: JoinHandle<()>,
+}
+
+#[derive(Default)]
+pub struct ApplyLockManager {
+    session: Mutex<Option<Session>>,
+}
+
+impl ApplyLockManager {
+    pub fn begin(&self, request: ApplyLockRequest) -> ApplyLockStatus {
+        if request.profile_id.trim().is_empty()
+            || request.profile_id.len() > 128
+            || request.profile_name.trim().is_empty()
+            || request.profile_name.len() > 120
+            || !matches!(request.game.as_str(), "cs2" | "pubg" | "valorant")
+        {
+            return response("error", "Некорректные данные операции Apply.");
+        }
+        let mut session = match self.session.lock() {
+            Ok(value) => value,
+            Err(_) => return response("error", "Apply Lock недоступен из-за внутренней ошибки."),
+        };
+        if read_marker().ok().flatten().is_some() {
+            return response(
+                "error",
+                "Сначала восстановите или закройте сообщение о предыдущей прерванной операции.",
+            );
+        }
+        if OPERATION_ACTIVE.swap(true, Ordering::SeqCst) {
+            return response("error", "Другая операция Apply уже выполняется.");
+        }
+        ACTIVE.store(true, Ordering::SeqCst);
+        CANCELLED.store(false, Ordering::SeqCst);
+        REASON.store(REASON_NONE, Ordering::SeqCst);
+        if let Err(message) = write_marker(&request) {
+            ACTIVE.store(false, Ordering::SeqCst);
+            OPERATION_ACTIVE.store(false, Ordering::SeqCst);
+            return response("error", &message);
+        }
+        match platform::start() {
+            Ok(value) => {
+                *session = Some(value);
+                response("success", "Apply Lock включён.")
+            }
+            Err(message) => {
+                ACTIVE.store(false, Ordering::SeqCst);
+                OPERATION_ACTIVE.store(false, Ordering::SeqCst);
+                let _ = clear_marker();
+                response("error", &message)
+            }
+        }
+    }
+
+    pub fn heartbeat(&self) -> ApplyLockStatus {
+        if let Ok(session) = self.session.lock() {
+            if let Some(session) = session.as_ref() {
+                let _ = session.sender.send(Control::Heartbeat);
+            }
+        }
+        current_status()
+    }
+
+    pub fn finish(&self) -> ApplyLockStatus {
+        ACTIVE.store(false, Ordering::SeqCst);
+        OPERATION_ACTIVE.store(false, Ordering::SeqCst);
+        if let Ok(mut session) = self.session.lock() {
+            if let Some(session) = session.take() {
+                let _ = session.sender.send(Control::Stop);
+                let _ = session.worker.join();
+            }
+        }
+        let marker_result = clear_marker();
+        CANCELLED.store(false, Ordering::SeqCst);
+        REASON.store(REASON_NONE, Ordering::SeqCst);
+        match marker_result {
+            Ok(()) => response("success", "Apply Lock снят."),
+            Err(message) => response("warning", &message),
+        }
+    }
+}
+
+pub fn is_active() -> bool {
+    OPERATION_ACTIVE.load(Ordering::SeqCst)
+}
+
+pub fn status() -> ApplyLockStatus {
+    current_status()
+}
+
+pub fn clear_interrupted() -> ApplyLockStatus {
+    match clear_marker() {
+        Ok(()) => response("success", "Сведения о прерванной операции очищены."),
+        Err(message) => response("error", &message),
+    }
+}
+
+fn current_status() -> ApplyLockStatus {
+    let active = OPERATION_ACTIVE.load(Ordering::SeqCst);
+    let cancelled = CANCELLED.load(Ordering::SeqCst);
+    let reason = match REASON.load(Ordering::SeqCst) {
+        REASON_EMERGENCY => Some("emergency_shortcut".to_string()),
+        REASON_WATCHDOG => Some("watchdog_timeout".to_string()),
+        _ => None,
+    };
+    let interrupted = if active {
+        None
+    } else {
+        read_marker().ok().flatten()
+    };
+    ApplyLockStatus {
+        state: "success".into(),
+        message: if cancelled {
+            "Apply Lock остановлен аварийно.".into()
+        } else if active {
+            "Apply Lock активен.".into()
+        } else if interrupted.is_some() {
+            "Обнаружена незавершённая операция Apply.".into()
+        } else {
+            "Apply Lock не активен.".into()
+        },
+        active,
+        cancelled,
+        reason,
+        interrupted,
+    }
+}
+
+fn response(state: &str, message: &str) -> ApplyLockStatus {
+    ApplyLockStatus {
+        state: state.into(),
+        message: message.into(),
+        active: OPERATION_ACTIVE.load(Ordering::SeqCst),
+        cancelled: CANCELLED.load(Ordering::SeqCst),
+        reason: None,
+        interrupted: None,
+    }
+}
+
+pub fn denied(message: String) -> ApplyLockStatus {
+    response("error", &message)
+}
+
+fn marker_path() -> Result<PathBuf, String> {
+    let local = std::env::var_os("LOCALAPPDATA")
+        .ok_or_else(|| "Windows LOCALAPPDATA недоступен для recovery marker.".to_string())?;
+    Ok(PathBuf::from(local)
+        .join("app.gamepassport.desktop")
+        .join(MARKER_FILE))
+}
+
+fn write_marker(request: &ApplyLockRequest) -> Result<(), String> {
+    let path = marker_path()?;
+    let parent = path
+        .parent()
+        .ok_or_else(|| "Некорректный путь recovery marker.".to_string())?;
+    fs::create_dir_all(parent)
+        .map_err(|error| format!("Не удалось создать recovery marker: {error}"))?;
+    let marker = InterruptedApply {
+        profile_id: request.profile_id.clone(),
+        profile_name: request.profile_name.trim().to_string(),
+        game: request.game.clone(),
+        started_at: Utc::now().to_rfc3339(),
+    };
+    let bytes = serde_json::to_vec(&marker).map_err(|error| error.to_string())?;
+    let temporary = path.with_extension(format!("{}.tmp", std::process::id()));
+    if temporary.exists() {
+        fs::remove_file(&temporary)
+            .map_err(|error| format!("Не удалось подготовить recovery marker: {error}"))?;
+    }
+    fs::write(&temporary, bytes)
+        .map_err(|error| format!("Не удалось записать recovery marker: {error}"))?;
+    fs::rename(&temporary, &path).map_err(|error| {
+        let _ = fs::remove_file(&temporary);
+        format!("Не удалось активировать recovery marker: {error}")
+    })
+}
+
+fn read_marker() -> Result<Option<InterruptedApply>, String> {
+    let path = marker_path()?;
+    if !path.exists() {
+        return Ok(None);
+    }
+    let bytes = fs::read(path).map_err(|error| error.to_string())?;
+    let marker = serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;
+    Ok(Some(marker))
+}
+
+fn clear_marker() -> Result<(), String> {
+    let path = marker_path()?;
+    if path.exists() {
+        fs::remove_file(path)
+            .map_err(|error| format!("Не удалось очистить recovery marker: {error}"))?;
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+mod platform {
+    use super::*;
+    use std::{mem::zeroed, sync::atomic::AtomicU8, time::Duration};
+    use windows_sys::Win32::{
+        Foundation::{LPARAM, LRESULT, WPARAM},
+        System::LibraryLoader::GetModuleHandleW,
+        UI::{
+            Input::KeyboardAndMouse::{
+                VK_CONTROL, VK_F12, VK_LCONTROL, VK_LMENU, VK_LSHIFT, VK_MENU, VK_RCONTROL,
+                VK_RMENU, VK_RSHIFT, VK_SHIFT,
+            },
+            WindowsAndMessaging::{
+                CallNextHookEx, PeekMessageW, SetWindowsHookExW, UnhookWindowsHookEx,
+                KBDLLHOOKSTRUCT, MSG, PM_REMOVE, WH_KEYBOARD_LL, WH_MOUSE_LL, WM_KEYDOWN, WM_KEYUP,
+                WM_SYSKEYDOWN, WM_SYSKEYUP,
+            },
+        },
+    };
+
+    const CTRL: u8 = 1;
+    const ALT: u8 = 2;
+    const SHIFT: u8 = 4;
+    const WATCHDOG: Duration = Duration::from_secs(120);
+    static MODIFIERS: AtomicU8 = AtomicU8::new(0);
+
+    unsafe extern "system" fn mouse_hook(code: i32, wparam: WPARAM, lparam: LPARAM) -> LRESULT {
+        if code >= 0 && ACTIVE.load(Ordering::SeqCst) {
+            return 1;
+        }
+        unsafe { CallNextHookEx(std::ptr::null_mut(), code, wparam, lparam) }
+    }
+
+    unsafe extern "system" fn keyboard_hook(code: i32, wparam: WPARAM, lparam: LPARAM) -> LRESULT {
+        if code < 0 {
+            return unsafe { CallNextHookEx(std::ptr::null_mut(), code, wparam, lparam) };
+        }
+        let event = wparam as u32;
+        let down = event == WM_KEYDOWN || event == WM_SYSKEYDOWN;
+        let up = event == WM_KEYUP || event == WM_SYSKEYUP;
+        if down || up {
+            let key = unsafe { (*(lparam as *const KBDLLHOOKSTRUCT)).vkCode } as u16;
+            let flag = match key {
+                value if value == VK_CONTROL || value == VK_LCONTROL || value == VK_RCONTROL => {
+                    CTRL
+                }
+                value if value == VK_MENU || value == VK_LMENU || value == VK_RMENU => ALT,
+                value if value == VK_SHIFT || value == VK_LSHIFT || value == VK_RSHIFT => SHIFT,
+                _ => 0,
+            };
+            if flag != 0 {
+                if down {
+                    MODIFIERS.fetch_or(flag, Ordering::SeqCst);
+                } else {
+                    MODIFIERS.fetch_and(!flag, Ordering::SeqCst);
+                }
+            }
+            if down
+                && key == VK_F12
+                && MODIFIERS.load(Ordering::SeqCst) & (CTRL | ALT | SHIFT) == (CTRL | ALT | SHIFT)
+            {
+                CANCELLED.store(true, Ordering::SeqCst);
+                REASON.store(REASON_EMERGENCY, Ordering::SeqCst);
+                ACTIVE.store(false, Ordering::SeqCst);
+                return 1;
+            }
+        }
+        if ACTIVE.load(Ordering::SeqCst) {
+            1
+        } else {
+            unsafe { CallNextHookEx(std::ptr::null_mut(), code, wparam, lparam) }
+        }
+    }
+
+    pub fn start() -> Result<Session, String> {
+        let (sender, receiver) = mpsc::channel();
+        let (startup_sender, startup_receiver) = mpsc::sync_channel(1);
+        let worker = std::thread::spawn(move || {
+            let module = unsafe { GetModuleHandleW(std::ptr::null()) };
+            let mouse = unsafe { SetWindowsHookExW(WH_MOUSE_LL, Some(mouse_hook), module, 0) };
+            let keyboard =
+                unsafe { SetWindowsHookExW(WH_KEYBOARD_LL, Some(keyboard_hook), module, 0) };
+            if mouse.is_null() || keyboard.is_null() {
+                if !mouse.is_null() {
+                    unsafe { UnhookWindowsHookEx(mouse) };
+                }
+                if !keyboard.is_null() {
+                    unsafe { UnhookWindowsHookEx(keyboard) };
+                }
+                ACTIVE.store(false, Ordering::SeqCst);
+                let _ = startup_sender.send(Err(
+                    "Windows не разрешил включить безопасный input lock.".to_string(),
+                ));
+                return;
+            }
+            let _ = startup_sender.send(Ok(()));
+            let mut last_heartbeat = std::time::Instant::now();
+            let mut message: MSG = unsafe { zeroed() };
+            while ACTIVE.load(Ordering::SeqCst) {
+                while unsafe { PeekMessageW(&mut message, std::ptr::null_mut(), 0, 0, PM_REMOVE) }
+                    != 0
+                {}
+                match receiver.recv_timeout(Duration::from_millis(25)) {
+                    Ok(Control::Heartbeat) => last_heartbeat = std::time::Instant::now(),
+                    Ok(Control::Stop) | Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    Err(mpsc::RecvTimeoutError::Timeout) => {}
+                }
+                if last_heartbeat.elapsed() > WATCHDOG {
+                    CANCELLED.store(true, Ordering::SeqCst);
+                    REASON.store(REASON_WATCHDOG, Ordering::SeqCst);
+                    ACTIVE.store(false, Ordering::SeqCst);
+                }
+            }
+            unsafe {
+                UnhookWindowsHookEx(mouse);
+                UnhookWindowsHookEx(keyboard);
+            }
+            MODIFIERS.store(0, Ordering::SeqCst);
+        });
+        match startup_receiver.recv_timeout(std::time::Duration::from_secs(3)) {
+            Ok(Ok(())) => Ok(Session { sender, worker }),
+            Ok(Err(message)) => {
+                let _ = worker.join();
+                Err(message)
+            }
+            Err(_) => {
+                ACTIVE.store(false, Ordering::SeqCst);
+                let _ = sender.send(Control::Stop);
+                let _ = worker.join();
+                Err("Apply Lock не ответил вовремя.".into())
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn invalid_apply_request_is_rejected_before_locking() {
+        let status = ApplyLockManager::default().begin(ApplyLockRequest {
+            profile_id: "".into(),
+            profile_name: "Test".into(),
+            game: "cs2".into(),
+        });
+        assert_eq!(status.state, "error");
+        assert!(!status.active);
+    }
+
+    #[test]
+    fn recovery_marker_contains_only_operation_identity() {
+        let previous = std::env::var_os("LOCALAPPDATA");
+        let root =
+            std::env::temp_dir().join(format!("game-passport-apply-lock-{}", std::process::id()));
+        std::env::set_var("LOCALAPPDATA", &root);
+        let request = ApplyLockRequest {
+            profile_id: "profile-1".into(),
+            profile_name: "Main CS2".into(),
+            game: "cs2".into(),
+        };
+        write_marker(&request).expect("marker should be written");
+        let marker = read_marker()
+            .expect("marker should be readable")
+            .expect("marker should exist");
+        assert_eq!(marker.profile_id, "profile-1");
+        assert_eq!(marker.profile_name, "Main CS2");
+        assert_eq!(marker.game, "cs2");
+        clear_marker().expect("marker should be removed");
+        let _ = fs::remove_dir_all(&root);
+        match previous {
+            Some(value) => std::env::set_var("LOCALAPPDATA", value),
+            None => std::env::remove_var("LOCALAPPDATA"),
+        }
+    }
+}
+
+#[cfg(not(target_os = "windows"))]
+mod platform {
+    use super::*;
+
+    pub fn start() -> Result<Session, String> {
+        Err("Apply Lock поддерживается только в Windows-приложении.".into())
+    }
+}
