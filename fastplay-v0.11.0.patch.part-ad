 } GpNvSnapshot;
 
 typedef struct GpNvApplyReport {
     uint32_t settings_applied;
     uint32_t settings_skipped;
     uint32_t settings_unsupported;
+    uint32_t global_settings_applied;
+    uint32_t global_settings_skipped;
     uint32_t profile_found;
     uint32_t profile_created;
     uint32_t scaling_requested;
@@ -40,6 +55,12 @@ typedef struct GpNvApplyReport {
     char scaling_message[256];
 } GpNvApplyReport;
 
+typedef struct GpNvDisplayControlsReport {
+    uint32_t color_requested;
+    uint32_t color_applied;
+    char color_message[256];
+} GpNvDisplayControlsReport;
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -52,6 +73,9 @@ int gp_nvapi_apply(const GpNvSnapshot* snapshot, uint32_t restore_mode,
                    const uint16_t* executable, const uint16_t* profile_name,
