index bf36aa0..36128e8 100644
--- a/src-tauri/native/nvapi_bridge.cpp
+++ b/src-tauri/native/nvapi_bridge.cpp
@@ -17,8 +17,20 @@ struct PortableSetting {
 
 // Only public DWORD settings from NVIDIA's NvApiDriverSettings.h are accepted.
 static const PortableSetting kPortableSettings[] = {
+    {OGL_CPL_GDI_COMPATIBILITY_ID, "opengl_gdi_compatibility"},
+    {OGL_CPL_PREFER_DXPRESENT_ID, "opengl_dx_present"},
+    {OGL_MAX_FRAMES_ALLOWED_ID, "opengl_max_queued_frames"},
+    {OGL_QUALITY_ENHANCEMENTS_ID, "opengl_texture_filtering_quality"},
+    {OGL_THREAD_CONTROL_ID, "opengl_threaded_optimization"},
+    {OGL_TRIPLE_BUFFER_ID, "opengl_triple_buffering"},
+    {AA_MODE_ALPHATOCOVERAGE_ID, "antialiasing_transparency"},
+    {AA_MODE_GAMMACORRECTION_ID, "antialiasing_gamma_correction"},
+    {AA_MODE_METHOD_ID, "antialiasing_mode_method"},
+    {AA_MODE_REPLAY_ID, "antialiasing_replay"},
+    {AA_MODE_SELECTOR_ID, "antialiasing_mode_selector"},
     {PREFERRED_PSTATE_ID, "power_management_mode"},
     {FRL_FPS_ID, "max_frame_rate"},
+    {APPIDLE_DYNAMIC_FRL_FPS_ID, "background_max_frame_rate"},
     {VSYNCMODE_ID, "vertical_sync"},
     {QUALITY_ENHANCEMENTS_ID, "texture_filtering_quality"},
     {PS_SHADERDISKCACHE_ID, "shader_cache"},
@@ -33,6 +45,17 @@ static const PortableSetting kPortableSettings[] = {
     {FXAA_ENABLE_ID, "fxaa"},
     {MAXWELL_B_SAMPLE_INTERLEAVE_ID, "mfaa"},
     {REFRESH_RATE_OVERRIDE_ID, "preferred_refresh_rate"},
+    {NV_QUALITY_UPSCALING_ID, "image_scaling"},
+    {PREVENT_UI_AF_OVERRIDE_ID, "application_controlled_anisotropic_filtering"},
+    {VRPRERENDERLIMIT_ID, "vr_pre_rendered_frames"},
+    {VRR_APP_OVERRIDE_ID, "vrr_application_override"},
+    {VSYNCVRRCONTROL_ID, "vrr_vertical_sync_control"},
+    {AO_MODE_ID, "ambient_occlusion_mode"},
+    {AO_MODE_ACTIVE_ID, "ambient_occlusion_active"},
+    {AUTO_LODBIASADJUST_ID, "driver_controlled_lod_bias"},
+    {LODBIASADJUST_ID, "lod_bias"},
+    {QUALITY_ENHANCEMENT_SUBSTITUTION_ID, "texture_filtering_quality_substitution"},
+    {VSYNCTEARCONTROL_ID, "vertical_sync_tear_control"},
 };
 
 void set_error(char* buffer, size_t size, const char* message, NvAPI_Status status) {
@@ -216,6 +239,116 @@ NvAPI_Status get_scaling(NvU32* scaling) {
     return NVAPI_OK;
 }
 
+NvAPI_Status get_primary_display_id(NvU32* display_id) {
+    NvU32 count = 0;
+    NV_DISPLAYCONFIG_PATH_INFO* paths = nullptr;
+    NvAPI_Status status = allocate_display_config(&count, &paths);
+    if (status != NVAPI_OK) return status;
+    auto* path = primary_nvidia_path(count, paths);
+    if (!path) {
+        free_display_config(count, paths);
+        return NVAPI_NVIDIA_DEVICE_NOT_FOUND;
+    }
+    *display_id = path->targetInfo[0].displayId;
+    free_display_config(count, paths);
+    return NVAPI_OK;
+}
+
+NvAPI_Status get_output_color(GpNvColorControl* output) {
+    if (!output) return NVAPI_INVALID_POINTER;
+    memset(output, 0, sizeof(*output));
+    NvU32 display_id = 0;
+    NvAPI_Status status = get_primary_display_id(&display_id);
+    if (status != NVAPI_OK) return status;
+    NV_COLOR_DATA color = {};
+    color.version = NV_COLOR_DATA_VER;
+    color.size = sizeof(color);
+    color.cmd = NV_COLOR_CMD_GET;
+    status = NvAPI_Disp_ColorControl(display_id, &color);
+    if (status != NVAPI_OK) return status;
+    output->supported = 1;
+    output->color_format = color.data.colorFormat;
+    output->colorimetry = color.data.colorimetry;
+    output->dynamic_range = color.data.dynamicRange;
+    output->bpc = static_cast<NvU32>(color.data.bpc);
+    output->selection_policy = static_cast<NvU32>(color.data.colorSelectionPolicy);
+    output->desktop_color_depth = static_cast<NvU32>(color.data.depth);
+    return NVAPI_OK;
+}
+
+NvAPI_Status set_output_color(const GpNvColorControl* input) {
+    if (!input || !input->supported) return NVAPI_INVALID_ARGUMENT;
+    NvU32 display_id = 0;
+    NvAPI_Status status = get_primary_display_id(&display_id);
+    if (status != NVAPI_OK) return status;
+    NV_COLOR_DATA color = {};
+    color.version = NV_COLOR_DATA_VER;
+    color.size = sizeof(color);
+    color.cmd = NV_COLOR_CMD_SET;
+    color.data.colorFormat = static_cast<NvU8>(input->color_format);
+    color.data.colorimetry = static_cast<NvU8>(input->colorimetry);
+    color.data.dynamicRange = static_cast<NvU8>(input->dynamic_range);
+    color.data.bpc = static_cast<NV_BPC>(input->bpc);
+    color.data.colorSelectionPolicy =
+        static_cast<NV_COLOR_SELECTION_POLICY>(input->selection_policy);
+    color.data.depth = static_cast<NV_DESKTOP_COLOR_DEPTH>(input->desktop_color_depth);
+    return NvAPI_Disp_ColorControl(display_id, &color);
+}
+
+void capture_profile_settings(NvDRSSessionHandle session, NvDRSProfileHandle profile,
+                              GpNvSetting* settings, uint32_t* setting_count) {
+    if (!profile || !settings || !setting_count) return;
+    const size_t count = sizeof(kPortableSettings) / sizeof(kPortableSettings[0]);
+    for (size_t i = 0; i < count && i < GP_NV_MAX_SETTINGS; ++i) {
+        auto& output = settings[(*setting_count)++];
+        output.id = kPortableSettings[i].id;
+        copy_ascii(output.key, sizeof(output.key), kPortableSettings[i].key);
+        NVDRS_SETTING setting = {};
+        setting.version = NVDRS_SETTING_VER;
+        NvAPI_Status status = NvAPI_DRS_GetSetting(session, profile, output.id, &setting);
+        if (status == NVAPI_OK && setting.settingType == NVDRS_DWORD_TYPE &&
+            setting.settingLocation == NVDRS_CURRENT_PROFILE_LOCATION) {
+            output.present = 1;
+            output.value = setting.u32CurrentValue;
+        }
+    }
+}
+
+void apply_profile_settings(NvDRSSessionHandle session, NvDRSProfileHandle profile,
+                            const GpNvSetting* settings, uint32_t count,
+                            uint32_t* applied, uint32_t* skipped,
+                            uint32_t* unsupported, bool force_highest_refresh) {
+    if (!profile) return;
+    const uint32_t safe_count = count > GP_NV_MAX_SETTINGS ? GP_NV_MAX_SETTINGS : count;
+    for (uint32_t i = 0; i < safe_count; ++i) {
+        const auto& input = settings[i];
+        if (!is_whitelisted(input.id)) {
+            if (unsupported) ++*unsupported;
+            continue;
+        }
+        NvAPI_Status status = NVAPI_OK;
+        if (!input.present) {
+            status = NvAPI_DRS_DeleteProfileSetting(session, profile, input.id);
+            if (status == NVAPI_SETTING_NOT_FOUND) status = NVAPI_OK;
+        } else {
+            NVDRS_SETTING setting = {};
+            setting.version = NVDRS_SETTING_VER;
+            setting.settingId = input.id;
+            setting.settingType = NVDRS_DWORD_TYPE;
+            setting.u32CurrentValue =
+                (force_highest_refresh && input.id == REFRESH_RATE_OVERRIDE_ID)
+                    ? REFRESH_RATE_OVERRIDE_HIGHEST_AVAILABLE
+                    : input.value;
+            status = NvAPI_DRS_SetSetting(session, profile, &setting);
+        }
+        if (status == NVAPI_OK) {
+            if (applied) ++*applied;
+        } else if (skipped) {
+            ++*skipped;
+        }
+    }
+}
