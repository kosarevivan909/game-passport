+    // Verify every exact file we wrote, not only video settings. This detects a
+    // concurrent writer but does not promise to control a future Steam Cloud sync.
+    fn verify_written_files(files: &[&DecodedFile]) -> Result<(), UserFacingError> {
+        for item in files {
+            let actual = fs::read(&item.target).map_err(|error| {
+                io_error("Не удалось проверить записанные настройки CS2.", error)
+            })?;
+            if actual != item.content {
+                return Err(UserFacingError::new(
+                    "Другой процесс изменил настройки после записи. Полное применение не подтверждено.",
+                    true,
+                ).detail(format!("Файл не совпал: {}", item.relative_path)));
+            }
+        }
+        Ok(())
+    }
+
+    fn video_key_values(bytes: &[u8]) -> Result<HashMap<String, String>, UserFacingError> {
+        let text = std::str::from_utf8(bytes).map_err(|_| {
+            UserFacingError::new("cs2_video.txt has an unsupported text encoding.", false)
+        })?;
+        Ok(text
+            .lines()
+            .filter_map(|line| {
+                let tokens = quoted_tokens(line);
+                (tokens.len() >= 2).then(|| (tokens[0].to_ascii_lowercase(), tokens[1].clone()))
+            })
+            .collect())
+    }
