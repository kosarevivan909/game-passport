+    fn capture_launch_options(
+        localconfig: &Path,
+        details: &mut Vec<String>,
+    ) -> Result<(Option<String>, bool), UserFacingError> {
+        if !localconfig.is_file() {
+            details.push(
+                "Файл параметров запуска Steam не найден; параметры запуска не сохранены.".into(),
+            );
+            return Ok((None, false));
+        }
+        if localconfig
+            .metadata()
+            .map(|value| value.len() > MAX_LOCALCONFIG_BYTES)
+            .unwrap_or(true)
+        {
+            details.push(
+                "Файл Steam слишком большой или недоступен; параметры запуска не сохранены.".into(),
+            );
+            return Ok((None, false));
+        }
+        let text = fs::read_to_string(localconfig)
+            .map_err(|error| io_error("Could not read Steam launch options.", error))?;
+        let Some(value) = find_launch_options(&text) else {
+            return Ok((None, true));
+        };
+        let value = value.trim().to_string();
+        if value.is_empty() {
+            return Ok((None, true));
+        }
+        if let Err(error) = validate_launch_options(&value) {
+            details.push(format!(
+                "Параметры запуска Steam исключены: {}",
+                error.message
+            ));
+            return Ok((None, false));
+        }
+        Ok((Some(value), true))
+    }
+
