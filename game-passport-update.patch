diff --git a/supabase/functions/auth-callback/index.ts b/supabase/functions/auth-callback/index.ts
new file mode 100644
index 0000000..cdd403f
--- /dev/null
+++ b/supabase/functions/auth-callback/index.ts
@@ -0,0 +1,76 @@
+const callbackPage = "https://kosarevivan909.github.io/game-passport/auth-callback.html";
+const callbackOrigin = "https://kosarevivan909.github.io";
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      "content-type": "application/json; charset=utf-8",
+      "cache-control": "no-store, max-age=0",
+      "access-control-allow-origin": callbackOrigin,
+      "access-control-allow-methods": "POST, OPTIONS",
+      "access-control-allow-headers": "content-type",
+      "vary": "origin",
+      "x-content-type-options": "nosniff",
+      "referrer-policy": "no-referrer",
+    },
+  });
+
+Deno.serve(async (request) => {
+  const requestUrl = new URL(request.url);
+
+  if (request.method === "GET") {
+    const flow = requestUrl.searchParams.get("flow") === "recovery" ? "recovery" : "signup";
+    const destination = new URL(callbackPage);
+    destination.searchParams.set("flow", flow);
+    return new Response(null, {
+      status: 302,
+      headers: {
+        location: destination.toString(),
+        "cache-control": "no-store, max-age=0",
+        "referrer-policy": "no-referrer",
+        "x-content-type-options": "nosniff",
+      },
+    });
+  }
+
+  if (request.method === "OPTIONS") {
+    const origin = request.headers.get("origin");
+    if (origin !== callbackOrigin) return json({ error: "origin_not_allowed" }, 403);
+    return json({ ok: true });
+  }
+
+  if (request.method !== "POST") return json({ error: "method_not_allowed" }, 405);
+  if (request.headers.get("origin") !== callbackOrigin) return json({ error: "origin_not_allowed" }, 403);
+
+  let payload: { accessToken?: unknown; password?: unknown };
+  try {
+    if (Number(request.headers.get("content-length") ?? 0) > 12_000) return json({ error: "payload_too_large" }, 413);
+    payload = await request.json();
+  } catch {
+    return json({ error: "invalid_request" }, 400);
+  }
+
+  const accessToken = typeof payload.accessToken === "string" ? payload.accessToken : "";
+  const password = typeof payload.password === "string" ? payload.password : "";
+  if (accessToken.length < 32 || accessToken.length > 8192 || password.length < 8 || password.length > 128) {
+    return json({ error: "invalid_request" }, 400);
+  }
+
+  const supabaseUrl = Deno.env.get("SUPABASE_URL") ?? "";
+  const anonKey = Deno.env.get("SUPABASE_ANON_KEY") ?? "";
+  if (!supabaseUrl || !anonKey) return json({ error: "service_unavailable" }, 503);
+
+  const response = await fetch(`${supabaseUrl}/auth/v1/user`, {
+    method: "PUT",
+    headers: {
+      apikey: anonKey,
+      authorization: `Bearer ${accessToken}`,
+      "content-type": "application/json",
+    },
+    body: JSON.stringify({ password }),
+  });
+
+  if (!response.ok) return json({ error: "recovery_link_invalid" }, response.status === 429 ? 429 : 400);
+  return json({ ok: true });
+});
