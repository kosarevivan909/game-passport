+                DisplayModeIntent::ExclusiveFullscreen => "После запуска Steam графика CS2 и настоящий полноэкранный режим повторно проверены.".into(),
+                _ => "После запуска Steam графика CS2 и сохранённый режим отображения повторно проверены.".into(),
+            });
+        }
+        if payload.launch_options_captured || payload.launch_options.is_some() {
+            let display_mode = profile_display_mode_intent(payload)?;
+            let expected = normalize_launch_options(
+                payload.launch_options.as_deref().unwrap_or(""),
+                display_mode,
+            );
+            let text = fs::read_to_string(&context.localconfig_vdf).map_err(|error| {
+                io_error(
+                    "Не удалось повторно проверить параметры запуска Steam.",
+                    error,
+                )
+            })?;
+            let actual = find_launch_options(&text).unwrap_or_default();
+            if actual.trim() != expected {
+                return Err(UserFacingError::new(
+                    "Steam изменил параметры запуска CS2 после записи.",
+                    true,
+                )
+                .detail(format!("Ожидалось: {expected}"))
+                .detail(format!("Найдено: {}", actual.trim())));
+            }
+            details.push("Параметры запуска CS2 повторно проверены после запуска Steam.".into());
+        }
+        Ok(details)
+    }
