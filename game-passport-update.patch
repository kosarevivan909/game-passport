+    fn verify_after_steam_restart_stable(
+        payload: &Cs2Payload,
+        context: &SteamContext,
+    ) -> Result<Vec<String>, UserFacingError> {
+        let started = Instant::now();
+        let deadline = started + Duration::from_secs(25);
+        let earliest_success = started + Duration::from_secs(10);
+        let mut last_error = None;
+
+        loop {
+            match verify_after_steam_restart(payload, context) {
+                Ok(details) if Instant::now() >= earliest_success => return Ok(details),
+                Ok(_) => last_error = None,
+                Err(error) => last_error = Some(error),
+            }
+            if Instant::now() >= deadline {
+                return Err(last_error.unwrap_or_else(|| {
+                    UserFacingError::new(
+                        "Steam не завершил синхронизацию настроек CS2 за 25 секунд.",
+                        true,
+                    )
+                }));
+            }
+            thread::sleep(Duration::from_millis(500));
+        }
+    }
