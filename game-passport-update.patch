+            let display_mode = display_mode_intent(&saved)?;
+            let expected = normalize_saved_display_mode(&saved, display_mode)?;
+            let actual_path = context.userdata_cfg.join("cs2_video.txt");
+            let actual = fs::read(&actual_path).map_err(|error| {
+                io_error("После запуска Steam файл cs2_video.txt не найден.", error)
+            })?;
+            let actual = sanitize_hardware_config(&actual)?.0;
+            let expected_values = video_key_values(&expected)?;
+            let actual_values = video_key_values(&actual)?;
+            let mismatched = expected_values
+                .iter()
+                .filter(|(key, value)| actual_values.get(*key) != Some(*value))
+                .map(|(key, _)| key.clone())
+                .collect::<Vec<_>>();
+            if !mismatched.is_empty() {
+                return Err(UserFacingError::new(
+                    "Steam или драйвер изменил параметры видео CS2 после записи.",
+                    true,
+                )
+                .detail(format!("Не совпали параметры: {}", mismatched.join(", "))));
+            }
