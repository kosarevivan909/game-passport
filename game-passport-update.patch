+use serde::Serialize;
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SecureStorageResponse {
+    pub state: String,
+    pub value: Option<String>,
+    pub message: String,
+}
+
+const ALLOWED_PREFIXES: [&str; 3] = [
+    "game-passport.auth.",
+    "game-passport.profile-cache.",
+    "game-passport.license.",
+];
+
+fn validate_key(key: &str) -> Result<(), String> {
+    if key.len() > 180
+        || !ALLOWED_PREFIXES
+            .iter()
+            .any(|prefix| key.starts_with(prefix))
+        || !key
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || ".-_".contains(character))
+    {
+        return Err("Secure-storage key is outside the Game Passport allowlist.".into());
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn get(_key: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn set(_key: String, _value: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn remove(_key: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+fn unsupported() -> SecureStorageResponse {
+    SecureStorageResponse {
+        state: "unsupported".into(),
+        value: None,
+        message: "Windows protected storage is unavailable on this platform.".into(),
+    }
+}
+
+#[cfg(target_os = "windows")]
+mod windows {
+    use super::*;
+    use sha2::Digest;
+    use std::{
+        env, fs,
+        os::windows::ffi::OsStrExt,
+        path::PathBuf,
+        ptr::null,
+        time::{SystemTime, UNIX_EPOCH},
+    };
+    use windows_sys::Win32::{
+        Foundation::LocalFree,
+        Security::Cryptography::{
+            CryptProtectData, CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN, CRYPT_INTEGER_BLOB,
+        },
+        Storage::FileSystem::{MoveFileExW, MOVEFILE_REPLACE_EXISTING, MOVEFILE_WRITE_THROUGH},
+    };
+
+    const MAX_PROTECTED_BYTES: usize = 24 * 1024 * 1024;
+
+    fn root() -> Result<PathBuf, String> {
+        env::var_os("LOCALAPPDATA")
+            .map(PathBuf::from)
+            .map(|path| path.join("app.gamepassport.desktop").join("protected"))
+            .ok_or_else(|| "Windows Local AppData is unavailable.".into())
+    }
+
+    fn path_for(key: &str) -> Result<PathBuf, String> {
+        validate_key(key)?;
+        let digest = format!("{:x}", sha2::Sha256::digest(key.as_bytes()));
+        Ok(root()?.join(format!("{digest}.bin")))
+    }
+
+    pub fn protect(bytes: &[u8]) -> Result<Vec<u8>, String> {
+        if bytes.len() > MAX_PROTECTED_BYTES {
+            return Err("Protected value exceeds the 24 MB limit.".into());
+        }
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: bytes.len() as u32,
+            pbData: bytes.as_ptr() as *mut u8,
+        };
+        let mut output = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let ok = unsafe {
+            CryptProtectData(
+                &input,
+                null(),
+                null(),
+                null(),
+                null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 || output.pbData.is_null() {
+            return Err("Windows DPAPI could not protect the value.".into());
+        }
+        let result = unsafe {
+            let value = std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec();
+            let _ = LocalFree(output.pbData.cast());
+            value
+        };
+        Ok(result)
+    }
+
+    pub fn unprotect(bytes: &[u8]) -> Result<Vec<u8>, String> {
+        if bytes.len() > MAX_PROTECTED_BYTES + 4096 {
+            return Err("Protected value exceeds the safe size limit.".into());
+        }
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: bytes.len() as u32,
+            pbData: bytes.as_ptr() as *mut u8,
+        };
+        let mut output = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let ok = unsafe {
+            CryptUnprotectData(
+                &input,
+                std::ptr::null_mut(),
+                null(),
+                null(),
+                null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 || output.pbData.is_null() {
+            return Err("Windows DPAPI could not unlock the value on this computer.".into());
+        }
+        let result = unsafe {
+            let value = std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec();
+            let _ = LocalFree(output.pbData.cast());
+            value
+        };
+        Ok(result)
+    }
+
+    pub fn get(key: String) -> SecureStorageResponse {
+        let result = (|| -> Result<Option<String>, String> {
+            let path = path_for(&key)?;
+            if !path.exists() {
+                return Ok(None);
+            }
+            let bytes = fs::read(path).map_err(|error| error.to_string())?;
+            let clear = unprotect(&bytes)?;
+            String::from_utf8(clear)
+                .map(Some)
+                .map_err(|_| "Protected value is not valid UTF-8.".into())
+        })();
+        match result {
+            Ok(value) => SecureStorageResponse {
+                state: "success".into(),
+                value,
+                message: "Protected value loaded.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+
+    pub fn set(key: String, value: String) -> SecureStorageResponse {
+        let result = (|| -> Result<(), String> {
+            let path = path_for(&key)?;
+            let parent = path.parent().ok_or("Protected-storage path is invalid.")?;
+            fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+            let protected = protect(value.as_bytes())?;
+            let nonce = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map_err(|_| "Windows system clock is invalid.")?
+                .as_nanos();
+            let temporary = path.with_extension(format!("{}-{nonce}.tmp", std::process::id()));
+            fs::write(&temporary, protected).map_err(|error| error.to_string())?;
+            let source = temporary
+                .as_os_str()
+                .encode_wide()
+                .chain(std::iter::once(0))
+                .collect::<Vec<_>>();
+            let destination = path
+                .as_os_str()
+                .encode_wide()
+                .chain(std::iter::once(0))
+                .collect::<Vec<_>>();
+            let moved = unsafe {
+                MoveFileExW(
+                    source.as_ptr(),
+                    destination.as_ptr(),
+                    MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+                )
+            };
+            if moved == 0 {
+                let _ = fs::remove_file(&temporary);
+                return Err("Windows could not atomically replace a protected value.".into());
+            }
+            Ok(())
+        })();
+        match result {
+            Ok(()) => SecureStorageResponse {
+                state: "success".into(),
+                value: None,
+                message: "Protected value saved.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+
+    pub fn remove(key: String) -> SecureStorageResponse {
+        let result = path_for(&key).and_then(|path| {
+            if path.exists() {
+                fs::remove_file(path).map_err(|error| error.to_string())?;
+            }
+            Ok(())
+        });
+        match result {
+            Ok(()) => SecureStorageResponse {
+                state: "success".into(),
+                value: None,
+                message: "Protected value removed.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub use windows::{get, remove, set};
