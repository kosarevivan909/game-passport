@@ -0,0 +1,21 @@
+import { Check, ChevronRight, Gamepad2, MonitorUp, Save, ShieldAlert, X } from "lucide-react";
+import { useState } from "react";
+
+interface Props { compact?: boolean; onComplete: (hideOnStartup: boolean) => void }
+
+const steps = [
+  { icon: Gamepad2, title: "Настрой компьютер один раз", text: "Запустите игру и выставьте настройки так, как вам удобно." },
+  { icon: Save, title: "Сохраните свой профиль", text: "Вернитесь в Game Passport и нажмите «Сохранить текущие настройки». Поддерживаемые игровые и системные параметры сохранятся в профиле." },
+  { icon: MonitorUp, title: "На другом компьютере", text: "Войдите в аккаунт, выберите профиль и нажмите «Настроить этот ПК». Game Passport применит сохранённые настройки." },
+  { icon: ShieldAlert, title: "Важно", text: "Перед сохранением и применением закройте CS2 или PUBG, если приложение попросит. Не прерывайте применение." },
+];
+
+export function Onboarding({ compact = false, onComplete }: Props) {
+  const [step, setStep] = useState(0);
+  const [hideOnStartup, setHideOnStartup] = useState(false);
+  if (compact) return <div className="onboarding-backdrop"><section className="onboarding-card compact" role="dialog" aria-modal="true" aria-labelledby="quick-help-title"><button className="onboarding-close" aria-label="Закрыть" onClick={() => onComplete(hideOnStartup)}><X size={18} /></button><p className="eyebrow">КОРОТКАЯ ИНСТРУКЦИЯ</p><h2 id="quick-help-title">Как использовать Game Passport</h2><ol><li>Настройте игру под себя.</li><li>Нажмите «Сохранить текущие настройки».</li><li>На другом ПК войдите в аккаунт.</li><li>Выберите профиль.</li><li>Нажмите «Настроить этот ПК».</li></ol><label className="startup-choice"><input type="checkbox" checked={hideOnStartup} onChange={(event) => setHideOnStartup(event.target.checked)} /> Не показывать при запуске</label><button className="button primary wide" onClick={() => onComplete(hideOnStartup)}><Check size={18} /> Понятно</button></section></div>;
+
+  const current = steps[step];
+  const Icon = current.icon;
+  return <div className="onboarding-backdrop"><section className="onboarding-card" role="dialog" aria-modal="true" aria-labelledby="onboarding-title"><div className="onboarding-progress">{steps.map((_, index) => <i className={index <= step ? "active" : ""} key={index} />)}</div><div className="onboarding-icon"><Icon size={34} /></div><p className="eyebrow">ШАГ {step + 1} ИЗ {steps.length}</p><h2 id="onboarding-title">{current.title}</h2><p>{current.text}</p><button className="button primary wide" onClick={() => step < steps.length - 1 ? setStep(step + 1) : onComplete(false)}>{step < steps.length - 1 ? <>Далее <ChevronRight size={18} /></> : <><Check size={18} /> Начать</>}</button></section></div>;
+}
