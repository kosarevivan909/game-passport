+NvAPI_Status get_output_color(GpNvSnapshot* snapshot) {
+    NvU32 display_id = 0;
+    NvAPI_Status status = NvAPI_DISP_GetGDIPrimaryDisplayId(&display_id);
+    if (status != NVAPI_OK) return status;
+    NV_COLOR_DATA color = {};
+    color.version = NV_COLOR_DATA_VER;
+    color.size = sizeof(color);
+    color.cmd = NV_COLOR_CMD_GET;
+    status = NvAPI_Disp_ColorControl(display_id, &color);
+    if (status != NVAPI_OK) return status;
+    snapshot->output_color_supported = 1;
+    snapshot->color_format = color.data.colorFormat;
+    snapshot->colorimetry = color.data.colorimetry;
+    snapshot->dynamic_range = color.data.dynamicRange;
+    snapshot->bits_per_color = static_cast<NvU32>(color.data.bpc);
+    snapshot->color_selection_policy =
+        static_cast<NvU32>(color.data.colorSelectionPolicy);
+    snapshot->desktop_color_depth = static_cast<NvU32>(color.data.depth);
+    return NVAPI_OK;
+}
+
+NvAPI_Status set_output_color(const GpNvSnapshot* snapshot, bool* verified) {
+    *verified = false;
+    NvU32 display_id = 0;
+    NvAPI_Status status = NvAPI_DISP_GetGDIPrimaryDisplayId(&display_id);
+    if (status != NVAPI_OK) return status;
+    NV_COLOR_DATA color = {};
+    color.version = NV_COLOR_DATA_VER;
+    color.size = sizeof(color);
+    color.cmd = NV_COLOR_CMD_SET;
+    color.data.colorFormat = static_cast<NvU8>(snapshot->color_format);
+    color.data.colorimetry = static_cast<NvU8>(snapshot->colorimetry);
+    color.data.dynamicRange = static_cast<NvU8>(snapshot->dynamic_range);
+    color.data.bpc = static_cast<NV_BPC>(snapshot->bits_per_color);
+    color.data.colorSelectionPolicy =
+        static_cast<NV_COLOR_SELECTION_POLICY>(snapshot->color_selection_policy);
+    color.data.depth =
+        static_cast<NV_DESKTOP_COLOR_DEPTH>(snapshot->desktop_color_depth);
+    status = NvAPI_Disp_ColorControl(display_id, &color);
+    if (status != NVAPI_OK) return status;
+
+    GpNvSnapshot readback = {};
+    status = get_output_color(&readback);
+    if (status != NVAPI_OK) return status;
+    *verified = readback.color_format == snapshot->color_format &&
+                readback.colorimetry == snapshot->colorimetry &&
+                readback.dynamic_range == snapshot->dynamic_range &&
+                readback.bits_per_color == snapshot->bits_per_color &&
+                readback.color_selection_policy == snapshot->color_selection_policy &&
+                readback.desktop_color_depth == snapshot->desktop_color_depth;
+    return NVAPI_OK;
+}
+
+bool get_desktop_gamma(GpNvSnapshot* snapshot) {
+    HDC dc = GetDC(nullptr);
+    if (!dc) return false;
+    const BOOL ok = GetDeviceGammaRamp(dc, snapshot->desktop_gamma_ramp);
+    ReleaseDC(nullptr, dc);
+    snapshot->desktop_gamma_supported = ok ? 1 : 0;
+    return ok != FALSE;
+}
+
+bool set_desktop_gamma(const GpNvSnapshot* snapshot, bool* verified) {
+    *verified = false;
+    HDC dc = GetDC(nullptr);
+    if (!dc) return false;
+    const BOOL applied = SetDeviceGammaRamp(dc, snapshot->desktop_gamma_ramp);
+    uint16_t readback[GP_NV_GAMMA_RAMP_VALUES] = {};
+    const BOOL read = applied ? GetDeviceGammaRamp(dc, readback) : FALSE;
+    ReleaseDC(nullptr, dc);
+    if (!applied) return false;
+    *verified = read && memcmp(readback, snapshot->desktop_gamma_ramp,
+                               sizeof(readback)) == 0;
+    return true;
+}
+
+void apply_display_state(const GpNvSnapshot* snapshot, GpNvApplyReport* report) {
+    NvAPI_Status status = NVAPI_OK;
+    if (snapshot->scaling_supported) {
+        report->scaling_requested = 1;
+        status = set_scaling(snapshot->scaling);
+        if (status == NVAPI_OK) {
+            report->scaling_applied = 1;
+            copy_ascii(report->scaling_message, sizeof(report->scaling_message),
+                       "NVAPI accepted the requested scaling mode.");
+        } else {
+            set_error(report->scaling_message, sizeof(report->scaling_message),
+                      "NVIDIA scaling was not applied.", status);
+        }
+    } else {
+        copy_ascii(report->scaling_message, sizeof(report->scaling_message),
+                   "No portable scaling value was available in the snapshot.");
+    }
+
+    if (snapshot->output_color_supported) {
+        report->output_color_requested = 1;
+        bool verified = false;
+        status = set_output_color(snapshot, &verified);
+        if (status == NVAPI_OK) {
+            report->output_color_applied = 1;
+            report->output_color_verified = verified ? 1 : 0;
+            copy_ascii(report->output_color_message,
+                       sizeof(report->output_color_message),
+                       verified
+                           ? "NVIDIA output color was applied and verified."
+                           : "NVIDIA accepted output color, but readback differed.");
+        } else {
+            set_error(report->output_color_message,
+                      sizeof(report->output_color_message),
+                      "NVIDIA output color was not applied.", status);
+        }
+    } else {
+        copy_ascii(report->output_color_message,
+                   sizeof(report->output_color_message),
+                   "No portable NVIDIA output color was available in the snapshot.");
+    }
+
+    // Apply the desktop LUT last because an NVIDIA display mode reload may reset it.
+    if (snapshot->desktop_gamma_supported) {
+        report->desktop_gamma_requested = 1;
+        bool verified = false;
+        if (set_desktop_gamma(snapshot, &verified)) {
+            report->desktop_gamma_applied = 1;
+            report->desktop_gamma_verified = verified ? 1 : 0;
+            copy_ascii(report->desktop_gamma_message,
+                       sizeof(report->desktop_gamma_message),
+                       verified
+                           ? "Desktop brightness/contrast/gamma LUT was applied and verified."
+                           : "Desktop color LUT was applied, but readback differed.");
+        } else {
+            copy_ascii(report->desktop_gamma_message,
+                       sizeof(report->desktop_gamma_message),
+                       "Windows rejected the desktop brightness/contrast/gamma LUT.");
+        }
+    } else {
+        copy_ascii(report->desktop_gamma_message,
+                   sizeof(report->desktop_gamma_message),
+                   "No desktop brightness/contrast/gamma LUT was available in the snapshot.");
+    }
+}
+
 }  // namespace
 
