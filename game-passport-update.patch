+    fn force_exclusive_fullscreen(bytes: &[u8]) -> Result<Vec<u8>, UserFacingError> {
+        let text = std::str::from_utf8(bytes).map_err(|_| {
+            UserFacingError::new("cs2_video.txt has an unsupported text encoding.", false)
+        })?;
+        let mut fullscreen = false;
+        let mut no_border = false;
+        let mut output = Vec::new();
+        for line in text.lines() {
+            let tokens = quoted_tokens(line);
+            let replacement = if tokens
+                .first()
+                .is_some_and(|key| key.eq_ignore_ascii_case("setting.fullscreen"))
+            {
+                fullscreen = true;
+                Some("1")
+            } else if tokens
+                .first()
+                .is_some_and(|key| key.eq_ignore_ascii_case("setting.nowindowborder"))
+            {
+                no_border = true;
+                Some("0")
+            } else {
+                None
+            };
+            output.push(match replacement {
+                Some(value) => replace_second_quoted_value(line, value).ok_or_else(|| {
+                    UserFacingError::new(
+                        "cs2_video.txt contains a malformed fullscreen value.",
+                        false,
+                    )
+                })?,
+                None => line.to_string(),
+            });
+        }
+        if !fullscreen || !no_border {
+            return Err(UserFacingError::new(
+                "cs2_video.txt does not contain the expected fullscreen settings. Nothing was changed.",
+                false,
