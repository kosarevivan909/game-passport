+    fn set_launch_options(text: &str, value: &str) -> Result<String, UserFacingError> {
+        let (launch_line, block_close, block_indent) = locate_cs2_vdf_entries(text);
+        let newline = if text.contains("\r\n") { "\r\n" } else { "\n" };
+        let mut lines = text.lines().map(str::to_string).collect::<Vec<_>>();
+        let escaped = value.replace('\\', "\\\\").replace('"', "\\\"");
+        if let Some(index) = launch_line {
+            let indent = lines[index]
+                .chars()
+                .take_while(|character| character.is_whitespace())
+                .collect::<String>();
+            lines[index] = format!("{indent}\"LaunchOptions\"\t\t\"{escaped}\"");
+        } else if let Some(index) = block_close {
+            lines.insert(
+                index,
+                format!("{block_indent}\t\"LaunchOptions\"\t\t\"{escaped}\""),
+            );
+        } else {
+            return Err(UserFacingError::new(
+                "В локальных настройках Steam не найден раздел CS2. Запустите CS2 один раз и повторите.",
+                true,
+            ));
+        }
+        let mut result = lines.join(newline);
+        if text.ends_with('\n') {
+            result.push_str(newline);
+        }
+        Ok(result)
+    }
+
+    fn locate_cs2_vdf_entries(text: &str) -> (Option<usize>, Option<usize>, String) {
+        const PATH: [&str; 5] = ["Software", "Valve", "Steam", "apps", "730"];
+        let mut stack = Vec::<String>::new();
+        let mut pending = None::<String>;
+        let mut launch_line = None;
+        let mut block_close = None;
+        let mut block_indent = String::new();
+        for (index, line) in text.lines().enumerate() {
+            let tokens = quoted_tokens(line);
+            if path_ends_with(&stack, &PATH)
+                && tokens.len() >= 2
+                && tokens[0].eq_ignore_ascii_case("LaunchOptions")
+            {
+                launch_line = Some(index);
+            }
+            if tokens.len() == 1 {
+                pending = Some(tokens[0].clone());
+            }
+            let (opens, closes) = unquoted_braces(line);
+            for _ in 0..opens {
+                if let Some(key) = pending.take() {
+                    stack.push(key);
+                    if path_ends_with(&stack, &PATH) {
+                        block_indent = line
+                            .chars()
+                            .take_while(|character| character.is_whitespace())
+                            .collect();
+                    }
+                }
+            }
+            for _ in 0..closes {
+                if path_ends_with(&stack, &PATH) {
+                    block_close = Some(index);
+                    block_indent = line
+                        .chars()
+                        .take_while(|character| character.is_whitespace())
+                        .collect();
+                }
+                stack.pop();
+            }
+        }
+        (launch_line, block_close, block_indent)
+    }
+
+    fn path_ends_with(stack: &[String], expected: &[&str]) -> bool {
+        stack.len() >= expected.len()
+            && stack[stack.len() - expected.len()..]
+                .iter()
+                .zip(expected)
+                .all(|(actual, expected)| actual.eq_ignore_ascii_case(expected))
+    }
+
+    fn unquoted_braces(line: &str) -> (usize, usize) {
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut opens = 0;
+        let mut closes = 0;
+        for character in line.chars() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            if quoted && character == '\\' {
+                escaped = true;
+            } else if character == '"' {
+                quoted = !quoted;
+            } else if !quoted && character == '{' {
+                opens += 1;
+            } else if !quoted && character == '}' {
+                closes += 1;
+            }
+        }
+        (opens, closes)
+    }
