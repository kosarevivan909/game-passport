+    fn unquoted_braces(line: &str) -> (usize, usize) {
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut opens = 0;
+        let mut closes = 0;
+        for character in line.chars() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            if quoted && character == '\\' {
+                escaped = true;
+            } else if character == '"' {
+                quoted = !quoted;
+            } else if !quoted && character == '{' {
+                opens += 1;
+            } else if !quoted && character == '}' {
+                closes += 1;
+            }
+        }
+        (opens, closes)
+    }
