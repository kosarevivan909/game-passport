--- a/src-tauri/native/nvapi_bridge.cpp
+++ b/src-tauri/native/nvapi_bridge.cpp
@@ -3,6 +3,8 @@
 #include "nvapi.h"
 #include "NvApiDriverSettings.h"
 
+#include <windows.h>
