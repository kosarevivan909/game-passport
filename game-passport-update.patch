+extern "C" int gp_nvapi_apply_display_controls(
+    const GpNvSnapshot* snapshot, GpNvDisplayControlsReport* report,
+    char* error, size_t error_size) {
+    if (!snapshot || !report) return -1;
+    memset(report, 0, sizeof(*report));
+    NvAPI_Status status = NvAPI_Initialize();
+    if (status != NVAPI_OK) {
+        set_error(error, error_size, "NvAPI_Initialize failed.", status);
+        return status;
+    }
+    if (!snapshot->output_color.supported) {
+        copy_ascii(report->color_message, sizeof(report->color_message),
+                   "No portable NVIDIA output color value was available.");
+        return NVAPI_OK;
+    }
+    report->color_requested = 1;
+    status = set_output_color(&snapshot->output_color);
+    if (status != NVAPI_OK) {
+        set_error(report->color_message, sizeof(report->color_message),
+                  "NVIDIA output color was not applied.", status);
+        return NVAPI_OK;
+    }
+    GpNvColorControl verified = {};
+    status = get_output_color(&verified);
+    if (status == NVAPI_OK &&
+        verified.color_format == snapshot->output_color.color_format &&
+        verified.colorimetry == snapshot->output_color.colorimetry &&
+        verified.dynamic_range == snapshot->output_color.dynamic_range &&
+        verified.bpc == snapshot->output_color.bpc &&
+        verified.selection_policy == snapshot->output_color.selection_policy &&
+        verified.desktop_color_depth == snapshot->output_color.desktop_color_depth) {
+        report->color_applied = 1;
+        copy_ascii(report->color_message, sizeof(report->color_message),
+                   "NVIDIA output color was applied and verified.");
+    } else {
+        copy_ascii(report->color_message, sizeof(report->color_message),
+                   "NVIDIA accepted output color but verification did not match.");
+    }
+    return NVAPI_OK;
+}
