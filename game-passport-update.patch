+    fn replace_second_quoted_value(line: &str, value: &str) -> Option<String> {
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut quoted_index = 0usize;
+        let mut start = None;
+        for (index, character) in line.char_indices() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            if quoted && character == '\\' {
+                escaped = true;
+                continue;
+            }
+            if character != '"' {
+                continue;
+            }
+            if quoted {
+                if quoted_index == 1 {
+                    let start = start?;
+                    let mut result = line.to_string();
+                    result.replace_range(start..index, value);
+                    return Some(result);
+                }
+                quoted_index += 1;
+                start = None;
+            } else {
+                start = Some(index + 1);
+            }
+            quoted = !quoted;
+        }
+        None
+    }
