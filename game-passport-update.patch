@@ -0,0 +1,47 @@
+import { useState, type FormEvent } from "react";
+import { KeyRound, LogOut, RefreshCw, ShieldAlert, ShieldCheck } from "lucide-react";
+import type { DeviceLicenseStatus } from "../domain/license";
+
+interface Props {
+  status: DeviceLicenseStatus;
+  busy: boolean;
+  onRetry: () => Promise<void>;
+  onActivate: (code: string, label: string) => Promise<void>;
+  onSignOut: () => void;
+}
+
+export function DeviceActivationScreen({ status, busy, onRetry, onActivate, onSignOut }: Props) {
+  const [showActivation, setShowActivation] = useState(false);
+  const [code, setCode] = useState("");
+  const [label, setLabel] = useState("");
+
+  async function submit(event: FormEvent) {
+    event.preventDefault();
+    await onActivate(code, label || "Игровой ПК");
+  }
+
+  const blocked = status.state === "revoked" || status.state === "expired" || status.state === "clock_error";
+  return <main className="license-shell">
+    <section className="license-card">
+      <div className={`license-icon ${blocked ? "blocked" : ""}`}>
+        {blocked ? <ShieldAlert size={34} /> : <ShieldCheck size={34} />}
+      </div>
+      <p className="eyebrow">ЗАЩИТА GAME PASSPORT</p>
+      <h1>{status.state === "not_activated" ? "Game Passport не активирован на этом компьютере" : blocked ? "Доступ временно закрыт" : "Проверка устройства"}</h1>
+      <p className="process-lead">{status.state === "not_activated" ? "Обратитесь к администратору клуба. Если у вас есть выданный администратором код, откройте форму активации ниже." : status.message}</p>
+
+      {showActivation && status.state === "not_activated" && <form className="activation-form" onSubmit={submit}>
+        <label>Название компьютера<input aria-label="Название компьютера" value={label} maxLength={80} placeholder="Например, PC-01" onChange={(event) => setLabel(event.target.value)} /></label>
+        <label>Код администратора<input aria-label="Код активации" value={code} autoComplete="off" spellCheck={false} placeholder="GP-…" onChange={(event) => setCode(event.target.value)} required /></label>
+        <button className="button primary wide" disabled={busy || code.trim().length < 10}><KeyRound size={18} /> {busy ? "Активируем…" : "Активировать этот компьютер"}</button>
+      </form>}
+
+      <div className="license-actions">
+        <button className="button secondary wide" disabled={busy} onClick={() => void onRetry()}><RefreshCw size={17} className={busy ? "spin" : ""} /> Повторить проверку</button>
+        {status.state === "not_activated" && !showActivation && <button className="text-button" onClick={() => setShowActivation(true)}>У меня есть код активации</button>}
+        <button className="text-button" onClick={onSignOut}><LogOut size={16} /> Выйти из аккаунта</button>
+      </div>
+      {status.keyProtection === "software" && <p className="license-note">TPM недоступен. Ключ защищён Windows CNG и остаётся неэкспортируемым, но администратору рекомендуется проверить TPM.</p>}
+    </section>
+  </main>;
+}
