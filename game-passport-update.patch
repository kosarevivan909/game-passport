+#[cfg(test)]
+mod tests {
+    use super::*;
+    use p256::{
+        ecdsa::{signature::Signer, SigningKey},
+        pkcs8::EncodePublicKey,
+    };
+
+    fn token(
+        now: i64,
+        expires: i64,
+        device_hash: &str,
+        signing_key: &SigningKey,
+    ) -> (String, String) {
+        let header = general_purpose::URL_SAFE_NO_PAD
+            .encode(br#"{"alg":"ES256","typ":"GP-OFFLINE-GRANT","kid":"test"}"#);
+        let payload = general_purpose::URL_SAFE_NO_PAD.encode(
+            serde_json::to_vec(&serde_json::json!({
+                "iss": "game-passport-device-license",
+                "aud": "game-passport-windows",
+                "sub": "11111111-1111-1111-1111-111111111111",
+                "organization_id": "22222222-2222-2222-2222-222222222222",
+                "device_public_key_sha256": device_hash,
+                "license_version": 1,
+                "iat": now,
+                "nbf": now - 60,
+                "exp": expires,
+                "server_time": now
+            }))
+            .unwrap(),
+        );
+        let input = format!("{header}.{payload}");
+        let signature: Signature = signing_key.sign(input.as_bytes());
+        let public = signing_key.verifying_key().to_public_key_der().unwrap();
+        (
+            format!(
+                "{input}.{}",
+                general_purpose::URL_SAFE_NO_PAD.encode(signature.to_bytes())
+            ),
+            general_purpose::STANDARD.encode(public.as_bytes()),
+        )
+    }
+
+    #[test]
+    fn valid_offline_token_signature_and_claims_are_accepted() {
+        let signing_key = SigningKey::from_bytes((&[7u8; 32]).into()).unwrap();
+        let (token, public) = token(
+            1_700_000_000,
+            1_700_086_400,
+            "a".repeat(64).as_str(),
+            &signing_key,
+        );
+        assert!(verify_grant_with_key(
+            &token,
+            "a".repeat(64).as_str(),
+            1_700_000_100,
+            &public,
+            Some("test")
+        )
+        .is_ok());
+    }
+
+    #[test]
+    fn tampered_and_invalid_signatures_are_rejected() {
+        let signing_key = SigningKey::from_bytes((&[8u8; 32]).into()).unwrap();
+        let (token, public) = token(
+            1_700_000_000,
+            1_700_086_400,
+            "b".repeat(64).as_str(),
+            &signing_key,
+        );
+        let mut parts = token.split('.').collect::<Vec<_>>();
+        parts[1] = "eyJ0YW1wZXJlZCI6dHJ1ZX0";
+        assert!(
+            verify_signature(&format!("{}.{}", parts[0], parts[1]), parts[2], &public).is_err()
+        );
+        assert!(verify_signature("a.b", "invalid", &public).is_err());
+    }
+
+    #[test]
+    fn expired_offline_token_is_denied() {
+        let signing_key = SigningKey::from_bytes((&[9u8; 32]).into()).unwrap();
+        let device_hash = "c".repeat(64);
+        let (token, public) = token(1_700_000_000, 1_700_000_100, &device_hash, &signing_key);
+        let result =
+            verify_grant_with_key(&token, &device_hash, 1_700_000_101, &public, Some("test"));
+        assert!(result.is_err_and(|error| error.contains("expired")));
+    }
+
+    #[test]
+    fn token_for_another_device_is_denied() {
+        let signing_key = SigningKey::from_bytes((&[10u8; 32]).into()).unwrap();
+        let (token, public) = token(
+            1_700_000_000,
+            1_700_086_400,
+            "d".repeat(64).as_str(),
+            &signing_key,
+        );
+        assert!(verify_grant_with_key(
+            &token,
+            "e".repeat(64).as_str(),
+            1_700_000_100,
+            &public,
+            Some("test")
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn token_with_an_unexpected_key_id_is_denied() {
+        let signing_key = SigningKey::from_bytes((&[11u8; 32]).into()).unwrap();
+        let device_hash = "f".repeat(64);
+        let (token, public) = token(1_700_000_000, 1_700_086_400, &device_hash, &signing_key);
+        assert!(verify_grant_with_key(
+            &token,
+            &device_hash,
+            1_700_000_100,
+            &public,
+            Some("rotated-key")
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn backwards_clock_beyond_tolerance_is_denied() {
+        let stored = ProtectedGrant {
+            token: "unused".into(),
+            last_server_time: 1_700_000_000,
+            last_observed_time: 1_700_010_000,
+            accepted_at: 1_700_000_000,
+            key_protection: "tpm".into(),
+        };
+        assert!(clock_rolled_back(1_700_009_000, &stored));
+        assert!(!clock_rolled_back(1_700_009_800, &stored));
+    }
+}
