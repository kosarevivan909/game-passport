@@ -0,0 +1,44 @@
+import { invoke } from "@tauri-apps/api/core";
+import { getNvidiaPayload, type NvidiaCommandResponse, type NvidiaPayload } from "../domain/nvidia";
+import type { AdapterResult, GameProfile } from "../domain/types";
+import type { SettingsAdapter } from "../ports/SettingsAdapter";
+import { isTauriDesktop } from "../services/platform";
+
+export class NvidiaDisplayControlsAdapter implements SettingsAdapter {
+  readonly id = "nvidia.display-controls";
+  readonly label = "NVIDIA Display Controls";
+  readonly status = "implemented" as const;
+
+  supports(profile: GameProfile) { return profile.game === "cs2" || profile.game === "pubg"; }
+
+  async capture(): Promise<AdapterResult> {
+    return { adapterId: this.id, label: this.label, state: "unsupported", message: "Captured by the NVIDIA adapter." };
+  }
+
+  async apply(profile: GameProfile): Promise<AdapterResult> {
+    if (!isTauriDesktop()) return this.desktopRequired();
+    const payload = getNvidiaPayload(profile.settings);
+    if (!payload) return { adapterId: this.id, label: this.label, state: "warning", message: "This profile has no saved NVIDIA display controls.", retryable: false };
+    try {
+      const response = await invoke<NvidiaCommandResponse>("apply_nvidia_display_controls", { payload: payload as NvidiaPayload });
+      return {
+        adapterId: this.id,
+        label: this.label,
+        state: response.state,
+        message: response.message,
+        details: response.details,
+        retryable: response.retryable
+      };
+    } catch (error) {
+      return { adapterId: this.id, label: this.label, state: "error", message: "NVIDIA display controls could not be applied.", details: [error instanceof Error ? error.message : String(error)], retryable: true };
+    }
+  }
+
+  async restore(): Promise<AdapterResult> {
+    return { adapterId: this.id, label: this.label, state: "unsupported", message: "Restored by the NVIDIA adapter." };
+  }
+
+  private desktopRequired(): AdapterResult {
+    return { adapterId: this.id, label: this.label, state: "unsupported", message: "NVIDIA settings are unsupported on this platform.", retryable: false };
+  }
+}
