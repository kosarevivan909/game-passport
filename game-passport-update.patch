diff --git a/src/services/secureStorage.ts b/src/services/secureStorage.ts
new file mode 100644
index 0000000..e7e7fe4
--- /dev/null
+++ b/src/services/secureStorage.ts
@@ -0,0 +1,33 @@
+import { invoke } from "@tauri-apps/api/core";
+import { isTauriDesktop } from "./platform";
+
+interface SecureStorageResponse {
+  state: "success" | "error" | "unsupported";
+  value?: string;
+  message: string;
+}
+
+export const secureStorage = {
+  async getItem(key: string): Promise<string | null> {
+    if (!isTauriDesktop()) return localStorage.getItem(key);
+    const response = await invoke<SecureStorageResponse>("secure_storage_get", { key });
+    if (response.state !== "success") throw new Error(response.message);
+    return response.value ?? null;
+  },
+  async setItem(key: string, value: string): Promise<void> {
+    if (!isTauriDesktop()) {
+      localStorage.setItem(key, value);
+      return;
+    }
+    const response = await invoke<SecureStorageResponse>("secure_storage_set", { key, value });
+    if (response.state !== "success") throw new Error(response.message);
+  },
+  async removeItem(key: string): Promise<void> {
+    if (!isTauriDesktop()) {
+      localStorage.removeItem(key);
+      return;
+    }
+    const response = await invoke<SecureStorageResponse>("secure_storage_remove", { key });
+    if (response.state !== "success") throw new Error(response.message);
+  },
+};
