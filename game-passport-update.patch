+                false,
+            ));
+        }
+        if value.chars().any(|character| {
+            character == '\0'
+                || character == '\r'
+                || character == '\n'
+                || character.is_control()
+        })
+        {
+            return Err(UserFacingError::new(
+                "строка содержит недопустимые управляющие символы.",
+                false,
+            ));
+        }
+        let lower = value.to_ascii_lowercase();
+        let blocked = [
+            "password",
+            "token",
+            "authkey",
+            "cookie",
+            "+connect",
+            "-connect",
+            "rcon",
+            "setinfo",
+            "apikey",
+            "api_key",
+            "webapi",
+            "://",
