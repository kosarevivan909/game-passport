+                escaped = true;
+            } else if character == '"' {
+                quoted = !quoted;
+            } else if !quoted && character == '{' {
+                opens += 1;
+            } else if !quoted && character == '}' {
+                closes += 1;
+            }
+        }
+        (opens, closes)
+    }
