+struct ValidGrant {
+    payload: GrantPayload,
+}
+
+pub fn identity() -> DeviceIdentityResponse {
+    platform::identity()
+}
+
+pub fn sign_challenge(request: DeviceChallengeRequest) -> DeviceSignatureResponse {
+    if request.challenge_id.len() < 32
+        || request.challenge_id.len() > 64
+        || request.challenge.len() < 40
+        || request.challenge.len() > 96
+        || !request
+            .challenge
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || "-_".contains(character))
+        || !matches!(request.purpose.as_str(), "activate" | "verify")
+    {
+        return DeviceSignatureResponse {
+            state: "error".into(),
+            message: "The server challenge is malformed.".into(),
+            signature: None,
+        };
+    }
+    let identity = identity();
+    let (Some(public_key_sha256), Some(fingerprint_hash), Some(key_protection)) = (
+        identity.public_key_sha256,
+        identity.fingerprint_hash,
+        identity.key_protection,
+    ) else {
+        return DeviceSignatureResponse {
+            state: "error".into(),
+            message: identity.message,
+            signature: None,
+        };
+    };
+    let message = format!(
+        "game-passport-device-proof:v2\n{}\n{}\n{}\n{}\n{}\n{}",
+        request.challenge_id,
+        request.challenge,
+        request.purpose,
+        public_key_sha256,
+        fingerprint_hash,
+        key_protection
+    );
+    match platform::sign(message.as_bytes()) {
+        Ok(signature) => DeviceSignatureResponse {
+            state: "success".into(),
+            message: "Device challenge signed by the protected Windows key.".into(),
+            signature: Some(general_purpose::URL_SAFE_NO_PAD.encode(signature)),
+        },
+        Err(message) => DeviceSignatureResponse {
+            state: "error".into(),
+            message,
+            signature: None,
+        },
+    }
+}
+
+pub fn accept_grant(token: String) -> DeviceLicenseStatus {
+    let identity = identity();
+    let (Some(device_hash), Some(key_protection)) =
+        (identity.public_key_sha256, identity.key_protection)
+    else {
+        return status("error", &identity.message);
+    };
+    let now = Utc::now().timestamp();
+    let grant = match verify_grant(&token, &device_hash, now) {
+        Ok(value) => value,
+        Err(message) => return status("error", &message),
+    };
+    let stored = ProtectedGrant {
+        token,
+        last_server_time: grant.payload.server_time,
+        last_observed_time: now,
+        accepted_at: now,
+        key_protection,
+    };
+    if save_protected_grant(&stored).is_err() {
+        return status(
+            "error",
+            "The offline license grant could not be protected by Windows.",
+        );
+    }
+    status_from_grant(grant, stored, false)
+}
+
+pub fn cached_status() -> DeviceLicenseStatus {
+    let loaded = crate::secure_storage::get(GRANT_STORAGE_KEY.into());
+    if loaded.state != "success" {
+        return status(
+            "error",
+            "Windows could not unlock the cached device license.",
+        );
+    }
+    let Some(value) = loaded.value else {
+        return status(
+            "not_activated",
+            "Game Passport не активирован на этом компьютере. Обратитесь к администратору клуба.",
+        );
+    };
+    let mut stored: ProtectedGrant = match serde_json::from_str(&value) {
+        Ok(value) => value,
+        Err(_) => {
+            clear_grant();
+            return status("error", "The cached device license is damaged.");
+        }
+    };
+    let now = Utc::now().timestamp();
+    if clock_rolled_back(now, &stored) {
+        return status(
+            "clock_error",
+            "Проверьте дату и время Windows, затем повторите проверку лицензии.",
+        );
+    }
+    let identity = identity();
+    let Some(device_hash) = identity.public_key_sha256 else {
+        return status("error", &identity.message);
+    };
+    match verify_grant(&stored.token, &device_hash, now) {
+        Ok(grant) => {
+            stored.last_observed_time = stored.last_observed_time.max(now);
+            if save_protected_grant(&stored).is_err() {
+                return status(
+                    "error",
+                    "Windows не смог обновить защищённое состояние лицензии.",
+                );
+            }
+            status_from_grant(grant, stored, true)
+        }
+        Err(message) if message.contains("expired") => status(
+            "expired",
+            "Срок автономной работы истёк. Подключите интернет и повторите проверку.",
+        ),
+        Err(message) => {
+            clear_grant();
+            status("error", &message)
+        }
+    }
+}
+
+pub fn clear_grant() -> DeviceLicenseStatus {
+    let _ = crate::secure_storage::remove(GRANT_STORAGE_KEY.into());
+    status(
+        "not_activated",
+        "Game Passport не активирован на этом компьютере. Обратитесь к администратору клуба.",
+    )
+}
