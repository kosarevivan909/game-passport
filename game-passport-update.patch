+    fn set_launch_options(text: &str, value: &str) -> Result<String, UserFacingError> {
+        let (launch_line, block_close, block_indent) = locate_cs2_vdf_entries(text);
+        let newline = if text.contains("\r\n") { "\r\n" } else { "\n" };
+        let mut lines = text.lines().map(str::to_string).collect::<Vec<_>>();
+        let escaped = value.replace('\\', "\\\\").replace('"', "\\\"");
+        if let Some(index) = launch_line {
+            let indent = lines[index]
+                .chars()
+                .take_while(|character| character.is_whitespace())
+                .collect::<String>();
+            lines[index] = format!("{indent}\"LaunchOptions\"\t\t\"{escaped}\"");
+        } else if let Some(index) = block_close {
+            lines.insert(
+                index,
+                format!("{block_indent}\t\"LaunchOptions\"\t\t\"{escaped}\""),
+            );
+        } else if let Some((index, indent)) =
+            locate_vdf_block_close(text, &["Software", "Valve", "Steam", "apps"])
+        {
+            lines.splice(
+                index..index,
+                [
+                    format!("{indent}\t\"730\""),
+                    format!("{indent}\t{{"),
+                    format!("{indent}\t\t\"LaunchOptions\"\t\t\"{escaped}\""),
+                    format!("{indent}\t}}"),
+                ],
+            );
+        } else if let Some((index, indent)) =
+            locate_vdf_block_close(text, &["Software", "Valve", "Steam"])
+        {
+            lines.splice(
+                index..index,
+                [
+                    format!("{indent}\t\"apps\""),
+                    format!("{indent}\t{{"),
+                    format!("{indent}\t\t\"730\""),
+                    format!("{indent}\t\t{{"),
+                    format!("{indent}\t\t\t\"LaunchOptions\"\t\t\"{escaped}\""),
+                    format!("{indent}\t\t}}"),
+                    format!("{indent}\t}}"),
+                ],
+            );
+        } else {
+            return Err(UserFacingError::new(
+                "В локальных настройках Steam не найден базовый раздел Steam; игровые файлы применены без параметров запуска.",
+                true,
+            ));
+        }
+        let mut result = lines.join(newline);
+        if text.ends_with('\n') {
+            result.push_str(newline);
+        }
+        Ok(result)
+    }
