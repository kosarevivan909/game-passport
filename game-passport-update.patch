diff --git a/src/infrastructure/supabase/SupabaseDeviceLicenseProvider.ts b/src/infrastructure/supabase/SupabaseDeviceLicenseProvider.ts
new file mode 100644
index 0000000..3bef9f0
--- /dev/null
+++ b/src/infrastructure/supabase/SupabaseDeviceLicenseProvider.ts
@@ -0,0 +1,143 @@
+import { invoke } from "@tauri-apps/api/core";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { DeviceIdentity, DeviceLicenseProvider, DeviceLicenseStatus } from "../../domain/license";
+import { isTauriDesktop } from "../../services/platform";
+
+type ServerBody = {
+  code: string;
+  challengeId?: string;
+  challenge?: string;
+  purpose?: "activate" | "verify";
+  offlineGrant?: string;
+  expiresAt?: string;
+};
+
+type SignatureResponse = { state: string; message: string; signature?: string };
+
+const explicitDenials = new Set([
+  "DEVICE_REVOKED",
+  "DEVICE_NOT_ACTIVATED",
+  "DEVICE_HARDWARE_MISMATCH",
+  "LICENSE_EXPIRED",
+  "ACTIVATION_CODE_INVALID",
+]);
+
+export class SupabaseDeviceLicenseProvider implements DeviceLicenseProvider {
+  constructor(
+    private readonly client: SupabaseClient,
+    private readonly supabaseUrl: string,
+    private readonly anonKey: string,
+  ) {}
+
+  async check(): Promise<DeviceLicenseStatus> {
+    if (!isTauriDesktop()) return this.status("unsupported", "Проверка устройства доступна только в Windows-приложении.");
+    if (!navigator.onLine) return this.cached();
+    try {
+      const identity = await this.identity();
+      const challenge = await this.call({ action: "challenge", identity });
+      if (!challenge.ok) return await this.handleServerFailure(challenge.status, challenge.body);
+      return await this.completeChallenge(challenge.body);
+    } catch {
+      return this.cached();
+    }
+  }
+
+  async activate(code: string, deviceLabel: string): Promise<DeviceLicenseStatus> {
+    if (!isTauriDesktop()) return this.status("unsupported", "Активация доступна только в Windows-приложении.");
+    if (!navigator.onLine) return this.status("error", "Для первой активации подключите компьютер к интернету.", true);
+    try {
+      const identity = await this.identity();
+      const challenge = await this.call({
+        action: "activation_challenge",
+        activationCode: code.trim().toUpperCase(),
+        identity,
+      });
+      if (!challenge.ok) return await this.handleServerFailure(challenge.status, challenge.body);
+      return await this.completeChallenge(challenge.body, deviceLabel.trim());
+    } catch (error) {
+      return this.status("error", error instanceof Error ? error.message : "Не удалось активировать компьютер.", true);
+    }
+  }
+
+  async clear() {
+    if (isTauriDesktop()) await invoke("clear_device_license").catch(() => undefined);
+  }
+
+  private async identity(): Promise<DeviceIdentity> {
+    const identity = await invoke<DeviceIdentity>("get_device_identity");
+    if (identity.state !== "success" || !identity.publicKeyX || !identity.publicKeyY || !identity.publicKeySha256 || !identity.fingerprintHash || !identity.keyProtection) {
+      throw new Error(identity.message || "Windows не смог создать защищённую идентичность устройства.");
+    }
+    return identity;
+  }
+
+  private async completeChallenge(challenge: ServerBody, deviceLabel = "") {
+    if (!challenge.challengeId || !challenge.challenge || !challenge.purpose) {
+      return this.status("error", "Сервер вернул неполный запрос подтверждения устройства.", true);
+    }
+    const signature = await invoke<SignatureResponse>("sign_device_challenge", {
+      request: {
+        challengeId: challenge.challengeId,
+        challenge: challenge.challenge,
+        purpose: challenge.purpose,
+      },
+    });
+    if (signature.state !== "success" || !signature.signature) {
+      return this.status("error", signature.message || "Windows не смог подтвердить устройство.", true);
+    }
+    const verified = await this.call({
+      action: "verify",
+      challengeId: challenge.challengeId,
+      signature: signature.signature,
+      deviceLabel,
+    });
+    if (!verified.ok) return this.handleServerFailure(verified.status, verified.body);
+    if (!verified.body.offlineGrant) return this.status("error", "Сервер не выдал подписанное разрешение устройству.", true);
+    const accepted = await invoke<DeviceLicenseStatus>("accept_device_license_grant", { token: verified.body.offlineGrant });
+    return { ...accepted, retryable: accepted.state !== "active" };
+  }
+
+  private async call(payload: Record<string, unknown>) {
+    const { data } = await this.client.auth.getSession();
+    const token = data.session?.access_token;
+    if (!token) return { ok: false, status: 401, body: { code: "AUTH_REQUIRED" } as ServerBody };
+    const response = await fetch(`${this.supabaseUrl}/functions/v1/device-license`, {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${token}`,
+        apikey: this.anonKey,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify(payload),
+      cache: "no-store",
+    });
+    const body = await response.json().catch(() => ({ code: "INVALID_SERVER_RESPONSE" })) as ServerBody;
+    return { ok: response.ok, status: response.status, body };
+  }
+
+  private async handleServerFailure(httpStatus: number, body: ServerBody): Promise<DeviceLicenseStatus> {
+    if (explicitDenials.has(body.code)) {
+      await this.clear();
+      if (body.code === "DEVICE_NOT_ACTIVATED") return this.status("not_activated", "Game Passport не активирован на этом компьютере. Обратитесь к администратору клуба.");
+      if (body.code === "LICENSE_EXPIRED") return this.status("expired", "Лицензия компьютерного клуба истекла. Обратитесь к администратору.");
+      if (body.code === "ACTIVATION_CODE_INVALID") return this.status("not_activated", "Код активации недействителен или уже использован.", true);
+      if (body.code === "DEVICE_HARDWARE_MISMATCH") return this.status("revoked", "Устройство требует повторной активации после изменения Windows или диска.");
+      return this.status("revoked", "Game Passport отключён на этом компьютере. Обратитесь к администратору клуба.");
+    }
+    if (body.code === "SEAT_LIMIT_REACHED") return this.status("not_activated", "В лицензии клуба нет свободного места для этого компьютера.");
+    if (body.code === "AUTH_REQUIRED" || body.code === "AUTH_INVALID" || httpStatus === 401) {
+      return this.status("error", "Сеанс пользователя истёк. Войдите снова.", true);
+    }
+    if (httpStatus >= 500 || httpStatus === 429) return this.cached();
+    return this.status("error", `Проверка устройства не выполнена (${body.code || httpStatus}).`, true);
+  }
+
+  private async cached() {
+    const cached = await invoke<DeviceLicenseStatus>("get_cached_device_license");
+    return { ...cached, retryable: true };
+  }
+
+  private status(state: DeviceLicenseStatus["state"], message: string, retryable = false): DeviceLicenseStatus {
+    return { state, message, offlineGrace: false, retryable };
+  }
+}
