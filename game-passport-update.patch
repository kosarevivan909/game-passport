+use base64::{engine::general_purpose, Engine as _};
+use chrono::Utc;
+use p256::{
+    ecdsa::{signature::Verifier, Signature, VerifyingKey},
+    pkcs8::DecodePublicKey,
+};
+use serde::{Deserialize, Serialize};
+#[cfg(target_os = "windows")]
+use sha2::{Digest, Sha256};
+
+const GRANT_STORAGE_KEY: &str = "game-passport.license.grant.v1";
+const MAX_OFFLINE_GRANT_SECONDS: i64 = 7 * 24 * 60 * 60;
+const CLOCK_ROLLBACK_TOLERANCE_SECONDS: i64 = 5 * 60;
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceIdentityResponse {
+    pub state: String,
+    pub message: String,
+    pub public_key_x: Option<String>,
+    pub public_key_y: Option<String>,
+    pub public_key_sha256: Option<String>,
+    pub fingerprint_hash: Option<String>,
+    pub key_protection: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceChallengeRequest {
+    pub challenge_id: String,
+    pub challenge: String,
+    pub purpose: String,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceSignatureResponse {
+    pub state: String,
+    pub message: String,
+    pub signature: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceLicenseStatus {
+    pub state: String,
+    pub message: String,
+    pub device_id: Option<String>,
+    pub organization_id: Option<String>,
+    pub expires_at: Option<String>,
+    pub last_license_check: Option<String>,
+    pub offline_grace: bool,
+    pub key_protection: Option<String>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+struct ProtectedGrant {
+    token: String,
+    last_server_time: i64,
+    #[serde(default)]
+    last_observed_time: i64,
+    accepted_at: i64,
+    key_protection: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct GrantHeader {
+    alg: String,
+    typ: String,
+    kid: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct GrantPayload {
+    iss: String,
+    aud: String,
+    sub: String,
+    organization_id: String,
+    device_public_key_sha256: String,
+    license_version: i64,
+    iat: i64,
+    nbf: i64,
+    exp: i64,
+    server_time: i64,
+}
+
+struct ValidGrant {
+    payload: GrantPayload,
+}
+
+pub fn identity() -> DeviceIdentityResponse {
+    platform::identity()
+}
+
+pub fn sign_challenge(request: DeviceChallengeRequest) -> DeviceSignatureResponse {
+    if request.challenge_id.len() < 32
+        || request.challenge_id.len() > 64
+        || request.challenge.len() < 40
+        || request.challenge.len() > 96
+        || !request
+            .challenge
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || "-_".contains(character))
+        || !matches!(request.purpose.as_str(), "activate" | "verify")
+    {
+        return DeviceSignatureResponse {
+            state: "error".into(),
+            message: "The server challenge is malformed.".into(),
+            signature: None,
+        };
+    }
+    let identity = identity();
+    let (Some(public_key_sha256), Some(fingerprint_hash), Some(key_protection)) = (
+        identity.public_key_sha256,
+        identity.fingerprint_hash,
+        identity.key_protection,
+    ) else {
+        return DeviceSignatureResponse {
+            state: "error".into(),
+            message: identity.message,
+            signature: None,
+        };
+    };
+    let message = format!(
+        "game-passport-device-proof:v2\n{}\n{}\n{}\n{}\n{}\n{}",
+        request.challenge_id,
+        request.challenge,
+        request.purpose,
+        public_key_sha256,
+        fingerprint_hash,
+        key_protection
+    );
+    match platform::sign(message.as_bytes()) {
+        Ok(signature) => DeviceSignatureResponse {
+            state: "success".into(),
+            message: "Device challenge signed by the protected Windows key.".into(),
+            signature: Some(general_purpose::URL_SAFE_NO_PAD.encode(signature)),
+        },
+        Err(message) => DeviceSignatureResponse {
+            state: "error".into(),
+            message,
+            signature: None,
+        },
+    }
+}
+
+pub fn accept_grant(token: String) -> DeviceLicenseStatus {
+    let identity = identity();
+    let (Some(device_hash), Some(key_protection)) =
+        (identity.public_key_sha256, identity.key_protection)
+    else {
+        return status("error", &identity.message);
+    };
+    let now = Utc::now().timestamp();
+    let grant = match verify_grant(&token, &device_hash, now) {
+        Ok(value) => value,
+        Err(message) => return status("error", &message),
+    };
+    let stored = ProtectedGrant {
+        token,
+        last_server_time: grant.payload.server_time,
+        last_observed_time: now,
+        accepted_at: now,
+        key_protection,
+    };
+    if save_protected_grant(&stored).is_err() {
+        return status(
+            "error",
+            "The offline license grant could not be protected by Windows.",
+        );
+    }
+    status_from_grant(grant, stored, false)
+}
+
+pub fn cached_status() -> DeviceLicenseStatus {
+    let loaded = crate::secure_storage::get(GRANT_STORAGE_KEY.into());
+    if loaded.state != "success" {
+        return status(
+            "error",
+            "Windows could not unlock the cached device license.",
+        );
+    }
+    let Some(value) = loaded.value else {
+        return status(
+            "not_activated",
+            "Game Passport не активирован на этом компьютере. Обратитесь к администратору клуба.",
+        );
+    };
+    let mut stored: ProtectedGrant = match serde_json::from_str(&value) {
+        Ok(value) => value,
+        Err(_) => {
+            clear_grant();
+            return status("error", "The cached device license is damaged.");
+        }
+    };
+    let now = Utc::now().timestamp();
+    if clock_rolled_back(now, &stored) {
+        return status(
+            "clock_error",
+            "Проверьте дату и время Windows, затем повторите проверку лицензии.",
+        );
+    }
+    let identity = identity();
+    let Some(device_hash) = identity.public_key_sha256 else {
+        return status("error", &identity.message);
+    };
+    match verify_grant(&stored.token, &device_hash, now) {
+        Ok(grant) => {
+            stored.last_observed_time = stored.last_observed_time.max(now);
+            if save_protected_grant(&stored).is_err() {
+                return status(
+                    "error",
+                    "Windows не смог обновить защищённое состояние лицензии.",
+                );
+            }
+            status_from_grant(grant, stored, true)
+        }
+        Err(message) if message.contains("expired") => status(
+            "expired",
+            "Срок автономной работы истёк. Подключите интернет и повторите проверку.",
+        ),
+        Err(message) => {
+            clear_grant();
+            status("error", &message)
+        }
+    }
+}
+
+pub fn clear_grant() -> DeviceLicenseStatus {
+    let _ = crate::secure_storage::remove(GRANT_STORAGE_KEY.into());
+    status(
+        "not_activated",
+        "Game Passport не активирован на этом компьютере. Обратитесь к администратору клуба.",
+    )
+}
+
+#[cfg(not(test))]
+pub fn require_active() -> Result<(), String> {
+    if option_env!("GAME_PASSPORT_CLUB_TEST_BUILD") == Some("true") {
+        return Ok(());
+    }
+    let current = cached_status();
+    if matches!(current.state.as_str(), "active" | "offline_grace") {
+        Ok(())
+    } else {
+        Err(current.message)
+    }
+}
+
+#[cfg(test)]
+pub fn require_active() -> Result<(), String> {
+    Ok(())
+}
+
+fn status(state_value: &str, message: &str) -> DeviceLicenseStatus {
+    DeviceLicenseStatus {
+        state: state_value.into(),
+        message: message.into(),
+        device_id: None,
+        organization_id: None,
+        expires_at: None,
+        last_license_check: None,
+        offline_grace: false,
+        key_protection: None,
+    }
+}
+
+fn clock_rolled_back(now: i64, stored: &ProtectedGrant) -> bool {
+    now + CLOCK_ROLLBACK_TOLERANCE_SECONDS < stored.last_server_time.max(stored.last_observed_time)
+}
+
+fn save_protected_grant(stored: &ProtectedGrant) -> Result<(), String> {
+    let serialized = serde_json::to_string(stored)
+        .map_err(|_| "The offline license grant could not be encoded.".to_string())?;
+    let saved = crate::secure_storage::set(GRANT_STORAGE_KEY.into(), serialized);
+    if saved.state == "success" {
+        Ok(())
+    } else {
+        Err(saved.message)
+    }
+}
+
+fn status_from_grant(
+    grant: ValidGrant,
+    stored: ProtectedGrant,
+    offline: bool,
+) -> DeviceLicenseStatus {
+    let expires_at =
+        chrono::DateTime::from_timestamp(grant.payload.exp, 0).map(|value| value.to_rfc3339());
+    let checked_at =
+        chrono::DateTime::from_timestamp(stored.accepted_at, 0).map(|value| value.to_rfc3339());
+    DeviceLicenseStatus {
+        state: if offline { "offline_grace" } else { "active" }.into(),
+        message: if offline {
+            "Устройство подтверждено ранее. Используется защищённый автономный период.".into()
+        } else {
+            "Устройство активно и подтверждено сервером.".into()
+        },
+        device_id: Some(grant.payload.sub),
+        organization_id: Some(grant.payload.organization_id),
+        expires_at,
+        last_license_check: checked_at,
+        offline_grace: offline,
+        key_protection: Some(stored.key_protection),
+    }
+}
+
+fn verify_grant(token: &str, device_hash: &str, now: i64) -> Result<ValidGrant, String> {
+    let public_key = option_env!("GAME_PASSPORT_LICENSE_PUBLIC_KEY_SPKI_B64")
+        .ok_or("Device licensing is not configured in this build.")?;
+    verify_grant_with_key(
+        token,
+        device_hash,
+        now,
+        public_key,
+        option_env!("GAME_PASSPORT_LICENSE_SIGNING_KEY_ID"),
+    )
+}
+
+fn verify_grant_with_key(
+    token: &str,
+    device_hash: &str,
+    now: i64,
+    public_key: &str,
+    expected_key_id: Option<&str>,
+) -> Result<ValidGrant, String> {
+    let mut parts = token.split('.');
+    let header_part = parts.next().ok_or("Offline grant is malformed.")?;
+    let payload_part = parts.next().ok_or("Offline grant is malformed.")?;
+    let signature_part = parts.next().ok_or("Offline grant is malformed.")?;
+    if parts.next().is_some() {
+        return Err("Offline grant is malformed.".into());
+    }
+    let header: GrantHeader = decode_json(header_part)?;
+    if header.alg != "ES256" || header.typ != "GP-OFFLINE-GRANT" || header.kid.is_empty() {
+        return Err("Offline grant uses an unsupported signature format.".into());
+    }
+    if let Some(expected_key_id) = expected_key_id {
+        if header.kid != expected_key_id {
+            return Err("Offline grant was signed by an unexpected key.".into());
+        }
+    }
+    verify_signature(
+        &format!("{header_part}.{payload_part}"),
+        signature_part,
+        public_key,
+    )?;
+    let payload: GrantPayload = decode_json(payload_part)?;
+    if payload.iss != "game-passport-device-license"
+        || payload.aud != "game-passport-windows"
+        || payload.device_public_key_sha256 != device_hash
+        || payload.sub.is_empty()
+        || payload.organization_id.is_empty()
+        || payload.license_version <= 0
+        || payload.server_time != payload.iat
+        || payload.exp - payload.iat > MAX_OFFLINE_GRANT_SECONDS
+        || payload.exp <= payload.iat
+    {
+        return Err("Offline grant claims are invalid.".into());
+    }
+    if payload.nbf > now + CLOCK_ROLLBACK_TOLERANCE_SECONDS {
+        return Err("Offline grant is not valid yet. Check the Windows clock.".into());
+    }
+    if payload.exp <= now {
+        return Err("Offline grant expired.".into());
+    }
+    Ok(ValidGrant { payload })
+}
+
+fn decode_json<T: for<'de> Deserialize<'de>>(value: &str) -> Result<T, String> {
+    let bytes = general_purpose::URL_SAFE_NO_PAD
+        .decode(value)
+        .map_err(|_| "Offline grant contains invalid base64url data.")?;
+    serde_json::from_slice(&bytes).map_err(|_| "Offline grant contains invalid JSON.".into())
+}
+
+fn verify_signature(signing_input: &str, signature: &str, public_key: &str) -> Result<(), String> {
+    let der = general_purpose::STANDARD
+        .decode(public_key)
+        .map_err(|_| "The pinned license public key is invalid.")?;
+    let verifying_key = VerifyingKey::from_public_key_der(&der)
+        .map_err(|_| "The pinned license public key is invalid.")?;
+    let signature = general_purpose::URL_SAFE_NO_PAD
+        .decode(signature)
+        .map_err(|_| "Offline grant signature is malformed.")?;
+    let signature =
+        Signature::from_slice(&signature).map_err(|_| "Offline grant signature is malformed.")?;
+    verifying_key
+        .verify(signing_input.as_bytes(), &signature)
+        .map_err(|_| "Offline grant signature is invalid.".into())
+}
+
+#[cfg(not(target_os = "windows"))]
+mod platform {
+    use super::*;
+
+    pub fn identity() -> DeviceIdentityResponse {
+        DeviceIdentityResponse {
+            state: "unsupported".into(),
+            message: "Device licensing requires the Windows desktop application.".into(),
+            public_key_x: None,
+            public_key_y: None,
+            public_key_sha256: None,
+            fingerprint_hash: None,
+            key_protection: None,
+        }
+    }
+
+    pub fn sign(_message: &[u8]) -> Result<Vec<u8>, String> {
+        Err("Device licensing requires Windows CNG.".into())
+    }
+}
+
+#[cfg(target_os = "windows")]
+mod platform {
+    use super::*;
+    use std::ptr::null_mut;
+    use windows_sys::Win32::Security::Cryptography::{
+        NCryptCreatePersistedKey, NCryptExportKey, NCryptFinalizeKey, NCryptFreeObject,
+        NCryptOpenKey, NCryptOpenStorageProvider, NCryptSetProperty, NCryptSignHash,
+        BCRYPT_ECCPUBLIC_BLOB, BCRYPT_ECDSA_PUBLIC_P256_MAGIC, MS_KEY_STORAGE_PROVIDER,
+        MS_PLATFORM_CRYPTO_PROVIDER, NCRYPT_ECDSA_P256_ALGORITHM, NCRYPT_EXPORT_POLICY_PROPERTY,
+        NCRYPT_KEY_HANDLE, NCRYPT_PERSIST_FLAG, NCRYPT_PROV_HANDLE, NCRYPT_SILENT_FLAG,
+    };
+    use winreg::{enums::HKEY_LOCAL_MACHINE, RegKey};
+
+    const KEY_NAME: &str = "GamePassport.DeviceIdentity.v1";
+
+    struct Provider(NCRYPT_PROV_HANDLE);
+    impl Drop for Provider {
+        fn drop(&mut self) {
+            if self.0 != 0 {
+                unsafe { NCryptFreeObject(self.0) };
+            }
+        }
+    }
+    struct Key(NCRYPT_KEY_HANDLE);
+    impl Drop for Key {
+        fn drop(&mut self) {
+            if self.0 != 0 {
+                unsafe { NCryptFreeObject(self.0) };
+            }
+        }
+    }
+
+    fn succeeded(status: i32) -> bool {
+        status >= 0
+    }
+
+    fn wide(value: &str) -> Vec<u16> {
+        value.encode_utf16().chain(std::iter::once(0)).collect()
+    }
+
+    fn open_provider(name: *const u16) -> Result<Provider, String> {
+        let mut handle = 0;
+        let status = unsafe { NCryptOpenStorageProvider(&mut handle, name, 0) };
+        if succeeded(status) {
+            Ok(Provider(handle))
+        } else {
+            Err(format!(
+                "Windows CNG provider is unavailable (0x{status:08x})."
+            ))
+        }
+    }
+
+    fn open_existing(provider: &Provider) -> Option<Key> {
+        let mut key = 0;
+        let name = wide(KEY_NAME);
+        let status =
+            unsafe { NCryptOpenKey(provider.0, &mut key, name.as_ptr(), 0, NCRYPT_SILENT_FLAG) };
+        succeeded(status).then_some(Key(key))
+    }
+
+    fn create_key(provider: &Provider) -> Result<Key, String> {
+        let mut key = 0;
+        let name = wide(KEY_NAME);
+        let status = unsafe {
+            NCryptCreatePersistedKey(
+                provider.0,
+                &mut key,
+                NCRYPT_ECDSA_P256_ALGORITHM,
+                name.as_ptr(),
+                0,
+                NCRYPT_SILENT_FLAG,
+            )
+        };
+        if !succeeded(status) {
+            return Err(format!(
+                "Windows CNG could not create a device key (0x{status:08x})."
+            ));
+        }
+        let key = Key(key);
+        let export_policy = 0u32.to_ne_bytes();
+        let status = unsafe {
+            NCryptSetProperty(
+                key.0,
+                NCRYPT_EXPORT_POLICY_PROPERTY,
+                export_policy.as_ptr(),
+                export_policy.len() as u32,
+                NCRYPT_PERSIST_FLAG,
+            )
+        };
+        if !succeeded(status) {
+            return Err(format!(
+                "Windows CNG could not lock the device key export policy (0x{status:08x})."
+            ));
+        }
+        let status = unsafe { NCryptFinalizeKey(key.0, NCRYPT_SILENT_FLAG) };
+        if !succeeded(status) {
+            return Err(format!(
+                "Windows CNG could not finalize the device key (0x{status:08x})."
+            ));
+        }
+        Ok(key)
+    }
+
+    fn key() -> Result<(Provider, Key, &'static str), String> {
+        if let Ok(provider) = open_provider(MS_PLATFORM_CRYPTO_PROVIDER) {
+            if let Some(key) = open_existing(&provider) {
+                return Ok((provider, key, "tpm"));
+            }
+        }
+        if let Ok(provider) = open_provider(MS_KEY_STORAGE_PROVIDER) {
+            if let Some(key) = open_existing(&provider) {
+                return Ok((provider, key, "software"));
+            }
+        }
+        if let Ok(provider) = open_provider(MS_PLATFORM_CRYPTO_PROVIDER) {
+            if let Ok(key) = create_key(&provider) {
+                return Ok((provider, key, "tpm"));
+            }
+        }
+        let provider = open_provider(MS_KEY_STORAGE_PROVIDER)?;
+        let key = create_key(&provider)?;
+        Ok((provider, key, "software"))
+    }
+
+    fn public_coordinates(key: &Key) -> Result<([u8; 32], [u8; 32]), String> {
+        let mut required = 0u32;
+        let status = unsafe {
+            NCryptExportKey(
+                key.0,
+                0,
+                BCRYPT_ECCPUBLIC_BLOB,
+                null_mut(),
+                null_mut(),
+                0,
+                &mut required,
+                NCRYPT_SILENT_FLAG,
+            )
+        };
+        if !succeeded(status) || required < 72 {
+            return Err("Windows CNG could not size the device public key.".into());
+        }
+        let mut blob = vec![0u8; required as usize];
+        let status = unsafe {
+            NCryptExportKey(
+                key.0,
+                0,
+                BCRYPT_ECCPUBLIC_BLOB,
+                null_mut(),
+                blob.as_mut_ptr(),
+                blob.len() as u32,
+                &mut required,
+                NCRYPT_SILENT_FLAG,
+            )
+        };
+        if !succeeded(status) || blob.len() < 72 {
+            return Err("Windows CNG could not export the device public key.".into());
+        }
+        let magic = u32::from_le_bytes(blob[0..4].try_into().unwrap_or_default());
+        let size = u32::from_le_bytes(blob[4..8].try_into().unwrap_or_default());
+        if magic != BCRYPT_ECDSA_PUBLIC_P256_MAGIC || size != 32 {
+            return Err("Windows CNG returned an unexpected device public-key format.".into());
+        }
+        let mut x = [0u8; 32];
+        let mut y = [0u8; 32];
+        x.copy_from_slice(&blob[8..40]);
+        y.copy_from_slice(&blob[40..72]);
+        Ok((x, y))
+    }
+
+    fn fingerprint() -> Result<String, String> {
+        let hklm = RegKey::predef(HKEY_LOCAL_MACHINE);
+        let machine_guid: String = hklm
+            .open_subkey("SOFTWARE\\Microsoft\\Cryptography")
+            .and_then(|key| key.get_value("MachineGuid"))
+            .map_err(|_| "Windows MachineGuid is unavailable for clone detection.")?;
+        let system = hklm.open_subkey("SYSTEM\\CurrentControlSet\\Control\\SystemInformation");
+        let manufacturer = system
+            .as_ref()
+            .ok()
+            .and_then(|key| key.get_value::<String, _>("SystemManufacturer").ok())
+            .unwrap_or_default();
+        let product = system
+            .as_ref()
+            .ok()
+            .and_then(|key| key.get_value::<String, _>("SystemProductName").ok())
+            .unwrap_or_default();
+        let normalized = format!(
+            "{}|{}|{}",
+            machine_guid.trim().to_ascii_lowercase(),
+            manufacturer.trim().to_ascii_lowercase(),
+            product.trim().to_ascii_lowercase()
+        );
+        Ok(format!("{:x}", Sha256::digest(normalized.as_bytes())))
+    }
+
+    pub fn identity() -> DeviceIdentityResponse {
+        let result = (|| -> Result<DeviceIdentityResponse, String> {
+            let (_provider, key, protection) = key()?;
+            let (x, y) = public_coordinates(&key)?;
+            let x = general_purpose::URL_SAFE_NO_PAD.encode(x);
+            let y = general_purpose::URL_SAFE_NO_PAD.encode(y);
+            let public_hash = format!("{:x}", Sha256::digest(format!("{x}.{y}").as_bytes()));
+            Ok(DeviceIdentityResponse {
+                state: "success".into(),
+                message: if protection == "tpm" {
+                    "Device identity is protected by the Windows TPM provider.".into()
+                } else {
+                    "Device identity is non-exportable in Windows CNG software storage; TPM is unavailable.".into()
+                },
+                public_key_x: Some(x),
+                public_key_y: Some(y),
+                public_key_sha256: Some(public_hash),
+                fingerprint_hash: Some(fingerprint()?),
+                key_protection: Some(protection.into()),
+            })
+        })();
+        result.unwrap_or_else(|message| DeviceIdentityResponse {
+            state: "error".into(),
+            message,
+            public_key_x: None,
+            public_key_y: None,
+            public_key_sha256: None,
+            fingerprint_hash: None,
+            key_protection: None,
+        })
+    }
+
+    pub fn sign(message: &[u8]) -> Result<Vec<u8>, String> {
+        let (_provider, key, _) = key()?;
+        let digest = Sha256::digest(message);
+        let mut required = 0u32;
+        let status = unsafe {
+            NCryptSignHash(
+                key.0,
+                null_mut(),
+                digest.as_ptr(),
+                digest.len() as u32,
+                null_mut(),
+                0,
+                &mut required,
+                NCRYPT_SILENT_FLAG,
+            )
+        };
+        if !succeeded(status) || required != 64 {
+            return Err("Windows CNG could not size the device signature.".into());
+        }
+        let mut signature = vec![0u8; required as usize];
+        let status = unsafe {
+            NCryptSignHash(
+                key.0,
+                null_mut(),
+                digest.as_ptr(),
+                digest.len() as u32,
+                signature.as_mut_ptr(),
+                signature.len() as u32,
+                &mut required,
+                NCRYPT_SILENT_FLAG,
+            )
+        };
+        if !succeeded(status) || required as usize != signature.len() {
+            return Err("Windows CNG could not sign the device challenge.".into());
+        }
+        Ok(signature)
+    }
+}
