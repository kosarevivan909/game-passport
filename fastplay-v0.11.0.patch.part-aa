+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "e13c156562582aa81c60cb29407084cdb54c4164760106ab78e6c5b0858cf64e"
+
 [[package]]
 name = "zerotrie"
 version = "0.2.4"
diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index 76495e5..ff733da 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -1,8 +1,8 @@
 [package]
 name = "game-passport"
-version = "0.6.0"
+version = "0.11.0"
 description = "Portable gaming profiles for Windows PCs"
-authors = ["Game Passport"]
+authors = ["FastPlay"]
 license = "Proprietary"
 repository = ""
 edition = "2021"
@@ -19,6 +19,7 @@ tauri-build = { version = "2", features = [] }
 [dependencies]
 base64 = "0.22"
 chrono = { version = "0.4", default-features = false, features = ["clock", "serde"] }
+p256 = { version = "0.13", features = ["ecdsa", "pkcs8"] }
 serde = { version = "1", features = ["derive"] }
 serde_json = "1"
 sha2 = "0.10"
@@ -26,7 +27,7 @@ tauri = { version = "2", features = [] }
 
 [target.'cfg(windows)'.dependencies]
 hidapi = { version = "2.6.3", default-features = false, features = ["windows-native"] }
-windows-sys = { version = "0.59", features = ["Win32_Foundation", "Win32_Graphics_Gdi", "Win32_System_Diagnostics_ToolHelp"] }
+windows-sys = { version = "0.59", features = ["Win32_Foundation", "Win32_Graphics_Gdi", "Win32_Security_Cryptography", "Win32_Storage_FileSystem", "Win32_System_Diagnostics_ToolHelp", "Win32_System_LibraryLoader", "Win32_UI_ColorSystem", "Win32_UI_Input_KeyboardAndMouse", "Win32_UI_WindowsAndMessaging"] }
 winreg = "0.55"
 
 [dev-dependencies]
diff --git a/src-tauri/capabilities/default.json b/src-tauri/capabilities/default.json
index 1ac6e59..0eb139c 100644
--- a/src-tauri/capabilities/default.json
+++ b/src-tauri/capabilities/default.json
@@ -1,7 +1,7 @@
 {
   "$schema": "../gen/schemas/desktop-schema.json",
   "identifier": "default",
-  "description": "Minimal permissions for the Game Passport main window",
+  "description": "Minimal permissions for the FastPlay main window",
   "windows": ["main"],
   "permissions": ["core:default"]
 }
diff --git a/src-tauri/gen/schemas/capabilities.json b/src-tauri/gen/schemas/capabilities.json
index 8fe7b95..86ae665 100644
--- a/src-tauri/gen/schemas/capabilities.json
+++ b/src-tauri/gen/schemas/capabilities.json
@@ -1 +1 @@
-{"default":{"identifier":"default","description":"Minimal permissions for the Game Passport main window","local":true,"windows":["main"],"permissions":["core:default"]}}
\ No newline at end of file
+{"default":{"identifier":"default","description":"Minimal permissions for the FastPlay main window","local":true,"windows":["main"],"permissions":["core:default"]}}
\ No newline at end of file
