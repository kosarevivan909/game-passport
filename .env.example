VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Set to false after Supabase is configured. Demo mode never sends data to the cloud.
VITE_DEMO_MODE=true
# Set to true for a local-profile Windows field-test build with real adapters.
VITE_FIELD_TEST_MODE=false
