@@ -0,0 +1,30 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { invoke } from "@tauri-apps/api/core";
+import { Cs2PreflightAdapter } from "../adapters/Cs2PreflightAdapter";
+import type { GameProfile } from "../domain/types";
+
+vi.mock("@tauri-apps/api/core", () => ({ invoke: vi.fn() }));
+vi.mock("../services/platform", () => ({ isTauriDesktop: () => true }));
+
+describe("CS2 snapshot compatibility preflight", () => {
+  const profile = { game: "cs2", settings: { adapters: { "game.cs2": { schemaVersion: 2, files: [] } } } } as unknown as GameProfile;
+  beforeEach(() => vi.resetAllMocks());
+  it("stops before machine checks when the saved crosshair is outdated", async () => {
+    vi.mocked(invoke).mockResolvedValue({ state: "error", message: "Пересохраните профиль", details: [], retryable: false });
+    const result = await new Cs2PreflightAdapter().apply(profile);
+    expect(result.state).toBe("error");
+    expect(invoke).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledWith("check_cs2_snapshot", { payload: (profile.settings.adapters as Record<string, unknown>)["game.cs2"] });
+  });
+  it("checks the environment after snapshot validation", async () => {
+    vi.mocked(invoke).mockResolvedValue({ state: "success", message: "OK", details: [], retryable: false });
+    expect((await new Cs2PreflightAdapter().apply(profile)).state).toBe("success");
+    expect(invoke).toHaveBeenNthCalledWith(2, "check_cs2_closed");
+  });
+  it("does not block backup restoration with snapshot migration checks", async () => {
+    vi.mocked(invoke).mockResolvedValue({ state: "success", message: "OK", details: [], retryable: false });
+    await new Cs2PreflightAdapter().restore();
+    expect(invoke).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledWith("check_cs2_closed");
+  });
+});
