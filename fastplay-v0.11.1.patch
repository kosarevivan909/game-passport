@@ -0,0 +1,217 @@
+//! Crosshair compatibility checks. The actual VCFG remains byte-for-byte intact.
+//! Valve's September 2026 format couples pixel sizes with their authored height.
+use std::collections::BTreeMap;
+
+const PIXEL_KEYS: [&str; 4] = [
+    "cl_crosshair_length",
+    "cl_crosshair_thickness",
+    "cl_crosshair_gap",
+    "cl_crosshair_screen_height",
+];
+
+#[derive(Debug, PartialEq)]
+enum Token {
+    Word(String),
+    Open,
+    Close,
+}
+
+// KV1 lexer: comments and quoted bind/alias contents must not become convars.
+fn tokens(text: &str) -> Result<Vec<Token>, String> {
+    let mut chars = text.trim_start_matches('\u{feff}').chars().peekable();
+    let mut result = Vec::new();
+    while let Some(c) = chars.next() {
+        match c {
+            c if c.is_whitespace() => {}
+            '/' if chars.peek() == Some(&'/') => {
+                for c in chars.by_ref() {
+                    if c == '\n' {
+                        break;
+                    }
+                }
+            }
+            '{' => result.push(Token::Open),
+            '}' => result.push(Token::Close),
+            '"' => {
+                let mut value = String::new();
+                let mut closed = false;
+                while let Some(c) = chars.next() {
+                    if c == '"' {
+                        closed = true;
+                        break;
+                    }
+                    if c == '\\' {
+                        value.push(
+                            chars
+                                .next()
+                                .ok_or("Незавершённая escape-последовательность VCFG.")?,
+                        );
+                    } else {
+                        value.push(c);
+                    }
+                }
+                if !closed {
+                    return Err("Незавершённая строка VCFG.".into());
+                }
+                result.push(Token::Word(value));
+            }
+            _ => {
+                let mut value = String::from(c);
+                while chars
+                    .peek()
+                    .is_some_and(|c| !c.is_whitespace() && !matches!(c, '{' | '}' | '"'))
+                {
+                    value.push(chars.next().unwrap());
+                }
+                result.push(Token::Word(value));
+            }
+        }
+    }
+    Ok(result)
+}
+
+pub fn crosshair_values(bytes: &[u8]) -> Result<BTreeMap<String, String>, String> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "VCFG CS2 не является UTF-8.")?;
+    let tokens = tokens(text)?;
+    let mut scope: Vec<String> = Vec::new();
+    let mut result = BTreeMap::new();
+    let mut i = 0;
+    while i < tokens.len() {
+        match (&tokens[i], tokens.get(i + 1)) {
+            (Token::Word(key), Some(Token::Open)) => {
+                scope.push(key.to_ascii_lowercase());
+                i += 2;
+            }
+            (Token::Word(key), Some(Token::Word(value))) => {
+                let key = key.to_ascii_lowercase();
+                // Source 2 can use $0 for the primary local player; never mix $1.
+                let key = key.strip_suffix("$0").unwrap_or(&key);
+                if scope.last().is_some_and(|s| s == "convars")
+                    && !key.contains('$')
+                    && is_crosshair_key(key)
+                    && result.insert(key.into(), value.clone()).is_some()
+                {
+                    return Err(format!("Повторяющийся параметр прицела: {key}."));
+                }
+                i += 2;
+            }
+            (Token::Close, _) if !scope.is_empty() => {
+                scope.pop();
+                i += 1;
+            }
+            _ => return Err("Не удалось разобрать структуру VCFG CS2.".into()),
+        }
+    }
+    if !scope.is_empty() {
+        return Err("Незавершённый блок VCFG CS2.".into());
+    }
+    Ok(result)
+}
+
+fn is_crosshair_key(key: &str) -> bool {
+    key == "crosshair"
+        || key.starts_with("cl_crosshair")
+        || key.starts_with("cl_grenadecrosshair")
+        || key.starts_with("cl_ironsight_")
+        || key.starts_with("cl_sniper_")
+}
+
+pub fn validate(values: &BTreeMap<String, String>) -> Result<(), String> {
+    let missing: Vec<_> = PIXEL_KEYS
+        .iter()
+        .filter(|key| !values.contains_key(**key))
+        .copied()
+        .collect();
+    if !missing.is_empty() {
+        return Err(format!("В профиле нет полного нового формата прицела CS2: {}. На исходном ПК обновите CS2, настройте прицел, закройте игру и заново сохраните профиль в FastPlay. Старые размеры нельзя безопасно пересчитать автоматически.", missing.join(", ")));
+    }
+    for key in PIXEL_KEYS {
+        let number = values[key].parse::<f64>().ok().filter(|v| v.is_finite());
+        let minimum = if key == "cl_crosshair_screen_height" {
+            240.0
+        } else {
+            0.0
+        };
+        if number.map_or(true, |v| v < minimum) {
+            return Err(format!("Некорректный параметр прицела {key}. Заново сохраните настройки после закрытия CS2."));
+        }
+    }
+    Ok(())
+}
+
+/// Conservative diagnostics only: scripts are never executed or rewritten.
+pub fn script_may_override(text: &str) -> bool {
+    text.lines().any(|line| {
+        let code = line
+            .split("//")
+            .next()
+            .unwrap_or_default()
+            .to_ascii_lowercase();
+        code.contains("crosshair") || code.contains("cl_ironsight_") || code.contains("cl_sniper_")
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    pub const MODERN: &str = r#""config" { "convars" {
+        "cl_crosshair_length$0" "8" "cl_crosshair_thickness$0" "2"
+        "cl_crosshair_gap$0" "0" "cl_crosshair_screen_height$0" "960"
+        "cl_crosshairstyle$0" "8" "cl_crosshair_drawoutline$0" "2"
+        "cl_crosshaircolor_a$0" "127" "cl_crosshair_dynamic_spread_limit$0" "64"
+        "cl_crosshair_future_option$0" "42"
+    } }"#;
+
+    #[test]
+    fn retains_new_styles_opacity_outline_and_authored_resolution() {
+        let values = crosshair_values(MODERN.as_bytes()).unwrap();
+        validate(&values).unwrap();
+        assert_eq!(values["cl_crosshair_screen_height"], "960");
+        assert_eq!(values["cl_crosshairstyle"], "8");
+        assert_eq!(values["cl_crosshair_drawoutline"], "2");
+        assert_eq!(values["cl_crosshaircolor_a"], "127");
+        assert_eq!(values["cl_crosshair_future_option"], "42");
+    }
+    #[test]
+    fn old_profiles_and_missing_scale_are_not_silently_migrated() {
+        let old = br#""config" { "convars" { "cl_crosshairsize" "3.9" } }"#;
+        assert!(validate(&crosshair_values(old).unwrap()).is_err());
+        let mut values = crosshair_values(MODERN.as_bytes()).unwrap();
+        values.remove("cl_crosshair_screen_height");
+        assert!(validate(&values).is_err());
+    }
+    #[test]
+    fn rejects_invalid_scale_but_accepts_zero_gap() {
+        for value in ["NaN", "inf", "0", "-1"] {
+            let mut values = crosshair_values(MODERN.as_bytes()).unwrap();
+            values.insert("cl_crosshair_screen_height".into(), value.into());
+            assert!(validate(&values).is_err());
+        }
+    }
+    #[test]
+    fn ignores_comments_bind_strings_and_other_player() {
+        let text = format!("\u{feff}// \"cl_crosshair_gap\" \"99\"\n{MODERN}\n\"bindings\" {{ \"A\" \"cl_crosshair_gap 99\" }}\n\"config\" {{ \"convars\" {{ \"cl_crosshair_gap$1\" \"88\" }} }}");
+        let values = crosshair_values(text.as_bytes()).unwrap();
+        assert_eq!(values["cl_crosshair_gap"], "0");
+    }
+    #[test]
+    fn rejects_malformed_or_ambiguous_input() {
+        for text in [
+            "\"config\" {",
+            "\"config",
+            "}",
+            "\"config\" { \"convars\" { \"crosshair\" \"1\" \"crosshair$0\" \"0\" } }",
+        ] {
+            assert!(crosshair_values(text.as_bytes()).is_err());
+        }
+    }
+    #[test]
+    fn finds_cfg_and_launch_overrides_without_executing_them() {
+        assert!(script_may_override("alias aim \"cl_crosshair_length 3\""));
+        assert!(script_may_override("+cl_crosshairstyle 4"));
+        assert!(!script_may_override(
+            "// cl_crosshair_length 3\nsensitivity 1.2"
+        ));
+    }
+}
