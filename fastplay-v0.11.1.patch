 use serde::{Deserialize, Serialize};
 
+fn inspect_crosshair(payload: &Cs2Payload) -> Result<Vec<String>, String> {
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    use sha2::{Digest, Sha256};
+    if payload.files.len() > 32
+        || payload
+            .files
+            .iter()
+            .any(|f| f.size > 512 * 1024 || f.content_base64.len() > 700_000)
+    {
+        return Err("Снимок CS2 превышает безопасный размер.".into());
+    }
+    let mut convars = None;
+    let mut overrides = Vec::new();
+    for file in &payload.files {
+        let bytes = STANDARD
+            .decode(&file.content_base64)
+            .map_err(|_| "Повреждён снимок CS2.")?;
+        if bytes.len() as u64 != file.size
+            || format!("{:x}", Sha256::digest(&bytes)) != file.sha256.to_ascii_lowercase()
+        {
+            return Err("Снимок CS2 не прошёл проверку целостности.".into());
+        }
+        if file.scope == "userdata"
+            && file
+                .relative_path
+                .eq_ignore_ascii_case("cs2_user_convars_0_slot0.vcfg")
+        {
+            if convars.is_some() {
+                return Err("В снимке CS2 повторяется файл пользовательских параметров.".into());
+            }
+            convars = Some(crate::cs2_crosshair::crosshair_values(&bytes)?);
+        }
+        if file.relative_path.to_ascii_lowercase().ends_with(".cfg")
+            && crate::cs2_crosshair::script_may_override(&String::from_utf8_lossy(&bytes))
+        {
+            overrides.push(format!("{}/{}", file.scope, file.relative_path));
+        }
+    }
+    let values = convars.ok_or("Нет файла пользовательских параметров CS2.")?;
+    crate::cs2_crosshair::validate(&values)?;
+    let mut warnings = Vec::new();
+    if !overrides.is_empty() {
+        warnings.push(format!("CFG содержит команды прицела: {}. При выполнении cfg или привязанных команд они могут заменить сохранённый прицел. FastPlay сохраняет эти скрипты без изменения; удалите устаревшие команды или обновите их перед повторным сохранением.", overrides.join(", ")));
+    }
+    if payload
+        .launch_options
+        .as_deref()
+        .is_some_and(crate::cs2_crosshair::script_may_override)
+    {
+        warnings.push("Параметры запуска Steam содержат команды прицела и могут переопределить сохранённые значения.".into());
+    }
+    Ok(warnings)
+}
+
+/// Read-only validation runs before any display/GPU adapter is allowed to apply.
+pub fn check_snapshot(payload: &Cs2Payload) -> Cs2CommandResponse {
+    let (state, message, details) = match inspect_crosshair(payload) {
+        Ok(warnings) if warnings.is_empty() => ("success", "Новый формат прицела CS2 проверен.", warnings),
+        Ok(warnings) => ("warning", "Прицел сохранён, но CFG или параметры запуска могут его изменить.", warnings),
+        Err(error) => ("error", "Нельзя безопасно применить прицел из этого профиля. Пересохраните профиль после обновления CS2.", vec![error]),
+    };
+    Cs2CommandResponse {
+        state: state.into(),
+        message: message.into(),
+        details,
+        retryable: false,
+        payload: None,
+        manual_launch_options: None,
+        backup_token: None,
+    }
+}
+
