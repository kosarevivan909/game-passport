+export type DeviceLicenseState =
+  | "not_required"
+  | "checking"
+  | "active"
+  | "offline_grace"
+  | "not_activated"
+  | "revoked"
+  | "expired"
+  | "clock_error"
+  | "configuration_error"
+  | "unsupported"
+  | "error";
+
+export interface DeviceIdentity {
+  state: "success" | "error" | "unsupported";
+  message: string;
+  publicKeyX?: string;
+  publicKeyY?: string;
+  publicKeySha256?: string;
+  fingerprintHash?: string;
+  keyProtection?: "tpm" | "software";
+}
+
+export interface DeviceLicenseStatus {
+  state: DeviceLicenseState;
+  message: string;
+  deviceId?: string;
+  organizationId?: string;
+  expiresAt?: string;
+  lastLicenseCheck?: string;
+  offlineGrace: boolean;
+  keyProtection?: "tpm" | "software";
+  retryable?: boolean;
+}
+
+export interface DeviceLicenseProvider {
+  check(): Promise<DeviceLicenseStatus>;
+  activate(code: string, deviceLabel: string): Promise<DeviceLicenseStatus>;
+  clear(): Promise<void>;
+}
