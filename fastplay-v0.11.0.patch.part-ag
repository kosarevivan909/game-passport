+
+/* Obsidian — restrained warm-metal edition */
+body {
+  background:
+    linear-gradient(125deg, transparent 0 63%, rgba(209,178,115,.025) 63.1% 63.2%, transparent 63.3%),
+    linear-gradient(35deg, #090909, #0d0d0e 52%, #090909);
+}
+
+.app-shell {
+  background:
+    linear-gradient(118deg, transparent 0 71%, rgba(209,178,115,.026) 71.1% 71.2%, transparent 71.3%),
+    linear-gradient(28deg, transparent 0 42%, rgba(255,255,255,.012) 42.1% 42.2%, transparent 42.3%),
+    var(--bg);
+}
+
+.brand { color: #f2eee6; font-size: 11px; font-weight: 650; letter-spacing: .15em; }
+.eyebrow { color: var(--accent); font-size: 10px; font-weight: 600; letter-spacing: .19em; }
+
+.sidebar {
+  padding-inline: 24px;
+  border-color: rgba(209,178,115,.12);
+  background: rgba(10,10,11,.95);
+  box-shadow: 18px 0 70px rgba(0,0,0,.18);
+}
+.sidebar nav { gap: 4px; }
+.sidebar nav button {
+  position: relative;
+  min-height: 45px;
+  padding-left: 17px;
+  border-radius: 0;
+  color: #77746e;
+  font-size: 11px;
+  transition: color .18s ease, background .18s ease, transform .18s ease;
+}
+.sidebar nav button::before { content: ""; position: absolute; left: 0; width: 2px; height: 0; background: var(--accent); transition: height .2s ease; }
+.sidebar nav button:hover, .sidebar nav button.active { color: #ece7de; background: linear-gradient(90deg, rgba(209,178,115,.08), transparent); transform: translateX(2px); }
+.sidebar nav button.active::before { height: 24px; }
+.sidebar nav button.active svg, .sidebar nav button:hover svg { color: var(--accent); }
+
+.cloud-state, .account, .panel, .diagnostic-card, .setup-item, .wizard-toolbar, .wizard-step, .export-result {
+  border-color: rgba(240,236,228,.09);
+  background: rgba(18,18,19,.92);
+}
+.account > span { color: #0b0b0b; border-radius: 0; background: var(--accent); clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%); }
+
+.content-view { padding-top: 62px; }
+.page-heading h1 { max-width: 760px; color: #f2eee6; font-size: clamp(31px, 3vw, 43px); font-weight: 540; line-height: 1.18; letter-spacing: -.035em; }
+
+.button {
+  position: relative;
+  overflow: hidden;
+  min-height: 45px;
+  border-radius: 0;
+  clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 11px 100%, 0 calc(100% - 11px));
+  font-size: 10px;
+  font-weight: 570;
+  letter-spacing: .025em;
+}
+.button::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,.22), transparent 70%); transform: translateX(-130%); transition: transform .55s ease; pointer-events: none; }
+.button:not(:disabled):hover::after { transform: translateX(130%); }
+.button.primary { color: #0b0b0b; background: linear-gradient(135deg, #dfc58e, #b99451); box-shadow: 0 12px 35px rgba(209,178,115,.1); }
+.button.primary:not(:disabled):hover { background: linear-gradient(135deg, #ead3a2, #c39f5c); }
+.button.secondary, .button.apply { border-color: rgba(209,178,115,.16); background: #171716; }
+.button.apply:hover { color: #0b0b0b; border-color: var(--accent); background: var(--accent); }
+.button.danger-button { color: #fff1f1; border-color: rgba(255,100,100,.35); background: rgba(255,100,100,.12); }
+.button.danger-button:hover { border-color: rgba(255,100,100,.75); background: rgba(255,100,100,.22); }
+.confirm-modal { width: min(460px, calc(100vw - 48px)); }
+.icon-button { border-radius: 0; clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 0 100%); }
+
+.profile-grid { gap: 19px; }
+.profile-card {
+  min-height: 332px;
+  padding: 21px;
+  border-color: rgba(240,236,228,.105);
+  border-radius: 0;
+  background:
+    linear-gradient(135deg, rgba(255,255,255,.025), transparent 44%),
+    linear-gradient(155deg, #171716, #0f0f10 76%);
+  clip-path: polygon(0 0, calc(100% - 21px) 0, 100% 21px, 100% 100%, 0 100%);
+  box-shadow: inset 0 1px rgba(255,255,255,.025), 0 22px 60px rgba(0,0,0,.16);
+  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
+}
+.profile-card::before { content: ""; position: absolute; z-index: 1; top: 0; right: 20px; left: 0; height: 1px; background: linear-gradient(90deg, var(--accent), rgba(209,178,115,.08) 45%, transparent); opacity: .55; }
+.profile-card:hover { transform: translateY(-5px); border-color: rgba(209,178,115,.28); box-shadow: 0 28px 70px rgba(0,0,0,.3); }
+.card-glow { border-radius: 0; }
+.card-glow::after { background: var(--accent); opacity: .045; }
+.game-badge {
+  position: relative;
+  min-width: 52px;
+  padding: 8px 12px 8px 16px;
+  color: #ead5aa;
+  border-color: rgba(209,178,115,.28);
+  border-radius: 0;
+  background: rgba(209,178,115,.055);
+  clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
+  font-size: 10px;
+  font-weight: 600;
+}
+.game-badge::before { content: ""; position: absolute; left: 0; top: 7px; bottom: 0; width: 3px; background: var(--accent); }
+.profile-card-copy h3 { color: #f2eee6; font-size: 19px; font-weight: 520; line-height: 1.35; }
+.profile-facts b { color: #c6bda9; border-color: rgba(209,178,115,.12); border-radius: 0; background: rgba(209,178,115,.035); }
+.card-menu { border-radius: 0; background: #1a1a1a; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); }
+.card-menu button { border-radius: 0; }
+.add-card { border-color: rgba(209,178,115,.17); border-radius: 0; background: rgba(209,178,115,.012); clip-path: polygon(0 0, calc(100% - 21px) 0, 100% 21px, 100% 100%, 0 100%); }
+.add-card:hover:not(:disabled) { color: #cfc7b8; border-color: rgba(209,178,115,.4); background: rgba(209,178,115,.035); }
+.add-card svg { color: var(--accent); }
+
+.auth-shell { background: var(--bg); }
+.auth-hero {
+  border-color: rgba(209,178,115,.13);
+  background:
+    linear-gradient(130deg, transparent 0 62%, rgba(209,178,115,.045) 62.1% 62.2%, transparent 62.3%),
+    linear-gradient(155deg, #151514, #090909 72%);
+}
+.auth-hero::after { width: 360px; height: 1px; right: -40px; top: 30%; border: 0; border-radius: 0; background: linear-gradient(90deg, transparent, rgba(209,178,115,.22)); box-shadow: none; transform: rotate(-35deg); }
+.hero-copy h1 { font-size: clamp(47px, 4.8vw, 74px); font-weight: 470; line-height: 1.05; letter-spacing: -.055em; }
+.hero-copy h1 span { color: var(--accent); }
+.auth-panel { background: linear-gradient(160deg, #101010, #090909); }
+.auth-card h2 { font-size: 26px; font-weight: 520; line-height: 1.35; }
+input, select { border-color: rgba(240,236,228,.11); border-radius: 0; background: #131313; }
+input:focus { border-color: rgba(209,178,115,.65); box-shadow: 0 0 0 3px rgba(209,178,115,.07); }
+
+.process-shell { background: linear-gradient(145deg, #111110, #090909 65%); }
+.passport-orb { border-color: rgba(209,178,115,.18); border-radius: 0; box-shadow: 0 0 0 16px rgba(209,178,115,.012), 0 0 70px rgba(209,178,115,.055); transform: rotate(45deg); }
+.passport-orb > div { border-color: rgba(209,178,115,.48); border-radius: 0; }
+.passport-orb span { color: var(--accent); font-family: "Unbounded", sans-serif; }
+.process-row { border-radius: 0; background: #121213; clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%); }
+.process-row.running { border-color: rgba(209,178,115,.28); background: rgba(209,178,115,.035); }
+.process-row.running svg, .process-row.success svg { color: var(--accent); }
+.real-progress i, .limit-strip i, .onboarding-progress i.active { background: linear-gradient(90deg, #aa8848, #dfc58e); }
+
+.modal, .onboarding-card, .empty-state, .foundation-note, .recovery-banner, .license-card { border-radius: 0; clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%); }
+.modal, .onboarding-card { background: #121213; }
+.empty-state { background: linear-gradient(155deg, rgba(209,178,115,.045), transparent 34%), #101011; }
+.panel, .diagnostic-card, .setup-item, .wizard-toolbar, .wizard-step { border-radius: 0; }
+.diagnostic-icon, .setup-icon, .wizard-status, .onboarding-icon, .empty-icon { color: var(--accent); border-radius: 0; background: rgba(209,178,115,.07); }
+.game-tabs button { border-radius: 0; }
+.game-tabs button.active { color: #0c0c0b; background: var(--accent); }
+.status-pill.implemented { color: var(--accent); background: rgba(209,178,115,.08); }
diff --git a/src/test/AuthProvider.test.ts b/src/test/AuthProvider.test.ts
new file mode 100644
index 0000000..be23f63
--- /dev/null
+++ b/src/test/AuthProvider.test.ts
@@ -0,0 +1,26 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { describe, expect, it, vi } from "vitest";
+import { SupabaseAuthProvider } from "../infrastructure/supabase/SupabaseAuthProvider";
+
+describe("SupabaseAuthProvider callbacks", () => {
+  it("sends signup confirmation to the public callback page", async () => {
+    const signUp = vi.fn().mockResolvedValue({ data: { user: { id: "u1", email: "player@example.com" }, session: null }, error: null });
+    const provider = new SupabaseAuthProvider({ auth: { signUp } } as unknown as SupabaseClient, "https://project.supabase.co");
+    await expect(provider.signUp("PLAYER@example.com ", "secret12")).resolves.toMatchObject({ email: "player@example.com", confirmationRequired: true, user: null });
+    expect(signUp).toHaveBeenCalledWith(expect.objectContaining({ options: { emailRedirectTo: "https://project.supabase.co/functions/v1/auth-callback?flow=signup" } }));
+  });
+
+  it("resends confirmation with the same safe callback", async () => {
+    const resend = vi.fn().mockResolvedValue({ error: null });
+    const provider = new SupabaseAuthProvider({ auth: { resend } } as unknown as SupabaseClient, "https://project.supabase.co/");
+    await provider.resendConfirmation("player@example.com");
+    expect(resend).toHaveBeenCalledWith({ type: "signup", email: "player@example.com", options: { emailRedirectTo: "https://project.supabase.co/functions/v1/auth-callback?flow=signup" } });
+  });
+
+  it("keeps password recovery on its separate callback flow", async () => {
+    const resetPasswordForEmail = vi.fn().mockResolvedValue({ error: null });
+    const provider = new SupabaseAuthProvider({ auth: { resetPasswordForEmail } } as unknown as SupabaseClient, "https://project.supabase.co");
+    await provider.requestPasswordReset("player@example.com");
+    expect(resetPasswordForEmail).toHaveBeenCalledWith("player@example.com", { redirectTo: "https://project.supabase.co/functions/v1/auth-callback?flow=recovery" });
+  });
+});
