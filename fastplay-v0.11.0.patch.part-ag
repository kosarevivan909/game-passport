+      signIn: async () => ({ id: "unused", email: "unused@example.com" }),
+      signUp: async (email) => ({ user: null, email, confirmationRequired: true }),
+      resendConfirmation: async () => undefined,
+      requestPasswordReset: async (email) => { requested = email; },
+      signOut: async () => undefined,
+      onAuthChange: () => () => undefined,
+    };
+    render(<AuthScreen auth={auth} mode="cloud" onAuthenticated={() => undefined} />);
+    fireEvent.click(screen.getByRole("button", { name: "Забыли пароль?" }));
+    fireEvent.change(screen.getByLabelText("Email"), { target: { value: "player@example.com" } });
+    fireEvent.click(screen.getByRole("button", { name: "Восстановить пароль" }));
+    await waitFor(() => expect(requested).toBe("player@example.com"));
+    expect(screen.getByText(/Если аккаунт с такой почтой существует/i)).toBeInTheDocument();
+  });
 });
diff --git a/src/test/BackupManifests.test.ts b/src/test/BackupManifests.test.ts
new file mode 100644
index 0000000..9de8880
--- /dev/null
+++ b/src/test/BackupManifests.test.ts
@@ -0,0 +1,44 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import type { GameProfile } from "../domain/types";
+import { backupManifests } from "../services/backupManifests";
+
+const profile: GameProfile = {
+  id: "profile-1",
+  userId: "user-1",
+  name: "Main",
+  game: "cs2",
+  settings: {},
+  createdAt: "2026-01-01",
+  updatedAt: "2026-01-01",
+};
+
+describe("backupManifests", () => {
+  beforeEach(() => localStorage.clear());
+
+  it("keeps exact adapter backup tokens local to a profile and game", () => {
+    backupManifests.begin(profile);
+    backupManifests.record(profile, {
+      adapterId: "nvidia",
+      label: "NVIDIA",
+      state: "success",
+      message: "applied",
+      backupToken: "C:/local/backup.json",
+    });
+
+    expect(backupManifests.tokens(profile)).toEqual({ nvidia: "C:/local/backup.json" });
+    expect(backupManifests.tokens({ ...profile, game: "pubg" })).toEqual({});
+  });
+
+  it("starts a clean manifest for every new apply operation", () => {
+    backupManifests.begin(profile);
+    backupManifests.record(profile, {
+      adapterId: "display",
+      label: "Display",
+      state: "success",
+      message: "applied",
+      backupToken: "first",
+    });
+    backupManifests.begin(profile);
+    expect(backupManifests.tokens(profile)).toEqual({});
+  });
+});
