 type Row = { id: string; user_id: string; name: string; game: GameProfile["game"]; settings: Record<string, unknown>; created_at: string; updated_at: string };
-const map = (row: Row): GameProfile => ({ id: row.id, userId: row.user_id, name: row.name, game: row.game, settings: row.settings ?? {}, createdAt: row.created_at, updatedAt: row.updated_at });
+const map = (value: unknown): GameProfile => {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("Облако вернуло повреждённый профиль.");
+  const row = value as Partial<Row>;
+  const settings = row.settings && typeof row.settings === "object" && !Array.isArray(row.settings) ? row.settings : null;
+  if (typeof row.id !== "string" || typeof row.user_id !== "string" || typeof row.name !== "string"
+    || !["cs2", "dota2", "pubg", "valorant"].includes(String(row.game)) || !settings
+    || typeof row.created_at !== "string" || typeof row.updated_at !== "string") {
+    throw new Error("Облако вернуло профиль неизвестного формата. Данные не применялись.");
+  }
+  return { id: row.id, userId: row.user_id, name: row.name, game: row.game!, settings, createdAt: row.created_at, updatedAt: row.updated_at };
+};
 const cacheKey = (userId: string) => `game-passport.profile-cache.v1.${userId}`;
 
-function readCache(userId: string): GameProfile[] {
-  try { return JSON.parse(localStorage.getItem(cacheKey(userId)) ?? "[]") as GameProfile[]; }
+function cachedProfile(value: unknown, userId: string): GameProfile | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const profile = value as Partial<GameProfile>;
+  if (typeof profile.id !== "string" || profile.userId !== userId || typeof profile.name !== "string"
+    || !["cs2", "dota2", "pubg", "valorant"].includes(String(profile.game))
+    || !profile.settings || typeof profile.settings !== "object" || Array.isArray(profile.settings)
+    || typeof profile.createdAt !== "string" || typeof profile.updatedAt !== "string") return null;
+  return profile as GameProfile;
+}
+
+async function readCache(userId: string): Promise<GameProfile[]> {
+  try {
+    const value: unknown = JSON.parse(await secureStorage.getItem(cacheKey(userId)) ?? "[]");
+    return Array.isArray(value) ? value.map((item) => cachedProfile(item, userId)).filter((item): item is GameProfile => item !== null) : [];
+  }
   catch { return []; }
 }
 
-function writeCache(userId: string, profiles: GameProfile[]) {
-  localStorage.setItem(cacheKey(userId), JSON.stringify(profiles));
+async function writeCache(userId: string, profiles: GameProfile[]) {
+  try { await secureStorage.setItem(cacheKey(userId), JSON.stringify(profiles)); }
+  catch (error) { logger.warning("profile.cache", "Не удалось обновить защищённую автономную копию профилей.", error); }
+}
+
+function validateSettingsSize(settings: Record<string, unknown>) {
+  if (new TextEncoder().encode(JSON.stringify(settings)).length > 3_932_160) {
+    throw new Error("Настройки профиля превышают безопасный лимит 3,75 МБ и не были отправлены.");
+  }
 }
 
 export class SupabaseProfileRepository implements ProfileRepository {
@@ -21,33 +53,39 @@ export class SupabaseProfileRepository implements ProfileRepository {
