 });
diff --git a/src/test/PublicAccess.test.tsx b/src/test/PublicAccess.test.tsx
new file mode 100644
index 0000000..5057470
--- /dev/null
+++ b/src/test/PublicAccess.test.tsx
@@ -0,0 +1,79 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import accessPolicy from "../domain/accessPolicy.json";
+import { createServices } from "../infrastructure/createServices";
+import { SupabaseAuthProvider } from "../infrastructure/supabase/SupabaseAuthProvider";
+import { SupabaseProfileRepository } from "../infrastructure/supabase/SupabaseProfileRepository";
+import { PublicDeviceLicenseProvider } from "../infrastructure/local/PublicDeviceLicenseProvider";
+import { App } from "../App";
+
+const auth = vi.hoisted(() => ({
+  getUser: vi.fn(), getSession: vi.fn(), signInWithPassword: vi.fn(),
+  onAuthStateChange: vi.fn(() => ({ data: { subscription: { unsubscribe: vi.fn() } } })),
+}));
+vi.mock("../infrastructure/supabase/client", () => ({ createSupabaseClient: () => ({ auth }) }));
+vi.mock("../components/Dashboard", () => ({ Dashboard: () => <h1>Мои облачные профили</h1> }));
+const native = vi.hoisted(() => vi.fn());
+vi.mock("@tauri-apps/api/core", () => ({ invoke: native }));
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.stubEnv("VITE_DEMO_MODE", "false");
+  vi.stubEnv("VITE_FIELD_TEST_MODE", "false");
+  vi.stubEnv("VITE_SUPABASE_URL", "https://example.supabase.co");
+  vi.stubEnv("VITE_SUPABASE_ANON_KEY", "test-public-key");
+  vi.stubGlobal("fetch", vi.fn());
+  vi.spyOn(navigator, "onLine", "get").mockReturnValue(true);
+  auth.getUser.mockResolvedValue({ data: { user: null }, error: null });
+});
+afterEach(() => { cleanup(); vi.unstubAllEnvs(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+
+describe("public cloud access", () => {
+  it("uses real cloud providers without per-PC activation or legacy CI flags", async () => {
+    vi.stubEnv("VITE_CLUB_TEST_MODE", "false");
+    expect(accessPolicy.deviceActivationRequired).toBe(false);
+    const services = createServices();
+    expect(services.mode).toBe("cloud");
+    expect(services.auth).toBeInstanceOf(SupabaseAuthProvider);
+    expect(services.profiles).toBeInstanceOf(SupabaseProfileRepository);
+    expect(services.license).toBeInstanceOf(PublicDeviceLicenseProvider);
+    await expect(services.license.check()).resolves.toMatchObject({ state: "not_required", offlineGrace: false });
+    expect(fetch).not.toHaveBeenCalled();
+    expect(native).not.toHaveBeenCalled();
+  });
+
+  it("still requires account login on a new PC, then opens profiles without an activation screen", async () => {
+    auth.signInWithPassword.mockResolvedValue({ data: { user: { id: "u1", email: "player@example.com" } }, error: null });
+    render(<App />);
+    await screen.findByRole("heading", { name: "Войти в FastPlay" });
+    expect(screen.queryByText("Мои облачные профили")).not.toBeInTheDocument();
+    fireEvent.change(screen.getByLabelText("Email"), { target: { value: "player@example.com" } });
+    fireEvent.change(screen.getByLabelText("Пароль"), { target: { value: "test-password" } });
+    fireEvent.click(screen.getByRole("button", { name: "Войти" }));
+    await screen.findByRole("heading", { name: "Мои облачные профили" });
+    expect(auth.signInWithPassword).toHaveBeenCalledWith({ email: "player@example.com", password: "test-password" });
+    expect(screen.queryByText(/Game Passport не активирован/)).not.toBeInTheDocument();
+    expect(native).not.toHaveBeenCalled();
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it("restores an authenticated user without reading old revoked or expired device grants", async () => {
+    auth.getUser.mockResolvedValue({ data: { user: { id: "u1", email: "player@example.com" } }, error: null });
+    native.mockRejectedValue(new Error("old device grant revoked"));
+    render(<App />);
+    await screen.findByRole("heading", { name: "Мои облачные профили" });
+    expect(native).not.toHaveBeenCalled();
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it("does not turn invalid account credentials into a public sign-in", async () => {
+    auth.signInWithPassword.mockResolvedValue({ data: { user: null }, error: new Error("Invalid login credentials") });
+    render(<App />);
+    await screen.findByRole("heading", { name: "Войти в FastPlay" });
+    fireEvent.change(screen.getByLabelText("Email"), { target: { value: "player@example.com" } });
+    fireEvent.change(screen.getByLabelText("Пароль"), { target: { value: "incorrect-password" } });
+    fireEvent.click(screen.getByRole("button", { name: "Войти" }));
+    await screen.findByRole("alert");
+    expect(screen.queryByText("Мои облачные профили")).not.toBeInTheDocument();
+  });
+});
diff --git a/src/test/PublicBuildContract.test.ts b/src/test/PublicBuildContract.test.ts
new file mode 100644
index 0000000..435da82
--- /dev/null
+++ b/src/test/PublicBuildContract.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import cargo from "../../src-tauri/Cargo.toml?raw";
+import cargoLock from "../../src-tauri/Cargo.lock?raw";
+import native from "../../src-tauri/src/license.rs?raw";
+import workflow from "../../.github/workflows/windows-build.yml?raw";
+import { version } from "../../package.json";
+import tauriConfig from "../../src-tauri/tauri.conf.json";
+import accessPolicy from "../domain/accessPolicy.json";
+import { RELEASE_LABEL } from "../domain/release";
+
+describe("public installer build contract", () => {
+  it("keeps UI, Cargo and installer version in sync", () => {
+    const lock = cargoLock.replace(/\r\n/g, "\n");
+    expect(tauriConfig.version).toBe(version);
+    expect(cargo).toContain(`version = "${version}"`);
+    expect(lock).toContain(`name = "game-passport"\nversion = "${version}"`);
+    expect(RELEASE_LABEL).toBe(`${version} RC`);
+  });
+
+  it("embeds one public policy in native production code, with no test-only guard bypass", () => {
+    expect(accessPolicy.deviceActivationRequired).toBe(false);
+    expect(native).toContain('include_str!("../../src/domain/accessPolicy.json")');
+    expect(native).not.toMatch(/#\[cfg\(test\)\]\s*pub fn require_active/);
+    expect(native).not.toContain('option_env!("GAME_PASSPORT_CLUB_TEST_BUILD")');
+  });
+
+  it("validates public access and real cloud configuration before publishing the exact source", () => {
+    expect(workflow).toContain('VITE_DEMO_MODE: "false"');
+    expect(workflow).toContain('VITE_FIELD_TEST_MODE: "false"');
+    expect(workflow).toContain("$policy.deviceActivationRequired");
+    expect(workflow).toContain('src/domain/accessPolicy.json');
+    expect(workflow).toContain('--target "${{ github.sha }}"');
+  });
+});
