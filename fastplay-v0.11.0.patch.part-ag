diff --git a/src/test/DeviceLicenseProvider.test.ts b/src/test/DeviceLicenseProvider.test.ts
new file mode 100644
index 0000000..e66f842
--- /dev/null
+++ b/src/test/DeviceLicenseProvider.test.ts
@@ -0,0 +1,139 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { SupabaseDeviceLicenseProvider } from "../infrastructure/supabase/SupabaseDeviceLicenseProvider";
+
+const invoke = vi.fn();
+vi.mock("@tauri-apps/api/core", () => ({ invoke: (...args: unknown[]) => invoke(...args) }));
+
+const client = {
+  auth: { getSession: async () => ({ data: { session: { access_token: "user-jwt" } } }) },
+} as unknown as SupabaseClient;
+
+const cached = {
+  state: "offline_grace",
+  message: "cached",
+  offlineGrace: true,
+  expiresAt: "2026-08-22T00:00:00Z",
+};
+
+describe("device license provider", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    invoke.mockReset();
+    Object.defineProperty(window, "__TAURI_INTERNALS__", { value: {}, configurable: true });
+    vi.spyOn(navigator, "onLine", "get").mockReturnValue(true);
+  });
+
+  it("allows a registered device only after challenge proof and local grant verification", async () => {
+    const fetchMock = vi.fn()
+      .mockResolvedValueOnce(new Response(JSON.stringify({
+        code: "CHALLENGE_ISSUED",
+        challengeId: "11111111-1111-1111-1111-111111111111",
+        challenge: "c".repeat(43),
+        purpose: "verify",
+      }), { status: 200, headers: { "Content-Type": "application/json" } }))
+      .mockResolvedValueOnce(new Response(JSON.stringify({
+        code: "DEVICE_ACTIVE",
+        offlineGrant: "signed-server-grant",
+      }), { status: 200, headers: { "Content-Type": "application/json" } }));
+    vi.stubGlobal("fetch", fetchMock);
+    invoke
+      .mockResolvedValueOnce({
+        state: "success",
+        message: "ok",
+        publicKeyX: "x".repeat(43),
+        publicKeyY: "y".repeat(43),
+        publicKeySha256: "a".repeat(64),
+        fingerprintHash: "b".repeat(64),
+        keyProtection: "tpm",
+      })
+      .mockResolvedValueOnce({ state: "success", message: "signed", signature: "s".repeat(86) })
+      .mockResolvedValueOnce({ state: "active", message: "active", offlineGrace: false });
+
+    const result = await new SupabaseDeviceLicenseProvider(client, "https://example.supabase.co", "anon").check();
+    expect(result.state).toBe("active");
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    expect(invoke).toHaveBeenLastCalledWith("accept_device_license_grant", { token: "signed-server-grant" });
+  });
+
+  it("uses only a locally verified cached grant when the server is unavailable", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(
+      JSON.stringify({ code: "SERVER_UNAVAILABLE" }),
+      { status: 503, headers: { "Content-Type": "application/json" } },
+    )));
+    invoke
+      .mockResolvedValueOnce({
+        state: "success",
+        message: "ok",
+        publicKeyX: "x".repeat(43),
+        publicKeyY: "y".repeat(43),
+        publicKeySha256: "a".repeat(64),
+        fingerprintHash: "b".repeat(64),
+        keyProtection: "tpm",
+      })
+      .mockResolvedValueOnce(cached);
+
+    const result = await new SupabaseDeviceLicenseProvider(client, "https://example.supabase.co", "anon").check();
+    expect(result.state).toBe("offline_grace");
+    expect(invoke).toHaveBeenLastCalledWith("get_cached_device_license");
+  });
+
+  it("clears an offline grant and denies a revoked device", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(
+      JSON.stringify({ code: "DEVICE_REVOKED" }),
+      { status: 403, headers: { "Content-Type": "application/json" } },
+    )));
+    invoke
+      .mockResolvedValueOnce({
+        state: "success",
+        message: "ok",
+        publicKeyX: "x".repeat(43),
+        publicKeyY: "y".repeat(43),
+        publicKeySha256: "a".repeat(64),
+        fingerprintHash: "b".repeat(64),
+        keyProtection: "software",
+      })
+      .mockResolvedValueOnce(undefined);
+
+    const result = await new SupabaseDeviceLicenseProvider(client, "https://example.supabase.co", "anon").check();
+    expect(result.state).toBe("revoked");
+    expect(invoke).toHaveBeenLastCalledWith("clear_device_license");
+  });
+
+  it("clears any copied grant and denies an unknown device", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(
+      JSON.stringify({ code: "DEVICE_NOT_ACTIVATED" }),
+      { status: 403, headers: { "Content-Type": "application/json" } },
+    )));
+    invoke
+      .mockResolvedValueOnce({
+        state: "success",
+        message: "ok",
+        publicKeyX: "x".repeat(43),
+        publicKeyY: "y".repeat(43),
+        publicKeySha256: "a".repeat(64),
+        fingerprintHash: "b".repeat(64),
+        keyProtection: "software",
+      })
+      .mockResolvedValueOnce(undefined);
+
+    const result = await new SupabaseDeviceLicenseProvider(client, "https://example.supabase.co", "anon").check();
+    expect(result.state).toBe("not_activated");
+    expect(invoke).toHaveBeenLastCalledWith("clear_device_license");
+  });
+
+  it("fails closed when no valid cached grant exists offline", async () => {
+    vi.spyOn(navigator, "onLine", "get").mockReturnValue(false);
+    const fetchMock = vi.fn();
+    vi.stubGlobal("fetch", fetchMock);
+    invoke.mockResolvedValueOnce({
+      state: "expired",
+      message: "expired",
+      offlineGrace: false,
+    });
+    const result = await new SupabaseDeviceLicenseProvider(client, "https://example.supabase.co", "anon").check();
+    expect(result.state).toBe("expired");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+});
