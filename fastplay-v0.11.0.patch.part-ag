+import type { DeviceLicenseProvider, DeviceLicenseStatus } from "../../domain/license";
+
+/** Public distribution does not issue or pretend to verify a device license. */
+export class PublicDeviceLicenseProvider implements DeviceLicenseProvider {
+  async check(): Promise<DeviceLicenseStatus> {
+    return { state: "not_required", message: "Общедоступная версия: активация компьютера не требуется.", offlineGrace: false };
+  }
+  async activate(): Promise<DeviceLicenseStatus> { return this.check(); }
+  async clear(): Promise<void> {}
+}
diff --git a/src/infrastructure/supabase/SupabaseAuthProvider.ts b/src/infrastructure/supabase/SupabaseAuthProvider.ts
