diff --git a/src/services/secureStorage.ts b/src/services/secureStorage.ts
new file mode 100644
index 0000000..e7e7fe4
--- /dev/null
+++ b/src/services/secureStorage.ts
@@ -0,0 +1,33 @@
+import { invoke } from "@tauri-apps/api/core";
+import { isTauriDesktop } from "./platform";
+
+interface SecureStorageResponse {
+  state: "success" | "error" | "unsupported";
+  value?: string;
+  message: string;
+}
+
+export const secureStorage = {
+  async getItem(key: string): Promise<string | null> {
+    if (!isTauriDesktop()) return localStorage.getItem(key);
+    const response = await invoke<SecureStorageResponse>("secure_storage_get", { key });
+    if (response.state !== "success") throw new Error(response.message);
+    return response.value ?? null;
+  },
+  async setItem(key: string, value: string): Promise<void> {
+    if (!isTauriDesktop()) {
+      localStorage.setItem(key, value);
+      return;
+    }
+    const response = await invoke<SecureStorageResponse>("secure_storage_set", { key, value });
+    if (response.state !== "success") throw new Error(response.message);
+  },
+  async removeItem(key: string): Promise<void> {
+    if (!isTauriDesktop()) {
+      localStorage.removeItem(key);
+      return;
+    }
+    const response = await invoke<SecureStorageResponse>("secure_storage_remove", { key });
+    if (response.state !== "success") throw new Error(response.message);
+  },
+};
diff --git a/src/services/useOneTimeHelp.ts b/src/services/useOneTimeHelp.ts
new file mode 100644
index 0000000..f9bbe99
--- /dev/null
+++ b/src/services/useOneTimeHelp.ts
@@ -0,0 +1,27 @@
+import { useEffect, useState } from "react";
+
+type HelpTopic = "onboarding" | "steam-launch";
+const sessionSeen = new Set<string>();
+
+function wasShown(topic: HelpTopic, userId: string): boolean {
+  const key = `game-passport.help.seen.v1.${topic}.${userId}`;
+  try {
+    // Preserve acknowledgement from older releases; do not show the compact startup popup again.
+    return Boolean(localStorage.getItem(key) || (topic === "onboarding" && (
+      localStorage.getItem(`game-passport.onboarding.v1.${userId}`) ||
+      localStorage.getItem(`game-passport.startup-help.hidden.v1.${userId}`)
+    )));
+  } catch { return sessionSeen.has(key); }
+}
+
+/** Per account on this installation. Storage failure must not block the application. */
+export function useOneTimeHelp(topic: HelpTopic, userId: string) {
+  const [open, setOpen] = useState(() => !wasShown(topic, userId));
+  useEffect(() => {
+    if (!open) return;
+    const key = `game-passport.help.seen.v1.${topic}.${userId}`;
+    sessionSeen.add(key);
+    try { localStorage.setItem(key, "true"); } catch { /* Session-only fallback. */ }
+  }, [open, topic, userId]);
+  return [open, setOpen] as const;
+}
