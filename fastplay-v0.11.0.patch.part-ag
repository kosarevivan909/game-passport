+
+  it("stops at an emergency cancellation boundary and rolls back", async () => {
+    let cancel = false;
+    let secondApplied = false;
+    const first: SettingsAdapter = {
+      id: "display", label: "Display", status: "implemented", supports: () => true,
+      capture: async () => ({ adapterId: "display", label: "Display", state: "success", message: "captured" }),
+      apply: async () => { cancel = true; return { adapterId: "display", label: "Display", state: "success", message: "applied", backupToken: "display-backup" }; },
+      rollback: async () => ({ adapterId: "display.rollback", label: "Display rollback", state: "success", message: "restored" }),
+    };
+    const second: SettingsAdapter = {
+      id: "mouse", label: "Mouse", status: "implemented", supports: () => true,
+      capture: async () => ({ adapterId: "mouse", label: "Mouse", state: "success", message: "captured" }),
+      apply: async () => { secondApplied = true; return { adapterId: "mouse", label: "Mouse", state: "success", message: "applied" }; },
+    };
+    const results = await new ProfileOrchestrator([first, second]).apply(profile, undefined, { shouldCancel: () => cancel });
+    expect(secondApplied).toBe(false);
+    expect(results.map((result) => result.adapterId)).toEqual(["display", "apply.cancelled", "display.rollback"]);
+  });
+
+  it("restores each adapter only from its exact local backup token", async () => {
+    const restored: Array<string | undefined> = [];
+    const preflight: SettingsAdapter = {
+      id: "cs2.preflight", label: "CS2 preflight", status: "implemented", supports: () => true,
+      capture: async () => ({ adapterId: "cs2.preflight", label: "CS2 preflight", state: "unsupported", message: "not used" }),
+      apply: async () => ({ adapterId: "cs2.preflight", label: "CS2 preflight", state: "success", message: "safe" }),
+    };
+    const display: SettingsAdapter = {
+      id: "display", label: "Display", status: "implemented", supports: () => true,
+      capture: async () => ({ adapterId: "display", label: "Display", state: "success", message: "captured" }),
+      apply: async () => ({ adapterId: "display", label: "Display", state: "success", message: "applied" }),
+      restore: async (token) => {
+        restored.push(token);
+        return { adapterId: "display", label: "Display", state: "success", message: "restored" };
+      },
+    };
+    const results = await new ProfileOrchestrator([preflight, display]).restore(
+      profile,
+      undefined,
+      { display: "display-backup-42" },
+    );
+    expect(restored).toEqual(["display-backup-42"]);
+    expect(results.map((result) => result.adapterId)).toEqual(["cs2.preflight", "display"]);
+  });
 });
diff --git a/src/test/ProfileSettingsTransaction.test.ts b/src/test/ProfileSettingsTransaction.test.ts
new file mode 100644
index 0000000..9d9604a
--- /dev/null
+++ b/src/test/ProfileSettingsTransaction.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { clearIncompatibleSettings, replaceCapturedSettings } from "../domain/profileSettings";
+import type { AdapterResult } from "../domain/types";
+
+describe("profile capture transactions", () => {
+  it("replaces old adapter payloads instead of mixing snapshots", () => {
+    const old = { adapters: { "game.cs2": { capturedAt: "old" }, nvidia: { capturedAt: "old" }, mouse: { dpi: 800 } } };
+    const results: AdapterResult[] = [
+      { adapterId: "game.cs2", label: "CS2", state: "success", message: "ok", settingsPatch: { adapters: { "game.cs2": { capturedAt: "new" } } } },
+      { adapterId: "nvidia", label: "NVIDIA", state: "unsupported", message: "not available" },
+    ];
+    const next = replaceCapturedSettings(old, "cs2", results);
+    expect(next.adapters).toEqual({ "game.cs2": { capturedAt: "new" } });
+  });
+
+  it("refuses a snapshot without the selected game's core payload", () => {
+    const results: AdapterResult[] = [
+      { adapterId: "display", label: "Display", state: "success", message: "ok", settingsPatch: { adapters: { display: { width: 1920 } } } },
+    ];
+    expect(() => replaceCapturedSettings({}, "cs2", results)).toThrow(/CS2/);
+  });
+
+  it("clears every incompatible adapter when changing game", () => {
+    expect(clearIncompatibleSettings({ adapters: { "game.cs2": {}, pubg: {}, display: {}, nvidia: {}, mouse: {} } })).toEqual({ adapters: {} });
+  });
+});
