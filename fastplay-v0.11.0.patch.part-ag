 });
diff --git a/src/test/IndependentDisplay.test.tsx b/src/test/IndependentDisplay.test.tsx
new file mode 100644
index 0000000..b3b2f17
--- /dev/null
+++ b/src/test/IndependentDisplay.test.tsx
@@ -0,0 +1,101 @@
+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { invoke } from "@tauri-apps/api/core";
+import { DisplayAdapter } from "../adapters/DisplayAdapter";
+import { NvidiaAdapter } from "../adapters/NvidiaAdapter";
+import { NvidiaDisplayControlsAdapter } from "../adapters/NvidiaDisplayControlsAdapter";
+import { Cs2Adapter } from "../adapters/Cs2Adapter";
+import { ProfileCard } from "../components/ProfileCard";
+import { getCs2Payload, mergeSettingsPatch, type Cs2Payload } from "../domain/cs2";
+import { getDisplayPayload, type DisplayPayload } from "../domain/display";
+import type { NvidiaPayload } from "../domain/nvidia";
+import type { GameProfile } from "../domain/types";
+import { ProfileOrchestrator } from "../services/profileOrchestrator";
+
+vi.mock("@tauri-apps/api/core", () => ({ invoke: vi.fn() }));
+vi.mock("../services/platform", () => ({ isTauriDesktop: () => true }));
+afterEach(() => { cleanup(); vi.mocked(invoke).mockReset(); });
+
+const desktop: DisplayPayload = { schemaVersion: 2, captureSource: "windows_desktop", capturedAt: "now", width: 1920, height: 1080, aspectRatio: "16:9", displayMode: "unknown", scalingPreference: "driver_managed", refreshRatePolicy: "MAX_AVAILABLE" };
+const nvidia: NvidiaPayload = { schemaVersion: 2, capturedAt: "now", profileExecutable: "cs2.exe", settings: [], scalingMode: "aspect_ratio", scalingValue: 3, scalingSupported: true };
+const cs2: Cs2Payload = { schemaVersion: 2, capturedAt: "now", files: [
+  { scope: "userdata", relativePath: "cs2_video.txt", contentBase64: btoa('"setting.defaultres" "1280"\n"setting.defaultresheight" "960"\n"setting.fullscreen" "1"\n'), sha256: "fixture", size: 100 },
+  { scope: "userdata", relativePath: "cs2_user_convars_0_slot0.vcfg", contentBase64: btoa('"volume" "0.35"\n"snd_voipvolume" "0.6"\n'), sha256: "fixture", size: 50 }
+], totalBytes: 150, coreFilesFound: [], optionalFilesMissing: [] };
+const profile: GameProfile = { id: "p", userId: "u", name: "Independent", game: "cs2", settings: { adapters: { "game.cs2": cs2, display: desktop, nvidia } }, createdAt: "now", updatedAt: "now" };
+const ok = (payload?: unknown) => ({ state: "success", message: "ok", details: [], retryable: false, ...(payload !== undefined ? { payload } : {}) });
+
+describe("Independent game, desktop and NVIDIA snapshots", () => {
+  it("captures the desktop without sending any game resolution to native code", async () => {
+    vi.mocked(invoke).mockResolvedValue(ok(desktop));
+    const result = await new ProfileOrchestrator([new DisplayAdapter()]).capture(profile);
+    expect(invoke).toHaveBeenCalledWith("capture_display_settings");
+    expect(getDisplayPayload(result[0].settingsPatch!)).toEqual(desktop);
+  });
+
+  it("does not need a game video file to capture the real desktop", async () => {
+    vi.mocked(invoke).mockResolvedValue(ok(desktop));
+    const [result] = await new ProfileOrchestrator([new DisplayAdapter()]).capture({ ...profile, settings: {} });
+    expect(result.state).toBe("success");
+    expect(invoke).toHaveBeenCalledWith("capture_display_settings");
+  });
+
+  it("never substitutes game dimensions if desktop detection fails", async () => {
+    vi.mocked(invoke).mockResolvedValue({ ...ok(), state: "error", message: "Desktop unavailable" });
+    const result = await new DisplayAdapter().capture();
+    expect(result.state).toBe("error");
+    expect(result.settingsPatch).toBeUndefined();
+    expect(invoke).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps NVIDIA scaling only in its own adapter snapshot", async () => {
+    vi.mocked(invoke).mockResolvedValue(ok(nvidia));
+    const result = await new NvidiaAdapter().capture(profile);
+    expect(result.settingsPatch).toEqual({ adapters: { nvidia } });
+    expect(getDisplayPayload(mergeSettingsPatch(profile.settings, result.settingsPatch!))).toEqual(desktop);
+  });
+
+  it("round-trips a cloud-shaped profile and applies each adapter's own dimensions and sound", async () => {
+    vi.mocked(invoke).mockImplementation(async (command) => ok(command === "capture_cs2_settings" ? cs2 : command === "capture_display_settings" ? desktop : nvidia));
+    const orchestrator = new ProfileOrchestrator([new Cs2Adapter(), new DisplayAdapter(), new NvidiaAdapter()]);
+    const results = await orchestrator.capture({ ...profile, settings: {} });
+    const settings = results.reduce((settings, result) => mergeSettingsPatch(settings, result.settingsPatch!), {});
+    const restored = JSON.parse(JSON.stringify({ ...profile, settings })) as GameProfile;
+    expect(getDisplayPayload(restored.settings)).toEqual(desktop);
+    expect(getCs2Payload(restored.settings)).toEqual(cs2);
+    vi.mocked(invoke).mockClear().mockResolvedValue(ok());
+    await new ProfileOrchestrator([new DisplayAdapter(), new NvidiaAdapter(), new NvidiaDisplayControlsAdapter(), new Cs2Adapter()]).apply(restored);
+    expect(invoke).toHaveBeenNthCalledWith(1, "apply_display_settings", { payload: desktop });
+    expect(invoke).toHaveBeenNthCalledWith(2, "apply_nvidia_settings", { payload: nvidia });
+    expect(invoke).toHaveBeenNthCalledWith(3, "apply_nvidia_display_controls", { payload: nvidia });
+    expect(invoke).toHaveBeenNthCalledWith(4, "apply_cs2_settings", { payload: cs2 });
+    expect(atob(getCs2Payload(restored.settings)!.files[1].contentBase64)).toContain('"snd_voipvolume" "0.6"');
+  });
+
+  it.each([
+    { ...desktop, schemaVersion: 1, captureSource: undefined, width: 1280, height: 960 },
+    { ...desktop, captureSource: undefined },
+  ])("refuses legacy/unproven display values without touching Windows", async (display) => {
+    const result = await new DisplayAdapter().apply({ ...profile, settings: { adapters: { display, "game.cs2": cs2 } } });
+    expect(result.state).toBe("warning");
+    expect(result.message).toContain("на исходном ПК");
+    expect(invoke).not.toHaveBeenCalled();
+  });
+
+  it("does not reuse a previous rollback token after skipping a legacy snapshot", async () => {
+    const adapter = new DisplayAdapter();
+    vi.mocked(invoke).mockResolvedValue({ ...ok(), backupToken: "old-backup" });
+    await adapter.apply(profile);
+    vi.mocked(invoke).mockClear();
+    await adapter.apply({ ...profile, settings: { adapters: { display: { ...desktop, schemaVersion: 1 } } } });
+    expect((await adapter.rollback()).state).toBe("unsupported");
+    expect(invoke).not.toHaveBeenCalled();
+  });
+
+  it("labels game and desktop dimensions separately on the profile card", () => {
+    const noop = () => undefined;
+    render(<ProfileCard profile={profile} onApply={noop} onCapture={noop} onRestore={noop} onEdit={noop} onDelete={noop} />);
+    expect(screen.getByText("CS2: 1280×960")).toBeInTheDocument();
+    expect(screen.getByText("Экран: 1920×1080")).toBeInTheDocument();
+  });
+});
diff --git a/src/test/Onboarding.test.tsx b/src/test/Onboarding.test.tsx
new file mode 100644
index 0000000..ed53245
--- /dev/null
+++ b/src/test/Onboarding.test.tsx
@@ -0,0 +1,68 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Onboarding } from "../components/Onboarding";
+import { useOneTimeHelp } from "../services/useOneTimeHelp";
+import { StrictMode } from "react";
+
+afterEach(() => { cleanup(); localStorage.clear(); vi.restoreAllMocks(); });
+
+function HelpHost({ userId = "u" }: { userId?: string }) {
+  const [open, setOpen] = useOneTimeHelp("onboarding", userId);
+  return <><button onClick={() => setOpen(true)}>Как пользоваться</button>{open && <Onboarding onComplete={() => setOpen(false)} />}</>;
+}
+
+describe("Onboarding", () => {
+  it("shows all four required first-use steps", () => {
+    render(<Onboarding onComplete={() => undefined} />);
+    expect(screen.getByRole("heading", { name: "Настрой компьютер один раз" })).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: /Далее/ }));
+    expect(screen.getByRole("heading", { name: "Сохраните свой профиль" })).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: /Далее/ }));
+    expect(screen.getByRole("heading", { name: "На другом компьютере" })).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: /Далее/ }));
+    expect(screen.getByRole("heading", { name: "Важно" })).toBeInTheDocument();
+  });
+
+  it("can be dismissed immediately", () => {
+    const complete = vi.fn();
+    render(<Onboarding onComplete={complete} />);
+    fireEvent.click(screen.getByRole("button", { name: "Закрыть инструкцию" }));
+    expect(complete).toHaveBeenCalledOnce();
+  });
+
+  it("appears once, survives a restart, and can be reopened by its button", () => {
+    const first = render(<StrictMode><HelpHost /></StrictMode>);
+    expect(screen.getByRole("dialog")).toBeInTheDocument();
+    first.unmount(); // Even closing the app halfway through must not auto-open it next time.
+    render(<HelpHost />);
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "Как пользоваться" }));
+    expect(screen.getByRole("dialog")).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "Закрыть инструкцию" }));
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+  });
+
+  it.each(["game-passport.onboarding.v1.u", "game-passport.startup-help.hidden.v1.u"])("respects existing acknowledgement %s without another popup", (key) => {
+    localStorage.setItem(key, "true");
+    render(<HelpHost />);
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "Как пользоваться" })).toBeInTheDocument();
+  });
+
+  it("keeps first-use help independent for another account", () => {
+    const first = render(<HelpHost />);
+    first.unmount();
+    render(<HelpHost userId="another-account" />);
+    expect(screen.getByRole("dialog")).toBeInTheDocument();
+  });
+
+  it("does not crash with unavailable local storage and remembers for this session", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => { throw new Error("blocked"); });
+    const first = render(<HelpHost userId="storage-blocked" />);
+    expect(screen.getByRole("dialog")).toBeInTheDocument();
+    first.unmount();
+    render(<HelpHost userId="storage-blocked" />);
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+  });
+});
