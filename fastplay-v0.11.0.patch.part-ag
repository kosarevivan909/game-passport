diff --git a/src/services/applyLock.ts b/src/services/applyLock.ts
new file mode 100644
index 0000000..2589c40
--- /dev/null
+++ b/src/services/applyLock.ts
@@ -0,0 +1,33 @@
+import { invoke } from "@tauri-apps/api/core";
+import type { ApplyLockRequest, ApplyLockStatus } from "../domain/applyLock";
+import { isTauriDesktop } from "./platform";
+
+const browserStatus = (message: string): ApplyLockStatus => ({
+  state: "success",
+  message,
+  active: false,
+  cancelled: false,
+});
+
+export const applyLock = {
+  async begin(request: ApplyLockRequest) {
+    if (!isTauriDesktop()) return browserStatus("Apply Lock недоступен вне Windows-приложения.");
+    return invoke<ApplyLockStatus>("begin_apply_lock", { request });
+  },
+  async heartbeat() {
+    if (!isTauriDesktop()) return browserStatus("Apply Lock не активен.");
+    return invoke<ApplyLockStatus>("heartbeat_apply_lock");
+  },
+  async finish() {
+    if (!isTauriDesktop()) return browserStatus("Apply Lock не активен.");
+    return invoke<ApplyLockStatus>("finish_apply_lock");
+  },
+  async status() {
+    if (!isTauriDesktop()) return browserStatus("Apply Lock не активен.");
+    return invoke<ApplyLockStatus>("get_apply_lock_status");
+  },
+  async clearInterrupted() {
+    if (!isTauriDesktop()) return browserStatus("Прерванных операций нет.");
+    return invoke<ApplyLockStatus>("clear_interrupted_apply");
+  },
+};
diff --git a/src/services/backupManifests.ts b/src/services/backupManifests.ts
new file mode 100644
index 0000000..8c9d077
--- /dev/null
+++ b/src/services/backupManifests.ts
@@ -0,0 +1,41 @@
+import type { AdapterResult, GameProfile } from "../domain/types";
+
+const KEY = "game-passport.backup-manifests.v2";
+
+interface BackupManifest {
+  profileId: string;
+  game: GameProfile["game"];
+  createdAt: string;
+  tokens: Record<string, string>;
+}
+
+function read(): Record<string, BackupManifest> {
+  try {
+    const parsed: unknown = JSON.parse(localStorage.getItem(KEY) ?? "{}");
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed as Record<string, BackupManifest> : {};
+  } catch { return {}; }
+}
+
+function write(value: Record<string, BackupManifest>) {
+  localStorage.setItem(KEY, JSON.stringify(value));
+}
+
+export const backupManifests = {
+  begin(profile: GameProfile) {
+    const all = read();
+    all[profile.id] = { profileId: profile.id, game: profile.game, createdAt: new Date().toISOString(), tokens: {} };
+    write(all);
+  },
+  record(profile: GameProfile, result: AdapterResult) {
+    if (!result.backupToken) return;
+    const all = read();
+    const current = all[profile.id];
+    if (!current || current.game !== profile.game) return;
+    current.tokens[result.adapterId] = result.backupToken;
+    write(all);
+  },
+  tokens(profile: GameProfile) {
+    const manifest = read()[profile.id];
+    return manifest?.game === profile.game ? { ...manifest.tokens } : {};
+  },
+};
diff --git a/src/services/fieldValidation.ts b/src/services/fieldValidation.ts
index 8898d60..c872773 100644
