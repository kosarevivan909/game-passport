diff --git a/src/components/Onboarding.tsx b/src/components/Onboarding.tsx
new file mode 100644
index 0000000..88c64a7
--- /dev/null
+++ b/src/components/Onboarding.tsx
@@ -0,0 +1,19 @@
+import { Check, ChevronRight, Gamepad2, MonitorUp, Save, ShieldAlert, X } from "lucide-react";
+import { useState } from "react";
+
+interface Props { onComplete: () => void }
+
+const steps = [
+  { icon: Gamepad2, title: "Настрой компьютер один раз", text: "Запустите игру и выставьте настройки так, как вам удобно." },
+  { icon: Save, title: "Сохраните свой профиль", text: "Вернитесь в FastPlay и нажмите «Сохранить текущие настройки». Поддерживаемые игровые и системные параметры сохранятся в профиле." },
+  { icon: MonitorUp, title: "На другом компьютере", text: "Войдите в аккаунт, выберите профиль и нажмите «Настроить этот ПК». FastPlay применит сохранённые настройки." },
+  { icon: ShieldAlert, title: "Важно", text: "Перед сохранением и применением закройте CS2 или PUBG, если приложение попросит. Не прерывайте применение." },
+];
+
+export function Onboarding({ onComplete }: Props) {
+  const [step, setStep] = useState(0);
+
+  const current = steps[step];
+  const Icon = current.icon;
+  return <div className="onboarding-backdrop"><section className="onboarding-card" role="dialog" aria-modal="true" aria-labelledby="onboarding-title"><button className="onboarding-close" aria-label="Закрыть инструкцию" onClick={onComplete}><X size={18} /></button><div className="onboarding-progress">{steps.map((_, index) => <i className={index <= step ? "active" : ""} key={index} />)}</div><div className="onboarding-icon"><Icon size={34} /></div><p className="eyebrow">ШАГ {step + 1} ИЗ {steps.length}</p><h2 id="onboarding-title">{current.title}</h2><p>{current.text}</p><button className="button primary wide" onClick={() => step < steps.length - 1 ? setStep(step + 1) : onComplete()}>{step < steps.length - 1 ? <>Далее <ChevronRight size={18} /></> : <><Check size={18} /> Начать</>}</button></section></div>;
+}
