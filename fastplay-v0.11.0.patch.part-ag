+
   it("returns software evidence without converting unsupported to success", async () => {
     const onComplete = vi.fn();
     render(<OperationScreen profile={profile} operation="apply" orchestrator={new ProfileOrchestrator([new UnsupportedAdapter("game.cs2", "CS2 Settings", "cs2")])} onComplete={onComplete} onClose={() => undefined} />);
@@ -23,4 +50,33 @@ describe("OperationScreen", () => {
     expect(onComplete.mock.calls[0][0][0].state).toBe("unsupported");
     expect(screen.getByRole("heading", { name: "НАСТРОЙКИ НЕ ПРИМЕНЕНЫ" })).toBeInTheDocument();
   });
+
+  it("always releases Apply Lock after an apply failure", async () => {
+    const begin = vi.spyOn(applyLock, "begin").mockResolvedValue({ state: "success", message: "locked", active: true, cancelled: false });
+    const finish = vi.spyOn(applyLock, "finish").mockResolvedValue({ state: "success", message: "released", active: false, cancelled: false });
+    vi.spyOn(applyLock, "heartbeat").mockResolvedValue({ state: "success", message: "active", active: true, cancelled: false });
+    const failed = new UnsupportedAdapter("game.cs2", "CS2 Settings", "cs2");
+    failed.apply = async () => ({ adapterId: failed.id, label: failed.label, state: "error", message: "failed" });
+    render(<OperationScreen profile={profile} operation="apply" orchestrator={new ProfileOrchestrator([failed])} onClose={() => undefined} />);
+    await waitFor(() => expect(finish).toHaveBeenCalledOnce());
+    expect(begin).toHaveBeenCalledOnce();
+    expect(screen.getByRole("heading", { name: "НАСТРОЙКИ НЕ ПРИМЕНЕНЫ" })).toBeInTheDocument();
+    begin.mockRestore(); finish.mockRestore();
