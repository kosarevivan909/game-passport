+    render(<AuthScreen auth={auth} mode="cloud" onAuthenticated={() => undefined} />);
+    fireEvent.change(screen.getByLabelText("Email"), { target: { value: "player@example.com" } });
+    fireEvent.change(screen.getByLabelText("Пароль"), { target: { value: "secret12" } });
+    fireEvent.click(screen.getByRole("button", { name: "Войти" }));
+    await screen.findByRole("heading", { name: "Подтвердите электронную почту" });
+    fireEvent.click(screen.getByRole("button", { name: "Отправить письмо повторно" }));
+    await waitFor(() => expect(resent).toBe("player@example.com"));
+    expect(screen.getByRole("status")).toHaveTextContent(/Новое письмо отправлено/i);
+  });
+
+  it("offers password recovery without disclosing account existence", async () => {
+    let requested = "";
+    const auth: AuthProvider = {
