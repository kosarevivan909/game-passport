+    render(<OperationScreen profile={profile} operation="apply" orchestrator={new ProfileOrchestrator([new UnsupportedAdapter("game.cs2", "CS2 Settings", "cs2")])} onClose={() => undefined} />);
+    await waitFor(() => expect(finish).toHaveBeenCalledOnce());
+    expect(screen.getByRole("heading", { name: "НАСТРОЙКИ НЕ ПРИМЕНЕНЫ" })).toBeInTheDocument();
