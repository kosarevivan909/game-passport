diff --git a/src/domain/valorant.ts b/src/domain/valorant.ts
new file mode 100644
index 0000000..3b845d8
--- /dev/null
+++ b/src/domain/valorant.ts
@@ -0,0 +1,49 @@
+export type ValorantCategory = "gameplay" | "keybinds" | "graphics" | "audio" | "crosshair";
+
+export interface ValorantIniEntry {
+  section: string;
+  key: string;
+  operator: string;
+  value: string;
+  categories: ValorantCategory[];
+}
+
+export type ValorantFileId = "WindowsClient/GameUserSettings.ini" | "Windows/RiotUserSettings.ini";
+export interface ValorantConfigFile { relativeId: ValorantFileId; entries: ValorantIniEntry[]; sha256: string }
+export interface ValorantCategorySummary { gameplay: number; keybinds: number; graphics: number; audio: number; crosshair: number }
+export interface ValorantNormalizedSettings { width?: number; height?: number; displayMode: "fullscreen" | "borderless" | "windowed" | "unknown" }
+export interface ValorantPayload {
+  schemaVersion: 1;
+  capturedAt: string;
+  game: "valorant";
+  files: ValorantConfigFile[];
+  normalized: ValorantNormalizedSettings;
+  capturedCategories: ValorantCategorySummary;
+  unsupportedCategories: string[];
+  warnings: string[];
+}
+export interface ValorantDiagnostics {
+  valorantDetected: boolean;
+  configDirectory?: string;
+  configFilesFound: string[];
+  candidateProfiles: number;
+  processRunning: boolean;
+  captureResult?: string;
+  applyResult?: string;
+  backupResult?: string;
+  restoreResult?: string;
+  categories: ValorantCategorySummary;
+  unsupportedSettings: string[];
+  parseErrors: string[];
+  writeErrors: string[];
+}
+export interface ValorantCommandResponse { state: "success" | "warning" | "unsupported" | "error"; message: string; details: string[]; retryable: boolean; payload?: ValorantPayload; diagnostics?: ValorantDiagnostics; backupToken?: string }
+
+export function getValorantPayload(settings: Record<string, unknown>): ValorantPayload | null {
+  const adapters = settings.adapters;
+  if (!adapters || typeof adapters !== "object" || Array.isArray(adapters)) return null;
+  const value = (adapters as Record<string, unknown>).valorant;
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const payload = value as Partial<ValorantPayload>;
+  return payload.schemaVersion === 1 && payload.game === "valorant" && Array.isArray(payload.files) ? payload as ValorantPayload : null;
+}
