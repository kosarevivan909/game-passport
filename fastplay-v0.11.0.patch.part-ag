+    if (input.expectedUpdatedAt && items[index].updatedAt !== input.expectedUpdatedAt) throw new Error("Профиль изменился на другом компьютере. Обновите список и повторите сохранение.");
+    const { expectedUpdatedAt: _expectedUpdatedAt, ...changes } = input;
+    const updated = { ...items[index], ...changes, name: input.name?.trim() ?? items[index].name, updatedAt: new Date().toISOString() };
     items[index] = updated; this.write(items); return updated;
   }
   async remove(userId: string, id: string) { this.write(this.read().filter((item) => !(item.id === id && item.userId === userId))); }
