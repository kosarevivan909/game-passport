+          {RELEASE_GAMES.map((id) => <button className={`game-choice ${game === id ? "selected" : ""}`} type="button" key={id} disabled={Boolean(profile && profile.game !== id)} onClick={() => setGame(id)} style={{ "--game-accent": GAME_META[id].accent } as React.CSSProperties}>
