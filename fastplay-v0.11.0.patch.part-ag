diff --git a/src/test/SteamSession.test.tsx b/src/test/SteamSession.test.tsx
new file mode 100644
index 0000000..5965c7f
--- /dev/null
+++ b/src/test/SteamSession.test.tsx
@@ -0,0 +1,92 @@
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { SteamLaunchOptionsHelp } from "../components/SteamLaunchOptionsHelp";
+import { OperationScreen } from "../components/OperationScreen";
+import { Cs2Adapter } from "../adapters/Cs2Adapter";
+import { ProfileOrchestrator } from "../services/profileOrchestrator";
+import { applyLock } from "../services/applyLock";
+import type { GameProfile } from "../domain/types";
+import native from "../../src-tauri/src/cs2.rs?raw";
+import profileModal from "../components/ProfileModal.tsx?raw";
+
+vi.mock("@tauri-apps/api/core", () => ({ invoke: vi.fn() }));
+vi.mock("../services/platform", () => ({ isTauriDesktop: () => true }));
+import { invoke } from "@tauri-apps/api/core";
+
+const profile: GameProfile = { id: "p", userId: "u", name: "CS2", game: "cs2", settings: { adapters: { "game.cs2": { schemaVersion: 2, files: [] } } }, createdAt: "now", updatedAt: "now" };
+
+afterEach(() => { cleanup(); localStorage.clear(); vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.mocked(invoke).mockReset(); });
+
+describe("Steam stays open", () => {
+  it("has no Steam shutdown, restart or full localconfig restore path", () => {
+    const production = native.split("#[cfg(test)]")[0];
+    expect(production).not.toContain('"-shutdown"');
+    expect(production).not.toContain("Command::");
+    expect(production).not.toContain("stop_steam_for_apply");
+    expect(production).not.toContain("restart_steam");
+    expect(production).not.toContain("ensure_steam_closed");
+    expect(production).toContain('for scope in ["userdata", "install"]');
+    expect(profileModal).not.toContain("перезапустит Steam");
+  });
+
+  it("preserves the native warning and explicit empty launch options", async () => {
+    vi.mocked(invoke).mockResolvedValue({ state: "warning", message: "Steam remains open", details: [], retryable: false, manualLaunchOptions: "" });
+    const result = await new Cs2Adapter().apply(profile);
+    expect(result.state).toBe("warning");
+    expect(result.manualLaunchOptions).toBe("");
+    expect(invoke).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledWith("apply_cs2_settings", expect.any(Object));
+  });
+
+  it("copies launch options without claiming that copying applied them", async () => {
+    const writeText = vi.fn().mockResolvedValue(undefined);
+    vi.stubGlobal("navigator", { clipboard: { writeText } });
+    render(<SteamLaunchOptionsHelp userId="u" value="-fullscreen -console" />);
+    fireEvent.click(screen.getByRole("button", { name: "Скопировать параметры" }));
+    await waitFor(() => expect(writeText).toHaveBeenCalledWith("-fullscreen -console"));
+    expect(await screen.findByText(/копирование само по себе настройки не применяет/)).toBeInTheDocument();
+  });
+
+  it("gives a manual fallback if clipboard access fails", async () => {
+    vi.stubGlobal("navigator", { clipboard: { writeText: vi.fn().mockRejectedValue(new Error("denied")) } });
+    render(<SteamLaunchOptionsHelp userId="u" value="-console" />);
+    fireEvent.click(screen.getByRole("button", { name: "Скопировать параметры" }));
+    expect(await screen.findByText(/Не удалось скопировать/)).toBeInTheDocument();
+    expect(screen.getByRole("textbox")).toHaveValue("-console");
+  });
+
+  it("tells the user to clear Steam options when the saved value is empty", () => {
+    render(<SteamLaunchOptionsHelp userId="u" value="" />);
+    expect(screen.getByText(/Очистите это поле/)).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Скопировать параметры" })).not.toBeInTheDocument();
+  });
+
+  it("auto-expands only once while keeping unapplied status and the latest saved value accessible", () => {
+    const first = render(<SteamLaunchOptionsHelp userId="u" value="-console" />);
+    expect(screen.getByRole("textbox")).toHaveValue("-console");
+    first.unmount();
+    render(<SteamLaunchOptionsHelp userId="u" value="-fullscreen -w 1280 -h 960" />);
+    expect(screen.queryByRole("textbox")).not.toBeInTheDocument();
+    expect(screen.getByText(/не применены автоматически/)).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "Как пользоваться" }));
+    expect(screen.getByRole("textbox")).toHaveValue("-fullscreen -w 1280 -h 960");
+    fireEvent.click(screen.getByRole("button", { name: "Скрыть инструкцию" }));
+    expect(screen.queryByRole("textbox")).not.toBeInTheDocument();
+    expect(screen.getByText(/не применены автоматически/)).toBeInTheDocument();
+  });
+
+  it("shows manual launch options after releasing Apply Lock, without a success summary", async () => {
+    vi.mocked(invoke).mockResolvedValue({ state: "warning", message: "Steam remains open", details: [], retryable: false, manualLaunchOptions: "-fullscreen" });
+    vi.spyOn(applyLock, "begin").mockResolvedValue({ state: "success", message: "locked", active: true, cancelled: false });
+    vi.spyOn(applyLock, "heartbeat").mockResolvedValue({ state: "success", message: "active", active: true, cancelled: false });
+    let release: (value: Awaited<ReturnType<typeof applyLock.finish>>) => void = () => undefined;
+    const finish = vi.spyOn(applyLock, "finish").mockReturnValue(new Promise((resolve) => { release = resolve; }));
+    render(<OperationScreen profile={profile} operation="apply" orchestrator={new ProfileOrchestrator([new Cs2Adapter()])} onClose={() => undefined} />);
+    await waitFor(() => expect(finish).toHaveBeenCalledOnce());
+    expect(screen.queryByRole("button", { name: "Скопировать параметры" })).not.toBeInTheDocument();
+    release({ state: "success", message: "released", active: false, cancelled: false });
+    expect(await screen.findByRole("button", { name: "Скопировать параметры" })).toBeEnabled();
+    expect(screen.getByRole("heading", { name: "ГОТОВО С ПРЕДУПРЕЖДЕНИЯМИ" })).toBeInTheDocument();
+    expect(screen.queryByRole("heading", { name: "КОМПЬЮТЕР ГОТОВ" })).not.toBeInTheDocument();
+  });
+});
