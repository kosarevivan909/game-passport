diff --git a/src/domain/profileSettings.ts b/src/domain/profileSettings.ts
new file mode 100644
index 0000000..46f3695
--- /dev/null
+++ b/src/domain/profileSettings.ts
@@ -0,0 +1,33 @@
+import type { AdapterResult, GameId, ProfileSettings } from "./types";
+
+const CAPTURED_ADAPTERS = ["game.cs2", "pubg", "valorant", "display", "nvidia", "mouse"] as const;
+
+/**
+ * Builds one complete capture snapshot. Old adapter payloads are removed first,
+ * so a failed/unsupported capture can never leave stale settings behind.
+ */
+export function replaceCapturedSettings(current: ProfileSettings, game: GameId, results: AdapterResult[]): ProfileSettings {
+  const currentAdapters = isRecord(current.adapters) ? current.adapters : {};
+  const adapters: Record<string, unknown> = { ...currentAdapters };
+  for (const key of CAPTURED_ADAPTERS) delete adapters[key];
+  for (const result of results) {
+    const patchAdapters = isRecord(result.settingsPatch?.adapters) ? result.settingsPatch.adapters : {};
+    for (const [key, value] of Object.entries(patchAdapters)) adapters[key] = value;
+  }
+  const expectedGameAdapter = game === "cs2" ? "game.cs2" : game === "pubg" ? "pubg" : game === "valorant" ? "valorant" : undefined;
+  if (expectedGameAdapter && !(expectedGameAdapter in adapters)) {
+    throw new Error(`Основные настройки ${game.toUpperCase()} не были считаны. Старый профиль оставлен без изменений.`);
+  }
+  return { ...current, adapters, capture: { schemaVersion: 1, game, capturedAt: new Date().toISOString() } };
+}
+
+/** Changing the game invalidates every game- and hardware-specific payload. */
+export function clearIncompatibleSettings(settings: ProfileSettings): ProfileSettings {
+  const adapters = isRecord(settings.adapters) ? { ...settings.adapters } : {};
+  for (const key of CAPTURED_ADAPTERS) delete adapters[key];
+  return { adapters };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
