+          ? "Сохранение считывает настройки CS2, параметры запуска Steam, экран и доступные параметры NVIDIA. Закройте CS2. Steam можно оставить открытым."
+          : game === "pubg"
+            ? "Сохранение считывает переносимые настройки PUBG, экрана и доступные параметры NVIDIA. Сначала закройте PUBG."
+            : "Сохранение считывает переносимые настройки VALORANT, экран и доступные параметры NVIDIA. Закройте VALORANT; Riot Client можно оставить открытым."}</div>
         {error && <div className="form-error" role="alert">{error}</div>}
-        <div className="modal-actions"><button type="button" className="button secondary" onClick={onClose}>Отмена</button><button className="button primary" disabled={busy || !name.trim()}>{busy ? "Сохраняем…" : profile ? "Сохранить изменения" : "Создать профиль"}</button></div>
+        <div className="modal-actions"><button type="button" className="button secondary" disabled={busy} onClick={onClose}>Отмена</button><button className="button primary" disabled={busy || !name.trim()}>{busy ? "Сохраняем…" : profile ? "Сохранить изменения" : "Создать профиль"}</button></div>
       </form>
     </section>
   </div>;
diff --git a/src/components/SteamLaunchOptionsHelp.tsx b/src/components/SteamLaunchOptionsHelp.tsx
new file mode 100644
index 0000000..54613c5
--- /dev/null
+++ b/src/components/SteamLaunchOptionsHelp.tsx
@@ -0,0 +1,30 @@
+import { useId, useState } from "react";
+import { useOneTimeHelp } from "../services/useOneTimeHelp";
+
+export function SteamLaunchOptionsHelp({ value, userId }: { value: string; userId: string }) {
+  const [open, setOpen] = useOneTimeHelp("steam-launch", userId);
+  const helpId = useId();
+  const [copyState, setCopyState] = useState<"idle" | "copied" | "error">("idle");
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(value);
+      setCopyState("copied");
+    } catch {
+      setCopyState("error");
+    }
+  }
+  return <section className="steam-launch-help" aria-label="Параметры запуска CS2">
+    <h2>Параметры запуска — без выхода из Steam</h2>
+    <p>Параметры запуска в Steam не применены автоматически. Проверьте их отдельно.</p>
+    <button className="button secondary" aria-expanded={open} aria-controls={helpId} onClick={() => setOpen(!open)}>{open ? "Скрыть инструкцию" : "Как пользоваться"}</button>
+    {open && <div id={helpId}>
+    <p>Steam → Библиотека → Counter-Strike 2 → Свойства → Общие → Параметры запуска.</p>
+    {value ? <>
+      <p>Замените содержимое поля этой строкой. Если она уже совпадает, ничего менять не нужно.</p>
+      <textarea aria-label="Строка параметров запуска CS2" readOnly value={value} rows={3} onFocus={(event) => event.currentTarget.select()} />
+      <button className="button secondary" onClick={() => void copy()}>Скопировать параметры</button>
+    </> : <p>В сохранённом профиле параметры запуска пустые. Очистите это поле в Steam, если в нём есть текст.</p>}
+    <p role="status">{copyState === "copied" ? "Строка скопирована. Теперь вставьте её в Steam — копирование само по себе настройки не применяет." : copyState === "error" ? "Не удалось скопировать. Выделите строку и скопируйте её вручную." : "FastPlay не изменял это поле в работающем Steam и не подтверждает его применение."}</p>
+    </div>}
+  </section>;
+}
