diff --git a/supabase/functions/device-license/index.ts b/supabase/functions/device-license/index.ts
new file mode 100644
index 0000000..707934e
--- /dev/null
+++ b/supabase/functions/device-license/index.ts
@@ -0,0 +1,334 @@
+import { createClient } from "jsr:@supabase/supabase-js@2";
+
+const encoder = new TextEncoder();
+const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, apikey, content-type, x-client-info",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+};
+
+type DeviceIdentity = {
+  publicKeyX: string;
+  publicKeyY: string;
+  publicKeySha256: string;
+  fingerprintHash: string;
+  keyProtection: "tpm" | "software";
+};
+
+type ChallengeRow = {
+  id: string;
+  purpose: "activate" | "verify";
+  challenge: string;
+  authenticated_user_id: string;
+  device_id: string | null;
+  activation_code_id: string | null;
+  public_key_x: string;
+  public_key_y: string;
+  public_key_sha256: string;
+  fingerprint_hash: string;
+  key_protection: "tpm" | "software";
+  expires_at: string;
+  used_at: string | null;
+};
+
+function json(status: number, body: Record<string, unknown>) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { ...corsHeaders, "Content-Type": "application/json", "Cache-Control": "no-store" },
+  });
+}
+
+function base64Url(bytes: Uint8Array) {
+  let binary = "";
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
+}
+
+function fromBase64Url(value: string) {
+  const normalized = value.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(value.length / 4) * 4, "=");
+  const binary = atob(normalized);
+  return Uint8Array.from(binary, (character) => character.charCodeAt(0));
+}
+
+async function sha256Hex(value: string) {
+  return [...new Uint8Array(await crypto.subtle.digest("SHA-256", encoder.encode(value)))]
+    .map((byte) => byte.toString(16).padStart(2, "0"))
+    .join("");
+}
+
+function validIdentity(value: unknown): value is DeviceIdentity {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const item = value as Record<string, unknown>;
+  return typeof item.publicKeyX === "string" && /^[A-Za-z0-9_-]{42,44}$/.test(item.publicKeyX)
+    && typeof item.publicKeyY === "string" && /^[A-Za-z0-9_-]{42,44}$/.test(item.publicKeyY)
+    && typeof item.publicKeySha256 === "string" && /^[a-f0-9]{64}$/.test(item.publicKeySha256)
+    && typeof item.fingerprintHash === "string" && /^[a-f0-9]{64}$/.test(item.fingerprintHash)
+    && (item.keyProtection === "tpm" || item.keyProtection === "software");
+}
+
+async function identityHashMatches(identity: DeviceIdentity) {
+  return await sha256Hex(`${identity.publicKeyX}.${identity.publicKeyY}`) === identity.publicKeySha256;
+}
+
+function proofMessage(row: ChallengeRow) {
+  return `game-passport-device-proof:v2\n${row.id}\n${row.challenge}\n${row.purpose}\n${row.public_key_sha256}\n${row.fingerprint_hash}\n${row.key_protection}`;
+}
+
+async function verifyDeviceSignature(row: ChallengeRow, signature: string) {
+  if (!/^[A-Za-z0-9_-]{80,100}$/.test(signature)) return false;
+  const key = await crypto.subtle.importKey(
+    "jwk",
+    { kty: "EC", crv: "P-256", x: row.public_key_x, y: row.public_key_y, ext: true },
+    { name: "ECDSA", namedCurve: "P-256" },
+    false,
+    ["verify"],
+  );
+  return await crypto.subtle.verify(
+    { name: "ECDSA", hash: "SHA-256" },
+    key,
+    fromBase64Url(signature),
+    encoder.encode(proofMessage(row)),
+  );
+}
+
+async function issueGrant(input: {
+  deviceId: string;
+  organizationId: string;
+  publicKeySha256: string;
+  graceHours: number;
+  licenseVersion: number;
+  validUntil?: string | null;
+}) {
+  const privateKeyBase64 = Deno.env.get("LICENSE_SIGNING_PRIVATE_KEY_PKCS8_B64");
+  const keyId = Deno.env.get("LICENSE_SIGNING_KEY_ID") ?? "gp-license-v1";
+  if (!privateKeyBase64) throw new Error("LICENSE_SIGNING_PRIVATE_KEY_PKCS8_B64 is not configured");
+  const now = Math.floor(Date.now() / 1000);
+  let expiresAt = now + Math.min(Math.max(input.graceHours, 1), 168) * 3600;
+  if (input.validUntil) expiresAt = Math.min(expiresAt, Math.floor(new Date(input.validUntil).getTime() / 1000));
+  if (expiresAt <= now) throw new Error("License is expired");
+  const header = { alg: "ES256", typ: "GP-OFFLINE-GRANT", kid: keyId };
+  const payload = {
+    iss: "game-passport-device-license",
+    aud: "game-passport-windows",
+    sub: input.deviceId,
+    organization_id: input.organizationId,
+    device_public_key_sha256: input.publicKeySha256,
+    license_version: input.licenseVersion,
+    iat: now,
+    nbf: now - 60,
+    exp: expiresAt,
+    server_time: now,
+  };
+  const encodedHeader = base64Url(encoder.encode(JSON.stringify(header)));
+  const encodedPayload = base64Url(encoder.encode(JSON.stringify(payload)));
+  const signingInput = `${encodedHeader}.${encodedPayload}`;
+  const key = await crypto.subtle.importKey(
+    "pkcs8",
+    Uint8Array.from(atob(privateKeyBase64), (character) => character.charCodeAt(0)),
+    { name: "ECDSA", namedCurve: "P-256" },
+    false,
+    ["sign"],
+  );
+  const signature = new Uint8Array(await crypto.subtle.sign(
+    { name: "ECDSA", hash: "SHA-256" }, key, encoder.encode(signingInput),
+  ));
+  return { token: `${signingInput}.${base64Url(signature)}`, expiresAt, serverTime: now };
+}
+
+Deno.serve(async (request) => {
+  if (request.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+  if (request.method !== "POST") return json(405, { code: "METHOD_NOT_ALLOWED" });
+
+  const supabaseUrl = Deno.env.get("SUPABASE_URL");
+  const anonKey = Deno.env.get("SUPABASE_ANON_KEY");
+  const serviceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+  const authorization = request.headers.get("Authorization");
+  if (!supabaseUrl || !anonKey || !serviceRoleKey) return json(503, { code: "SERVER_NOT_CONFIGURED" });
+  if (!authorization?.startsWith("Bearer ")) return json(401, { code: "AUTH_REQUIRED" });
+
+  const authClient = createClient(supabaseUrl, anonKey, {
+    global: { headers: { Authorization: authorization } },
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+  const { data: userData, error: userError } = await authClient.auth.getUser();
+  if (userError || !userData.user) return json(401, { code: "AUTH_INVALID" });
+  const user = userData.user;
+  const admin = createClient(supabaseUrl, serviceRoleKey, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+
+  let body: Record<string, unknown>;
+  try {
+    body = await request.json();
+  } catch {
+    return json(400, { code: "INVALID_JSON" });
+  }
+  const action = body.action;
+
+  if (action === "challenge" || action === "activation_challenge") {
+    const identity = body.identity;
+    if (!validIdentity(identity) || !(await identityHashMatches(identity))) {
+      return json(400, { code: "INVALID_DEVICE_IDENTITY" });
+    }
+    const fiveMinutesAgo = new Date(Date.now() - 5 * 60_000).toISOString();
+    const { count, error: rateError } = await admin.from("device_challenges")
+      .select("id", { count: "exact", head: true })
+      .eq("authenticated_user_id", user.id)
+      .gte("created_at", fiveMinutesAgo);
+    if (rateError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+    if ((count ?? 0) >= 20) return json(429, { code: "RATE_LIMITED" });
+
+    let deviceId: string | null = null;
+    let activationCodeId: string | null = null;
+    const purpose = action === "challenge" ? "verify" : "activate";
+    if (purpose === "verify") {
+      const { data: device, error: deviceError } = await admin.from("devices")
+        .select("id,status,fingerprint_hash")
+        .eq("public_key_sha256", identity.publicKeySha256)
+        .maybeSingle();
+      if (deviceError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      if (!device) return json(403, { code: "DEVICE_NOT_ACTIVATED" });
+      if (device.status !== "active") return json(403, { code: "DEVICE_REVOKED" });
+      if (device.fingerprint_hash !== identity.fingerprintHash) {
+        await admin.from("devices").update({ status: "review_required", updated_at: new Date().toISOString() }).eq("id", device.id);
+        return json(403, { code: "DEVICE_HARDWARE_MISMATCH" });
+      }
+      deviceId = device.id;
+    } else {
+      const activationCode = typeof body.activationCode === "string" ? body.activationCode.trim().toUpperCase() : "";
+      if (!/^GP-[A-F0-9]{36}$/.test(activationCode)) return json(403, { code: "ACTIVATION_CODE_INVALID" });
+      const codeHash = await sha256Hex(activationCode);
+      const { data: code, error: codeError } = await admin.from("device_activation_codes")
+        .select("id,status,expires_at")
+        .eq("code_hash", codeHash)
+        .maybeSingle();
+      if (codeError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      if (!code || code.status !== "active" || new Date(code.expires_at).getTime() <= Date.now()) {
+        return json(403, { code: "ACTIVATION_CODE_INVALID" });
+      }
+      activationCodeId = code.id;
+    }
+
+    const challenge = base64Url(crypto.getRandomValues(new Uint8Array(32)));
+    const expiresAt = new Date(Date.now() + 2 * 60_000).toISOString();
+    const { data, error } = await admin.from("device_challenges").insert({
+      purpose,
+      challenge,
+      authenticated_user_id: user.id,
+      device_id: deviceId,
+      activation_code_id: activationCodeId,
+      public_key_x: identity.publicKeyX,
+      public_key_y: identity.publicKeyY,
+      public_key_sha256: identity.publicKeySha256,
+      fingerprint_hash: identity.fingerprintHash,
+      key_protection: identity.keyProtection,
+      expires_at: expiresAt,
+    }).select("id,purpose,challenge,authenticated_user_id,device_id,activation_code_id,public_key_x,public_key_y,public_key_sha256,fingerprint_hash,key_protection,expires_at,used_at").single();
+    if (error || !data) return json(500, { code: "CHALLENGE_CREATE_FAILED" });
+    const row = data as ChallengeRow;
+    return json(200, { code: "CHALLENGE_ISSUED", challengeId: row.id, challenge: row.challenge, purpose: row.purpose });
+  }
+
+  if (action === "verify") {
+    const challengeId = typeof body.challengeId === "string" ? body.challengeId : "";
+    const signature = typeof body.signature === "string" ? body.signature : "";
+    const label = typeof body.deviceLabel === "string" ? body.deviceLabel.trim().slice(0, 80) : "";
+    const { data, error } = await admin.from("device_challenges")
+      .select("id,purpose,challenge,authenticated_user_id,device_id,activation_code_id,public_key_x,public_key_y,public_key_sha256,fingerprint_hash,key_protection,expires_at,used_at")
+      .eq("id", challengeId)
+      .eq("authenticated_user_id", user.id)
+      .maybeSingle();
+    if (error || !data) return json(403, { code: "CHALLENGE_INVALID" });
+    const row = data as ChallengeRow;
+    if (row.used_at || new Date(row.expires_at).getTime() <= Date.now()) return json(403, { code: "CHALLENGE_EXPIRED" });
+    if (!(await verifyDeviceSignature(row, signature))) return json(403, { code: "DEVICE_PROOF_INVALID" });
+
+    let deviceId: string;
+    let organizationId: string;
+    let licenseId: string;
+    let graceHours: number;
+    let licenseVersion: number;
+    if (row.purpose === "activate") {
+      const { data: activated, error: activationError } = await admin.rpc("activate_device_from_challenge", {
+        target_challenge_id: row.id,
+        target_label: label,
+      });
+      if (activationError || !activated?.[0]) {
+        const message = activationError?.message ?? "Activation failed";
+        if (/seat/i.test(message)) return json(409, { code: "SEAT_LIMIT_REACHED" });
+        if (/code/i.test(message)) return json(403, { code: "ACTIVATION_CODE_INVALID" });
+        return json(409, { code: "DEVICE_ACTIVATION_FAILED" });
+      }
+      const item = activated[0];
+      deviceId = item.device_id;
+      organizationId = item.organization_id;
+      licenseId = item.license_id;
+      graceHours = item.offline_grace_hours;
+      licenseVersion = Number(item.license_version);
+    } else {
+      const { data: consumed, error: consumeError } = await admin.from("device_challenges")
+        .update({ used_at: new Date().toISOString() })
+        .eq("id", row.id)
+        .is("used_at", null)
+        .select("id")
+        .maybeSingle();
+      if (consumeError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      if (!consumed || !row.device_id) return json(403, { code: "CHALLENGE_REPLAYED" });
+      const { data: device, error: deviceError } = await admin.from("devices")
+        .select("id,status,organization_id,license_id,public_key_sha256,fingerprint_hash")
+        .eq("id", row.device_id)
+        .maybeSingle();
+      if (deviceError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      if (!device || device.status !== "active") return json(403, { code: "DEVICE_REVOKED" });
+      if (device.public_key_sha256 !== row.public_key_sha256 || device.fingerprint_hash !== row.fingerprint_hash) {
+        return json(403, { code: "DEVICE_PROOF_INVALID" });
+      }
+      const { data: organization, error: organizationError } = await admin.from("organizations").select("id,status").eq("id", device.organization_id).single();
+      const { data: license, error: licenseError } = await admin.from("licenses")
+        .select("id,status,offline_grace_hours,valid_until,version")
+        .eq("id", device.license_id)
+        .single();
+      if (organizationError || licenseError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      if (!organization || organization.status !== "active" || !license || license.status !== "active") {
+        return json(403, { code: "DEVICE_REVOKED" });
+      }
+      if (license.valid_until && new Date(license.valid_until).getTime() <= Date.now()) {
+        return json(403, { code: "LICENSE_EXPIRED" });
+      }
+      const { error: lastSeenError } = await admin.from("devices")
+        .update({ last_seen_at: new Date().toISOString(), updated_at: new Date().toISOString() })
+        .eq("id", device.id);
+      if (lastSeenError) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+      deviceId = device.id;
+      organizationId = device.organization_id;
+      licenseId = device.license_id;
+      graceHours = license.offline_grace_hours;
+      licenseVersion = Number(license.version);
+    }
+
+    const { data: license, error: grantLicenseError } = await admin.from("licenses").select("valid_until").eq("id", licenseId).single();
+    if (grantLicenseError || !license) return json(503, { code: "LICENSE_DATABASE_UNAVAILABLE" });
+    try {
+      const grant = await issueGrant({
+        deviceId,
+        organizationId,
+        publicKeySha256: row.public_key_sha256,
+        graceHours,
+        licenseVersion,
+        validUntil: license?.valid_until,
+      });
+      return json(200, {
+        code: row.purpose === "activate" ? "DEVICE_ACTIVATED" : "DEVICE_ACTIVE",
+        deviceId,
+        organizationId,
+        offlineGrant: grant.token,
+        expiresAt: new Date(grant.expiresAt * 1000).toISOString(),
+        serverTime: new Date(grant.serverTime * 1000).toISOString(),
+      });
+    } catch {
+      return json(503, { code: "GRANT_SIGNING_UNAVAILABLE" });
+    }
+  }
+
+  return json(400, { code: "UNKNOWN_ACTION" });
+});
diff --git a/supabase/migrations/202608210001_device_licensing.sql b/supabase/migrations/202608210001_device_licensing.sql
new file mode 100644
index 0000000..078ea9a
--- /dev/null
+++ b/supabase/migrations/202608210001_device_licensing.sql
@@ -0,0 +1,434 @@
+-- Game Passport device licensing and profile hardening.
+-- Apply after 202608100001_create_profiles.sql.
+
+create schema if not exists extensions;
+create extension if not exists pgcrypto with schema extensions;
+do $$
+begin
+  if exists (
+    select 1 from pg_catalog.pg_extension extension_row
+    join pg_catalog.pg_namespace namespace_row on namespace_row.oid = extension_row.extnamespace
+    where extension_row.extname = 'pgcrypto' and namespace_row.nspname <> 'extensions'
+  ) then
+    alter extension pgcrypto set schema extensions;
+  end if;
+end;
+$$;
+
+create table if not exists public.organizations (
+  id uuid primary key default gen_random_uuid(),
+  name text not null check (char_length(trim(name)) between 2 and 120),
+  status text not null default 'active' check (status in ('active', 'suspended', 'closed')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create table if not exists public.organization_members (
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  user_id uuid not null references auth.users(id) on delete cascade,
+  role text not null check (role in ('owner', 'admin', 'member')),
+  created_at timestamptz not null default now(),
+  primary key (organization_id, user_id)
+);
+
+create table if not exists public.licenses (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null unique references public.organizations(id) on delete cascade,
+  status text not null default 'active' check (status in ('active', 'suspended', 'expired', 'cancelled')),
+  seat_limit integer not null check (seat_limit between 1 and 10000),
+  offline_grace_hours integer not null default 72 check (offline_grace_hours between 1 and 168),
+  valid_until timestamptz,
+  version bigint not null default 1 check (version > 0),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create table if not exists public.devices (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  license_id uuid not null references public.licenses(id) on delete restrict,
+  label text not null check (char_length(trim(label)) between 1 and 80),
+  public_key_x text not null check (char_length(public_key_x) between 42 and 44),
+  public_key_y text not null check (char_length(public_key_y) between 42 and 44),
+  public_key_sha256 text not null unique check (public_key_sha256 ~ '^[a-f0-9]{64}$'),
+  fingerprint_hash text not null check (fingerprint_hash ~ '^[a-f0-9]{64}$'),
+  key_protection text not null check (key_protection in ('tpm', 'software')),
+  status text not null default 'active' check (status in ('active', 'deactivated', 'revoked', 'replaced', 'review_required')),
+  activated_by uuid references auth.users(id) on delete set null,
+  activated_at timestamptz not null default now(),
+  last_seen_at timestamptz,
+  revoked_at timestamptz,
+  replaced_by uuid references public.devices(id) on delete set null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create index if not exists devices_organization_status_idx
+  on public.devices (organization_id, status);
+
+create table if not exists public.device_activation_codes (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  license_id uuid not null references public.licenses(id) on delete cascade,
+  code_hash text not null unique check (code_hash ~ '^[a-f0-9]{64}$'),
+  requested_label text check (requested_label is null or char_length(trim(requested_label)) between 1 and 80),
+  replaces_device_id uuid references public.devices(id) on delete set null,
+  status text not null default 'active' check (status in ('active', 'used', 'revoked', 'expired')),
+  expires_at timestamptz not null,
+  created_by uuid references auth.users(id) on delete set null,
+  used_by_device_id uuid references public.devices(id) on delete set null,
+  used_at timestamptz,
+  created_at timestamptz not null default now()
+);
+
+create index if not exists device_activation_codes_lookup_idx
+  on public.device_activation_codes (code_hash, status, expires_at);
+
+create table if not exists public.device_challenges (
+  id uuid primary key default gen_random_uuid(),
+  purpose text not null check (purpose in ('activate', 'verify')),
+  challenge text not null check (char_length(challenge) between 40 and 96),
+  authenticated_user_id uuid not null references auth.users(id) on delete cascade,
+  device_id uuid references public.devices(id) on delete cascade,
+  activation_code_id uuid references public.device_activation_codes(id) on delete cascade,
+  public_key_x text not null,
+  public_key_y text not null,
+  public_key_sha256 text not null check (public_key_sha256 ~ '^[a-f0-9]{64}$'),
+  fingerprint_hash text not null check (fingerprint_hash ~ '^[a-f0-9]{64}$'),
+  key_protection text not null check (key_protection in ('tpm', 'software')),
+  expires_at timestamptz not null,
+  used_at timestamptz,
+  created_at timestamptz not null default now(),
+  check (
+    (purpose = 'activate' and activation_code_id is not null and device_id is null)
+    or (purpose = 'verify' and device_id is not null and activation_code_id is null)
+  )
+);
+
+create index if not exists device_challenges_rate_idx
+  on public.device_challenges (authenticated_user_id, created_at desc);
+
+-- Harden existing profile access and prevent concurrent inserts bypassing the
+-- five-profile limit.
+alter table public.profiles enable row level security;
+alter table public.profiles force row level security;
+revoke all on public.profiles from anon;
+revoke all on public.profiles from authenticated;
+grant select, insert, update, delete on public.profiles to authenticated;
+
+alter table public.profiles drop constraint if exists profiles_settings_size_check;
+alter table public.profiles add constraint profiles_settings_size_check
+  check (pg_column_size(settings) <= 4194304);
+
+create or replace function public.enforce_profile_limit()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(new.user_id::text, 0));
+  if (select count(*) from public.profiles where user_id = new.user_id) >= 5 then
+    raise exception 'A user can have at most 5 profiles' using errcode = 'check_violation';
+  end if;
+  return new;
+end;
+$$;
+
+revoke all on function public.enforce_profile_limit() from public, anon, authenticated;
+
+alter table public.organizations enable row level security;
+alter table public.organizations force row level security;
+alter table public.organization_members enable row level security;
+alter table public.organization_members force row level security;
+alter table public.licenses enable row level security;
+alter table public.licenses force row level security;
+alter table public.devices enable row level security;
+alter table public.devices force row level security;
+alter table public.device_activation_codes enable row level security;
+alter table public.device_activation_codes force row level security;
+alter table public.device_challenges enable row level security;
+alter table public.device_challenges force row level security;
+
+revoke all on public.organizations, public.organization_members, public.licenses,
+  public.devices, public.device_activation_codes, public.device_challenges
+  from anon, authenticated;
+grant select, insert, update, delete on public.organizations, public.organization_members,
+  public.licenses, public.devices, public.device_activation_codes, public.device_challenges
+  to service_role;
+grant select on public.organizations, public.organization_members, public.licenses, public.devices
+  to authenticated;
+
+create or replace function public.is_organization_admin(target_organization_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.organization_members
+    where organization_id = target_organization_id
+      and user_id = auth.uid()
+      and role in ('owner', 'admin')
+  );
+$$;
+
+revoke all on function public.is_organization_admin(uuid) from public, anon;
+grant execute on function public.is_organization_admin(uuid) to authenticated;
+
+drop policy if exists "Organization admins can read organizations" on public.organizations;
+create policy "Organization admins can read organizations" on public.organizations
+  for select to authenticated using (public.is_organization_admin(id));
+
+drop policy if exists "Members can read own membership" on public.organization_members;
+create policy "Members can read own membership" on public.organization_members
+  for select to authenticated using (user_id = auth.uid());
+
+drop policy if exists "Organization admins can read licenses" on public.licenses;
+create policy "Organization admins can read licenses" on public.licenses
+  for select to authenticated using (public.is_organization_admin(organization_id));
+
+drop policy if exists "Organization admins can read devices" on public.devices;
+create policy "Organization admins can read devices" on public.devices
+  for select to authenticated using (public.is_organization_admin(organization_id));
+
+create or replace function public.create_device_activation_code(
+  target_organization_id uuid,
+  requested_device_label text default null,
+  lifetime interval default interval '2 hours'
+)
+returns text
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  raw_code text;
+  target_license public.licenses%rowtype;
+begin
+  if not public.is_organization_admin(target_organization_id) then
+    raise exception 'Not authorized' using errcode = 'insufficient_privilege';
+  end if;
+  if lifetime < interval '5 minutes' or lifetime > interval '24 hours' then
+    raise exception 'Activation-code lifetime must be between 5 minutes and 24 hours';
+  end if;
+  if requested_device_label is not null and char_length(trim(requested_device_label)) not between 1 and 80 then
+    raise exception 'Invalid device label';
+  end if;
+  select * into target_license
+  from public.licenses
+  where organization_id = target_organization_id
+    and status = 'active'
+    and (valid_until is null or valid_until > now());
+  if not found then
+    raise exception 'No active organization license';
+  end if;
+  raw_code := 'GP-' || upper(encode(extensions.gen_random_bytes(18), 'hex'));
+  insert into public.device_activation_codes (
+    organization_id, license_id, code_hash, requested_label, expires_at, created_by
+  ) values (
+    target_organization_id, target_license.id, encode(extensions.digest(raw_code, 'sha256'), 'hex'),
+    nullif(trim(requested_device_label), ''), now() + lifetime, auth.uid()
+  );
+  return raw_code;
+end;
+$$;
+
+revoke all on function public.create_device_activation_code(uuid, text, interval) from public, anon;
+grant execute on function public.create_device_activation_code(uuid, text, interval) to authenticated;
+
+create or replace function public.deactivate_device(target_device_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  target_organization_id uuid;
+  target_license_id uuid;
+begin
+  select organization_id, license_id into target_organization_id, target_license_id
+  from public.devices where id = target_device_id;
+  if target_organization_id is null or not public.is_organization_admin(target_organization_id) then
+    raise exception 'Not authorized' using errcode = 'insufficient_privilege';
+  end if;
+  -- Keep the same lock order as activation (license before device) so an
+  -- administrator deactivation cannot deadlock a concurrent activation.
+  perform 1 from public.licenses where id = target_license_id for update;
+  update public.devices
+  set status = 'deactivated', revoked_at = now(), updated_at = now()
+  where id = target_device_id and status = 'active';
+  update public.licenses set version = version + 1, updated_at = now()
+  where id = target_license_id;
+end;
+$$;
+
+revoke all on function public.deactivate_device(uuid) from public, anon;
+grant execute on function public.deactivate_device(uuid) to authenticated;
+
+create or replace function public.create_replacement_activation_code(
+  target_device_id uuid,
+  replacement_label text default null
+)
+returns text
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  target_device public.devices%rowtype;
+  raw_code text;
+begin
+  select * into target_device from public.devices where id = target_device_id for update;
+  if not found or not public.is_organization_admin(target_device.organization_id) then
+    raise exception 'Not authorized' using errcode = 'insufficient_privilege';
+  end if;
+  if target_device.status <> 'active' then
+    raise exception 'Replacement target is not active';
+  end if;
+  raw_code := 'GP-' || upper(encode(extensions.gen_random_bytes(18), 'hex'));
+  insert into public.device_activation_codes (
+    organization_id, license_id, code_hash, requested_label, replaces_device_id,
+    expires_at, created_by
+  ) values (
+    target_device.organization_id, target_device.license_id, encode(extensions.digest(raw_code, 'sha256'), 'hex'),
+    coalesce(nullif(trim(replacement_label), ''), target_device.label), target_device.id,
+    now() + interval '2 hours', auth.uid()
+  );
+  return raw_code;
+end;
+$$;
+
+revoke all on function public.create_replacement_activation_code(uuid, text) from public, anon;
+grant execute on function public.create_replacement_activation_code(uuid, text) to authenticated;
+
+-- Called only by the Edge Function with service_role after a valid device
+-- signature. The transaction locks both the activation code and license, so
+-- concurrent requests cannot exceed the seat limit or reuse a code.
+create or replace function public.activate_device_from_challenge(
+  target_challenge_id uuid,
+  target_label text
+)
+returns table (
+  device_id uuid,
+  organization_id uuid,
+  license_id uuid,
+  offline_grace_hours integer,
+  license_version bigint
+)
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  challenge_row public.device_challenges%rowtype;
+  code_row public.device_activation_codes%rowtype;
+  license_row public.licenses%rowtype;
+  organization_row public.organizations%rowtype;
+  replaced_device public.devices%rowtype;
+  existing_device public.devices%rowtype;
+  new_device_id uuid;
+  active_seats integer;
+  final_label text;
+begin
+  select * into challenge_row from public.device_challenges
+  where id = target_challenge_id and purpose = 'activate'
+  for update;
+  if not found or challenge_row.used_at is not null or challenge_row.expires_at <= now() then
+    raise exception 'Challenge is invalid or expired';
+  end if;
+  select * into code_row from public.device_activation_codes
+  where id = challenge_row.activation_code_id for update;
+  if not found or code_row.status <> 'active' or code_row.expires_at <= now() then
+    raise exception 'Activation code is invalid or expired';
+  end if;
+  select * into organization_row from public.organizations
+  where id = code_row.organization_id for update;
+  select * into license_row from public.licenses
+  where id = code_row.license_id for update;
+  if organization_row.status <> 'active'
+     or license_row.status <> 'active'
+     or (license_row.valid_until is not null and license_row.valid_until <= now()) then
+    raise exception 'Organization license is inactive';
+  end if;
+  select count(*) into active_seats from public.devices active_device
+  where active_device.license_id = license_row.id and active_device.status = 'active';
+  select * into existing_device from public.devices
+  where public_key_sha256 = challenge_row.public_key_sha256 for update;
+  if found then
+    if code_row.replaces_device_id = existing_device.id
+       and existing_device.organization_id = code_row.organization_id
+       and existing_device.license_id = code_row.license_id
+       and existing_device.status = 'review_required' then
+      if active_seats >= license_row.seat_limit then
+        raise exception 'No device seats are available';
+      end if;
+      final_label := coalesce(code_row.requested_label, nullif(trim(target_label), ''), existing_device.label);
+      update public.devices set label = final_label,
+        fingerprint_hash = challenge_row.fingerprint_hash,
+        key_protection = challenge_row.key_protection,
+        status = 'active', revoked_at = null, last_seen_at = now(), updated_at = now()
+      where id = existing_device.id;
+      update public.device_activation_codes set status = 'used', used_at = now(),
+        used_by_device_id = existing_device.id where id = code_row.id;
+      update public.device_challenges set used_at = now() where id = challenge_row.id;
+      update public.licenses set version = version + 1, updated_at = now()
+        where id = license_row.id returning version into license_row.version;
+      return query select existing_device.id, code_row.organization_id, code_row.license_id,
+        license_row.offline_grace_hours, license_row.version;
+      return;
+    end if;
+    raise exception 'Device key is already registered';
+  end if;
+  if code_row.replaces_device_id is null then
+    if active_seats >= license_row.seat_limit then
+      raise exception 'No device seats are available';
+    end if;
+  else
+    select * into replaced_device from public.devices
+    where id = code_row.replaces_device_id for update;
+    if not found
+       or replaced_device.organization_id <> code_row.organization_id
+       or replaced_device.license_id <> code_row.license_id
+       or replaced_device.status <> 'active' then
+      raise exception 'Replacement target is no longer active';
+    end if;
+  end if;
+  final_label := coalesce(code_row.requested_label, nullif(trim(target_label), ''));
+  if final_label is null or char_length(final_label) not between 1 and 80 then
+    raise exception 'Invalid device label';
+  end if;
+  insert into public.devices (
+    organization_id, license_id, label, public_key_x, public_key_y,
+    public_key_sha256, fingerprint_hash, key_protection, activated_by, last_seen_at
+  ) values (
+    code_row.organization_id, code_row.license_id, final_label,
+    challenge_row.public_key_x, challenge_row.public_key_y,
+    challenge_row.public_key_sha256, challenge_row.fingerprint_hash,
+    challenge_row.key_protection, challenge_row.authenticated_user_id, now()
+  ) returning id into new_device_id;
+  if code_row.replaces_device_id is not null then
+    update public.devices replaced_target set status = 'replaced', revoked_at = now(),
+      replaced_by = new_device_id, updated_at = now()
+    where replaced_target.id = code_row.replaces_device_id
+      and replaced_target.organization_id = code_row.organization_id
+      and replaced_target.status = 'active';
+  end if;
+  update public.device_activation_codes set status = 'used', used_at = now(),
+    used_by_device_id = new_device_id where id = code_row.id;
+  update public.device_challenges set used_at = now() where id = challenge_row.id;
+  update public.licenses set version = version + 1, updated_at = now()
+    where id = license_row.id returning version into license_row.version;
+  return query select new_device_id, code_row.organization_id, code_row.license_id,
+    license_row.offline_grace_hours, license_row.version;
+end;
+$$;
+
+revoke all on function public.activate_device_from_challenge(uuid, text) from public, anon, authenticated;
+grant execute on function public.activate_device_from_challenge(uuid, text) to service_role;
+
+-- No client role may mutate licensing tables directly. Edge Functions use the
+-- service role only on the server; its key must never be included in the app.
+revoke all on public.device_activation_codes, public.device_challenges from authenticated;
diff --git a/supabase/migrations/202609170001_add_valorant_profiles.sql b/supabase/migrations/202609170001_add_valorant_profiles.sql
