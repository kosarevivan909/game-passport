-  return user ? <Dashboard user={user} services={services} onSignOut={() => void signOut()} /> : <AuthScreen auth={services.auth} mode={services.mode} onAuthenticated={setUser} />;
+  const [license, setLicense] = useState<DeviceLicenseStatus | null>(null);
+  const [licenseBusy, setLicenseBusy] = useState(false);
+  useEffect(() => {
+    if (!services) { setReady(true); return; }
+    services.auth.getCurrentUser().then(setUser).catch((error) => logger.error("auth", "Session restore failed", error)).finally(() => setReady(true));
+    return services.auth.onAuthChange((next) => { setUser(next); if (!next) setLicense(null); });
+  }, [services]);
+  useEffect(() => {
+    if (!services || !user) return;
+    if (services.mode !== "cloud") {
+      setLicense({ state: "active", message: "Local development mode", offlineGrace: false });
+      return;
+    }
+    let mounted = true;
+    setLicenseBusy(true);
+    services.license.check().then((value) => mounted && setLicense(value)).catch((error) => mounted && setLicense({ state: "error", message: String(error), offlineGrace: false, retryable: true })).finally(() => mounted && setLicenseBusy(false));
+    return () => { mounted = false; };
+  }, [services, user]);
+  async function refreshLicense() {
+    if (!services) return;
+    setLicenseBusy(true);
+    try { setLicense(await services.license.check()); }
+    finally { setLicenseBusy(false); }
+  }
+  async function activate(code: string, label: string) {
+    if (!services) return;
+    setLicenseBusy(true);
+    try { setLicense(await services.license.activate(code, label)); }
+    finally { setLicenseBusy(false); }
+  }
+  async function signOut() { if (!services) return; try { await services.auth.signOut(); setUser(null); setLicense(null); } catch (error) { logger.error("auth", "Sign out failed", error); } }
+  if (!services) return <main className="splash configuration-error"><div className="passport-loader">!</div><strong>FastPlay не настроен для production</strong><span>{configured.error}</span></main>;
+  if (!ready) return <main className="splash"><div className="passport-loader">FP</div><span>Загружаем ваши профили…</span></main>;
+  if (!user) return <AuthScreen auth={services.auth} mode={services.mode} onAuthenticated={setUser} />;
+  if (!license || license.state === "checking") return <main className="splash"><div className="passport-loader">FP</div><span>Открываем ваши профили…</span></main>;
+  if (services.mode === "cloud" && !["not_required", "active", "offline_grace"].includes(license.state)) {
+    return <DeviceActivationScreen status={license} busy={licenseBusy} onRetry={refreshLicense} onActivate={activate} onSignOut={() => void signOut()} />;
+  }
+  return <Dashboard key={user.id} user={user} services={services} license={license} onSignOut={() => void signOut()} />;
 }
