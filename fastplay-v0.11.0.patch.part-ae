+            assert_eq!(
+                fs::read_to_string(fixture.context.userdata_cfg.join(REQUIRED_CORE[0])).unwrap(),
+                user_audio
+            );
+            let machine = fs::read_to_string(
+                fixture
+                    .context
+                    .userdata_cfg
+                    .join("cs2_machine_convars.vcfg"),
+            )
+            .unwrap();
+            assert!(machine.contains("\"snd_headphone_eq\" \"2\""));
+            assert!(machine.contains("\"snd_spatialize_lerp\" \"0.5\""));
+            assert!(!machine.contains("source-pc"));
+            assert_eq!(
+                fs::read_to_string(
+                    fixture
+                        .context
+                        .install_cfg
+                        .as_ref()
+                        .unwrap()
+                        .join("autoexec.cfg")
+                )
+                .unwrap(),
+                cfg_audio
+            );
+        }
