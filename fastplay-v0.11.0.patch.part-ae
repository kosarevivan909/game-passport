+                display_mode_intent(borderless).unwrap(),
+                DisplayModeIntent::Other
+            );
+            assert_eq!(
+                normalize_saved_display_mode(borderless, DisplayModeIntent::Other).unwrap(),
+                borderless
+            );
+        }
     }
 }
 
