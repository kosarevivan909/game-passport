+    pub fn apply_display_controls(payload: NvidiaPayload) -> NvidiaCommandResponse {
+        if let Err(message) = validate_payload(&payload) {
+            return error_response(message, false);
+        }
+        let desired = raw_from_payload(&payload, true);
+        let color_report = match apply_display_controls_raw(&desired) {
+            Ok(value) => value,
+            Err(message) => return error_response(message, true),
+        };
+        let color_ok = color_report.color_requested == 0 || color_report.color_applied != 0;
+        let gamma_result = payload
+            .desktop_gamma_ramp
+            .as_ref()
+            .map(apply_and_verify_gamma_ramp);
+        let gamma_ok = match gamma_result.as_ref() {
+            None => true,
+            Some(result) => result.is_ok(),
+        };
+        let mut details = vec![format!(
+            "Output color: {}",
+            char_array(&color_report.color_message)
+        )];
+        match gamma_result {
+            Some(Ok(())) => details.push("Desktop color curve was applied and verified.".into()),
+            Some(Err(message)) => details.push(format!("Desktop color curve: {message}")),
+            None => details.push("No portable desktop color curve was available.".into()),
+        }
+        details.push(
+            "Digital Vibrance, Hue, the preview-window selector, and custom underscan are not exposed by public NVIDIA APIs."
+                .into(),
+        );
+        let requested = color_report.color_requested != 0 || payload.desktop_gamma_ramp.is_some();
+        NvidiaCommandResponse {
+            state: if !color_ok || !gamma_ok || !requested {
+                "warning"
+            } else {
+                "success"
+            }
+            .into(),
+            message: if !color_ok || !gamma_ok {
+                "NVIDIA display controls were applied only partially.".into()
+            } else {
+                "NVIDIA display controls were applied where the driver exposes portable settings."
+                    .into()
+            },
+            details,
+            retryable: !color_ok || !gamma_ok,
+            payload: None,
+            diagnostics: None,
+            backup_token: None,
+        }
+    }
+
