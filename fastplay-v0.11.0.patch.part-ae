+    fn is_hardware_specific_video_line(line: &str) -> bool {
+        let lower = line.to_ascii_lowercase();
+        [
+            "sound_device_override",
+            "audio_device",
+            "vendorid",
+            "deviceid",
+            "monitor_index",
+            "refreshrate_numerator",
+            "refreshrate_denominator",
+        ]
+        .iter()
+        .any(|marker| lower.contains(marker))
+    }
+
+    fn merge_video_with_target_hardware(
+        saved: &[u8],
+        target: &[u8],
+    ) -> Result<Vec<u8>, UserFacingError> {
+        let (portable, _) = sanitize_hardware_config(saved)?;
+        let portable = String::from_utf8(portable)
+            .map_err(|_| UserFacingError::new("Saved cs2_video.txt is not valid UTF-8.", false))?;
+        let target = std::str::from_utf8(target)
+            .map_err(|_| UserFacingError::new("Current cs2_video.txt is not valid UTF-8.", true))?;
+        let hardware = target
+            .lines()
+            .filter(|line| is_hardware_specific_video_line(line))
+            .collect::<Vec<_>>();
+        if hardware.is_empty() {
+            return Ok(portable.into_bytes());
+        }
+        let newline = if portable.contains("\r\n") {
+            "\r\n"
+        } else {
+            "\n"
+        };
+        let insertion = hardware.join(newline);
+        let closing = portable.rfind('}').ok_or_else(|| {
+            UserFacingError::new("Saved cs2_video.txt has an invalid structure.", false)
+        })?;
+        let mut merged = portable;
+        merged.insert_str(closing, &format!("{insertion}{newline}"));
+        Ok(merged.into_bytes())
+    }
+
+    fn current_video_hardware_config() -> Result<String, UserFacingError> {
+        let mut index = 0;
+        let mut fallback = None;
+        loop {
+            let mut adapter: DISPLAY_DEVICEW = unsafe { zeroed() };
+            adapter.cb = size_of::<DISPLAY_DEVICEW>() as u32;
+            if unsafe { EnumDisplayDevicesW(null(), index, &mut adapter, 0) } == 0 {
+                break;
+            }
+            index += 1;
+            if adapter.StateFlags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP == 0 {
+                continue;
+            }
+
+            let device_id = wide_array_to_string(&adapter.DeviceID);
+            let Some(vendor_id) = parse_pci_hex_id(&device_id, "VEN_") else {
+                continue;
+            };
+            let Some(gpu_device_id) = parse_pci_hex_id(&device_id, "DEV_") else {
+                continue;
+            };
+            let device_name = wide_array_to_string(&adapter.DeviceName);
+            let device_name_wide = wide_null(&device_name);
+            let mut mode: DEVMODEW = unsafe { zeroed() };
+            mode.dmSize = size_of::<DEVMODEW>() as u16;
+            if unsafe {
+                EnumDisplaySettingsExW(
+                    device_name_wide.as_ptr(),
+                    ENUM_CURRENT_SETTINGS,
+                    &mut mode,
+                    0,
+                )
+            } == 0
+            {
+                continue;
+            }
+            let refresh_hz = u32::from(mode.dmDisplayFrequency.max(1));
+            let config = format!(
+                "\"video.cfg\"\r\n{{\r\n\t\"VendorID\"\t\t\"{vendor_id}\"\r\n\t\"DeviceID\"\t\t\"{gpu_device_id}\"\r\n\t\"setting.monitor_index\"\t\t\"0\"\r\n\t\"setting.refreshrate_numerator\"\t\t\"{refresh_hz}\"\r\n\t\"setting.refreshrate_denominator\"\t\t\"1\"\r\n}}\r\n"
+            );
+            if adapter.StateFlags & DISPLAY_DEVICE_PRIMARY_DEVICE != 0 {
+                return Ok(config);
+            }
+            fallback.get_or_insert(config);
+        }
+
+        fallback.ok_or_else(|| {
+            UserFacingError::new(
+                "Windows не смог определить видеокарту и основной монитор. Настройки графики CS2 не применены.",
+                true,
+            )
+            .detail("Подключите монитор к активной видеокарте, обновите драйвер и нажмите «Повторить».")
+        })
+    }
+
+    fn parse_pci_hex_id(device_id: &str, marker: &str) -> Option<u32> {
+        let upper = device_id.to_ascii_uppercase();
+        let start = upper.find(marker)? + marker.len();
+        let value = upper[start..]
+            .chars()
+            .take_while(|character| character.is_ascii_hexdigit())
+            .collect::<String>();
+        (!value.is_empty())
+            .then(|| u32::from_str_radix(&value, 16).ok())
+            .flatten()
+    }
+
+    fn wide_null(value: &str) -> Vec<u16> {
+        OsStr::new(value).encode_wide().chain(Some(0)).collect()
+    }
+
+    fn wide_array_to_string(value: &[u16]) -> String {
+        let end = value
+            .iter()
+            .position(|character| *character == 0)
+            .unwrap_or(value.len());
+        String::from_utf16_lossy(&value[..end])
+    }
+
+    fn normalize_saved_display_mode(
+        bytes: &[u8],
+        display_mode: DisplayModeIntent,
+    ) -> Result<Vec<u8>, UserFacingError> {
+        if display_mode != DisplayModeIntent::ExclusiveFullscreen {
+            return Ok(bytes.to_vec());
+        }
+        let text = std::str::from_utf8(bytes).map_err(|_| {
+            UserFacingError::new("cs2_video.txt has an unsupported text encoding.", false)
+        })?;
+        let mut fullscreen = false;
+        let mut coop_fullscreen = false;
+        let mut no_border = false;
+        let mut output = Vec::new();
+        for line in text.lines() {
+            let tokens = quoted_tokens(line);
+            let replacement = if tokens
+                .first()
+                .is_some_and(|key| key.eq_ignore_ascii_case("setting.fullscreen"))
+            {
+                fullscreen = true;
+                Some("1")
+            } else if tokens
+                .first()
+                .is_some_and(|key| key.eq_ignore_ascii_case("setting.coop_fullscreen"))
+            {
+                coop_fullscreen = true;
+                Some("0")
+            } else if tokens
+                .first()
+                .is_some_and(|key| key.eq_ignore_ascii_case("setting.nowindowborder"))
+            {
+                no_border = true;
+                Some("0")
+            } else {
+                None
+            };
+            output.push(match replacement {
+                Some(value) => replace_second_quoted_value(line, value).ok_or_else(|| {
+                    UserFacingError::new(
+                        "cs2_video.txt contains a malformed fullscreen value.",
+                        false,
+                    )
+                })?,
+                None => line.to_string(),
+            });
+        }
+        if !fullscreen {
+            return Err(UserFacingError::new(
+                "cs2_video.txt does not contain setting.fullscreen. Nothing was changed.",
+                false,
+            ));
+        }
+        let newline = if text.contains("\r\n") { "\r\n" } else { "\n" };
+        if !coop_fullscreen || !no_border {
+            let closing = output
+                .iter()
+                .rposition(|line| line.trim() == "}")
+                .ok_or_else(|| {
+                    UserFacingError::new("cs2_video.txt has an invalid structure.", false)
+                })?;
+            if !coop_fullscreen {
+                output.insert(
+                    closing,
+                    "\t\"setting.coop_fullscreen\"\t\t\"0\"".to_string(),
+                );
+            }
+            if !no_border {
+                output.insert(
+                    closing + usize::from(!coop_fullscreen),
+                    "\t\"setting.nowindowborder\"\t\t\"0\"".to_string(),
+                );
+            }
+        }
+        let mut result = output.join(newline);
+        if text.ends_with('\n') {
+            result.push_str(newline);
+        }
+        Ok(result.into_bytes())
+    }
+
+    fn replace_second_quoted_value(line: &str, value: &str) -> Option<String> {
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut quoted_index = 0usize;
+        let mut start = None;
+        for (index, character) in line.char_indices() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            if quoted && character == '\\' {
+                escaped = true;
+                continue;
+            }
+            if character != '"' {
+                continue;
+            }
+            if quoted {
+                if quoted_index == 1 {
+                    let start = start?;
+                    let mut result = line.to_string();
+                    result.replace_range(start..index, value);
+                    return Some(result);
+                }
+                quoted_index += 1;
+                start = None;
+            } else {
+                start = Some(index + 1);
+            }
+            quoted = !quoted;
+        }
+        None
+    }
