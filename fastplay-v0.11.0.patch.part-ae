diff --git a/src/adapters/ValorantAdapter.ts b/src/adapters/ValorantAdapter.ts
new file mode 100644
index 0000000..2cca4b0
--- /dev/null
+++ b/src/adapters/ValorantAdapter.ts
@@ -0,0 +1,43 @@
+import { invoke } from "@tauri-apps/api/core";
+import { getValorantPayload, type ValorantCommandResponse, type ValorantPayload } from "../domain/valorant";
+import type { AdapterResult, GameProfile } from "../domain/types";
+import type { SettingsAdapter } from "../ports/SettingsAdapter";
+import { isTauriDesktop } from "../services/platform";
+
+function map(response: ValorantCommandResponse, patch?: Record<string, unknown>): AdapterResult {
+  return { adapterId: "game.valorant", label: "VALORANT Settings", state: response.state, message: response.message, details: response.details, retryable: response.retryable, backupToken: response.backupToken, ...(patch && { settingsPatch: patch }) };
+}
+
+export class ValorantAdapter implements SettingsAdapter {
+  readonly id = "game.valorant";
+  readonly label = "VALORANT Settings";
+  readonly status = "implemented" as const;
+  private backupToken?: string;
+  supports(profile: GameProfile) { return profile.game === "valorant"; }
+  async capture(): Promise<AdapterResult> {
+    if (!isTauriDesktop()) return this.unsupported();
+    try { const response = await invoke<ValorantCommandResponse>("capture_valorant_settings"); return map(response, response.payload ? { adapters: { valorant: response.payload } } : undefined); }
+    catch (error) { return this.error(error); }
+  }
+  async apply(profile: GameProfile): Promise<AdapterResult> {
+    this.backupToken = undefined;
+    if (!isTauriDesktop()) return this.unsupported();
+    const payload = getValorantPayload(profile.settings);
+    if (!payload) return { adapterId: this.id, label: this.label, state: "error", message: "В профиле нет корректного снимка VALORANT.", retryable: false };
+    try { const response = await invoke<ValorantCommandResponse>("apply_valorant_settings", { payload: payload as ValorantPayload }); this.backupToken = response.backupToken; return map(response); }
+    catch (error) { return this.error(error); }
+  }
+  async rollback(): Promise<AdapterResult> {
+    if (!isTauriDesktop() || !this.backupToken) return { adapterId: `${this.id}.rollback`, label: "VALORANT rollback", state: "unsupported", message: "Нет резервной копии VALORANT." };
+    const response = await invoke<ValorantCommandResponse>("restore_valorant_settings", { backupToken: this.backupToken });
+    return { ...map(response), adapterId: `${this.id}.rollback`, label: "VALORANT rollback" };
+  }
+  async restore(backupToken?: string): Promise<AdapterResult> {
+    if (!isTauriDesktop()) return this.unsupported();
+    if (!backupToken) return { adapterId: this.id, label: this.label, state: "unsupported", message: "Для этого применения нет точной резервной копии VALORANT." };
+    try { return map(await invoke<ValorantCommandResponse>("restore_valorant_settings", { backupToken })); }
+    catch (error) { return this.error(error); }
+  }
+  private unsupported(): AdapterResult { return { adapterId: this.id, label: this.label, state: "unsupported", message: "Настройки VALORANT доступны только в Windows-приложении.", retryable: false }; }
+  private error(error: unknown): AdapterResult { return { adapterId: this.id, label: this.label, state: "error", message: "Служба VALORANT не завершила операцию.", details: [error instanceof Error ? error.message : String(error)], retryable: true }; }
+}
diff --git a/src/adapters/ValorantPreflightAdapter.ts b/src/adapters/ValorantPreflightAdapter.ts
new file mode 100644
index 0000000..bcf7cb9
--- /dev/null
+++ b/src/adapters/ValorantPreflightAdapter.ts
@@ -0,0 +1,20 @@
+import { invoke } from "@tauri-apps/api/core";
+import type { ValorantCommandResponse } from "../domain/valorant";
+import type { AdapterResult, GameProfile } from "../domain/types";
+import type { SettingsAdapter } from "../ports/SettingsAdapter";
+import { isTauriDesktop } from "../services/platform";
+
+export class ValorantPreflightAdapter implements SettingsAdapter {
+  readonly id = "game.valorant.preflight";
+  readonly label = "VALORANT preflight";
+  readonly status = "implemented" as const;
+  supports(profile: GameProfile) { return profile.game === "valorant"; }
+  async capture(): Promise<AdapterResult> { return this.run(); }
+  async apply(): Promise<AdapterResult> { return this.run(); }
+  async restore(): Promise<AdapterResult> { return this.run(); }
+  private async run(): Promise<AdapterResult> {
+    if (!isTauriDesktop()) return { adapterId: this.id, label: this.label, state: "unsupported", message: "Проверка VALORANT требует Windows." };
+    try { const response = await invoke<ValorantCommandResponse>("check_valorant_closed"); return { adapterId: this.id, label: this.label, state: response.state, message: response.message, details: response.details, retryable: response.retryable }; }
+    catch (error) { return { adapterId: this.id, label: this.label, state: "error", message: "Не удалось проверить процесс VALORANT.", details: [String(error)], retryable: true }; }
+  }
+}
diff --git a/src/adapters/registry.ts b/src/adapters/registry.ts
index 63bbe56..a335d23 100644
--- a/src/adapters/registry.ts
+++ b/src/adapters/registry.ts
@@ -3,17 +3,21 @@ import { Cs2Adapter } from "./Cs2Adapter";
 import { Cs2PreflightAdapter } from "./Cs2PreflightAdapter";
 import { DisplayAdapter } from "./DisplayAdapter";
 import { NvidiaAdapter } from "./NvidiaAdapter";
-import { MouseAdapter } from "./MouseAdapter";
+import { NvidiaDisplayControlsAdapter } from "./NvidiaDisplayControlsAdapter";
 import { PubgAdapter } from "./PubgAdapter";
 import { PubgPreflightAdapter } from "./PubgPreflightAdapter";
+import { ValorantAdapter } from "./ValorantAdapter";
+import { ValorantPreflightAdapter } from "./ValorantPreflightAdapter";
 
 const cs2 = new Cs2Adapter();
 const display = new DisplayAdapter();
 const nvidia = new NvidiaAdapter();
+const nvidiaDisplayControls = new NvidiaDisplayControlsAdapter();
 const preflight = new Cs2PreflightAdapter();
-const mouse = new MouseAdapter();
 const pubg = new PubgAdapter();
 const pubgPreflight = new PubgPreflightAdapter();
+const valorant = new ValorantAdapter();
+const valorantPreflight = new ValorantPreflightAdapter();
 
 export const adapterRegistry = [
   display,
@@ -21,11 +25,13 @@ export const adapterRegistry = [
   cs2,
   new UnsupportedAdapter("game.dota2", "Dota 2 Settings", "dota2"),
   pubg,
+  valorant,
   new UnsupportedAdapter("windows", "Windows"),
-  new UnsupportedAdapter("audio", "Audio"),
-  mouse
+  new UnsupportedAdapter("audio", "Audio")
 ];
 
-export const captureAdapterRegistry = [cs2, pubg, display, nvidia, mouse];
-export const applyAdapterRegistry = [preflight, pubgPreflight, display, nvidia, mouse, cs2, pubg];
-export const restoreAdapterRegistry = [preflight, pubgPreflight, cs2, pubg, mouse, nvidia, display];
+export const captureAdapterRegistry = [cs2, pubg, valorant, display, nvidia];
+// Changing the Windows mode can rebuild the display path. Apply and verify the
+// desktop first, then make NVIDIA the final owner of scaling and color state.
+export const applyAdapterRegistry = [preflight, pubgPreflight, valorantPreflight, display, nvidia, nvidiaDisplayControls, cs2, pubg, valorant];
+export const restoreAdapterRegistry = [preflight, pubgPreflight, valorantPreflight, display, nvidia, cs2, pubg, valorant];
