+#[tauri::command]
+fn begin_apply_lock(
+    window: tauri::WebviewWindow,
+    state: tauri::State<'_, apply_lock::ApplyLockManager>,
+    request: apply_lock::ApplyLockRequest,
+) -> apply_lock::ApplyLockStatus {
+    if let Err(message) = license::require_active() {
+        return apply_lock::denied(message);
+    }
+    if let Err(error) = window.set_fullscreen(true) {
+        return apply_lock::denied(format!(
+            "Не удалось включить полноэкранный Apply Lock: {error}"
+        ));
+    }
+    if let Err(error) = window.set_always_on_top(true) {
+        let _ = window.set_fullscreen(false);
+        return apply_lock::denied(format!("Не удалось закрепить окно Apply Lock: {error}"));
+    }
+    let _ = window.set_focus();
+    let result = state.begin(request);
+    if result.state != "success" {
+        let _ = window.set_always_on_top(false);
+        let _ = window.set_fullscreen(false);
+    }
+    result
+}
+
+#[tauri::command]
+fn heartbeat_apply_lock(
+    state: tauri::State<'_, apply_lock::ApplyLockManager>,
+) -> apply_lock::ApplyLockStatus {
+    state.heartbeat()
+}
+
+#[tauri::command]
+fn finish_apply_lock(
+    window: tauri::WebviewWindow,
+    state: tauri::State<'_, apply_lock::ApplyLockManager>,
+) -> apply_lock::ApplyLockStatus {
+    let result = state.finish();
+    let topmost = window.set_always_on_top(false);
+    let fullscreen = window.set_fullscreen(false);
+    if result.state == "success" {
+        if let Err(error) = topmost {
+            return apply_lock::denied(format!(
+                "Настройки применены, но окно осталось поверх остальных: {error}"
+            ));
+        }
+        if let Err(error) = fullscreen {
+            return apply_lock::denied(format!(
+                "Настройки применены, но полноэкранный режим окна не снят: {error}"
+            ));
+        }
+    }
+    result
+}
+
+#[tauri::command]
+fn get_apply_lock_status() -> apply_lock::ApplyLockStatus {
+    apply_lock::status()
+}
+
+#[tauri::command]
+fn clear_interrupted_apply() -> apply_lock::ApplyLockStatus {
+    apply_lock::clear_interrupted()
+}
