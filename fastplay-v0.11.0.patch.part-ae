diff --git a/src-tauri/src/secure_storage.rs b/src-tauri/src/secure_storage.rs
new file mode 100644
index 0000000..e9bdcd3
--- /dev/null
+++ b/src-tauri/src/secure_storage.rs
@@ -0,0 +1,255 @@
+use serde::Serialize;
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SecureStorageResponse {
+    pub state: String,
+    pub value: Option<String>,
+    pub message: String,
+}
+
+const ALLOWED_PREFIXES: [&str; 3] = [
+    "game-passport.auth.",
+    "game-passport.profile-cache.",
+    "game-passport.license.",
+];
+
+fn validate_key(key: &str) -> Result<(), String> {
+    if key.len() > 180
+        || !ALLOWED_PREFIXES
+            .iter()
+            .any(|prefix| key.starts_with(prefix))
+        || !key
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || ".-_".contains(character))
+    {
+        return Err("Secure-storage key is outside the Game Passport allowlist.".into());
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn get(_key: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn set(_key: String, _value: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn remove(_key: String) -> SecureStorageResponse {
+    unsupported()
+}
+
+#[cfg(not(target_os = "windows"))]
+fn unsupported() -> SecureStorageResponse {
+    SecureStorageResponse {
+        state: "unsupported".into(),
+        value: None,
+        message: "Windows protected storage is unavailable on this platform.".into(),
+    }
+}
+
+#[cfg(target_os = "windows")]
+mod windows {
+    use super::*;
+    use sha2::Digest;
+    use std::{
+        env, fs,
+        os::windows::ffi::OsStrExt,
+        path::PathBuf,
+        ptr::null,
+        time::{SystemTime, UNIX_EPOCH},
+    };
+    use windows_sys::Win32::{
+        Foundation::LocalFree,
+        Security::Cryptography::{
+            CryptProtectData, CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN, CRYPT_INTEGER_BLOB,
+        },
+        Storage::FileSystem::{MoveFileExW, MOVEFILE_REPLACE_EXISTING, MOVEFILE_WRITE_THROUGH},
+    };
+
+    const MAX_PROTECTED_BYTES: usize = 24 * 1024 * 1024;
+
+    fn root() -> Result<PathBuf, String> {
+        env::var_os("LOCALAPPDATA")
+            .map(PathBuf::from)
+            .map(|path| path.join("app.gamepassport.desktop").join("protected"))
+            .ok_or_else(|| "Windows Local AppData is unavailable.".into())
+    }
+
+    fn path_for(key: &str) -> Result<PathBuf, String> {
+        validate_key(key)?;
+        let digest = format!("{:x}", sha2::Sha256::digest(key.as_bytes()));
+        Ok(root()?.join(format!("{digest}.bin")))
+    }
+
+    pub fn protect(bytes: &[u8]) -> Result<Vec<u8>, String> {
+        if bytes.len() > MAX_PROTECTED_BYTES {
+            return Err("Protected value exceeds the 24 MB limit.".into());
+        }
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: bytes.len() as u32,
+            pbData: bytes.as_ptr() as *mut u8,
+        };
+        let mut output = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let ok = unsafe {
+            CryptProtectData(
+                &input,
+                null(),
+                null(),
+                null(),
+                null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 || output.pbData.is_null() {
+            return Err("Windows DPAPI could not protect the value.".into());
+        }
+        let result = unsafe {
+            let value = std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec();
+            let _ = LocalFree(output.pbData.cast());
+            value
+        };
+        Ok(result)
+    }
+
+    pub fn unprotect(bytes: &[u8]) -> Result<Vec<u8>, String> {
+        if bytes.len() > MAX_PROTECTED_BYTES + 4096 {
+            return Err("Protected value exceeds the safe size limit.".into());
+        }
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: bytes.len() as u32,
+            pbData: bytes.as_ptr() as *mut u8,
+        };
+        let mut output = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let ok = unsafe {
+            CryptUnprotectData(
+                &input,
+                std::ptr::null_mut(),
+                null(),
+                null(),
+                null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 || output.pbData.is_null() {
+            return Err("Windows DPAPI could not unlock the value on this computer.".into());
+        }
+        let result = unsafe {
+            let value = std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec();
+            let _ = LocalFree(output.pbData.cast());
+            value
+        };
+        Ok(result)
+    }
+
+    pub fn get(key: String) -> SecureStorageResponse {
+        let result = (|| -> Result<Option<String>, String> {
+            let path = path_for(&key)?;
+            if !path.exists() {
+                return Ok(None);
+            }
+            let bytes = fs::read(path).map_err(|error| error.to_string())?;
+            let clear = unprotect(&bytes)?;
+            String::from_utf8(clear)
+                .map(Some)
+                .map_err(|_| "Protected value is not valid UTF-8.".into())
+        })();
+        match result {
+            Ok(value) => SecureStorageResponse {
+                state: "success".into(),
+                value,
+                message: "Protected value loaded.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+
+    pub fn set(key: String, value: String) -> SecureStorageResponse {
+        let result = (|| -> Result<(), String> {
+            let path = path_for(&key)?;
+            let parent = path.parent().ok_or("Protected-storage path is invalid.")?;
+            fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+            let protected = protect(value.as_bytes())?;
+            let nonce = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map_err(|_| "Windows system clock is invalid.")?
+                .as_nanos();
+            let temporary = path.with_extension(format!("{}-{nonce}.tmp", std::process::id()));
+            fs::write(&temporary, protected).map_err(|error| error.to_string())?;
+            let source = temporary
+                .as_os_str()
+                .encode_wide()
+                .chain(std::iter::once(0))
+                .collect::<Vec<_>>();
+            let destination = path
+                .as_os_str()
+                .encode_wide()
+                .chain(std::iter::once(0))
+                .collect::<Vec<_>>();
+            let moved = unsafe {
+                MoveFileExW(
+                    source.as_ptr(),
+                    destination.as_ptr(),
+                    MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+                )
+            };
+            if moved == 0 {
+                let _ = fs::remove_file(&temporary);
+                return Err("Windows could not atomically replace a protected value.".into());
+            }
+            Ok(())
+        })();
+        match result {
+            Ok(()) => SecureStorageResponse {
+                state: "success".into(),
+                value: None,
+                message: "Protected value saved.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+
+    pub fn remove(key: String) -> SecureStorageResponse {
+        let result = path_for(&key).and_then(|path| {
+            if path.exists() {
+                fs::remove_file(path).map_err(|error| error.to_string())?;
+            }
+            Ok(())
+        });
+        match result {
+            Ok(()) => SecureStorageResponse {
+                state: "success".into(),
+                value: None,
+                message: "Protected value removed.".into(),
+            },
+            Err(message) => SecureStorageResponse {
+                state: "error".into(),
+                value: None,
+                message,
+            },
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub use windows::{get, remove, set};
diff --git a/src-tauri/src/valorant.rs b/src-tauri/src/valorant.rs
new file mode 100644
index 0000000..98db0f3
--- /dev/null
+++ b/src-tauri/src/valorant.rs
@@ -0,0 +1,1303 @@
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+const SCHEMA_VERSION: u32 = 1;
+const MAX_FILES: usize = 2;
+const MAX_ENTRIES: usize = 12_000;
+const MAX_VALUE_BYTES: usize = 256 * 1024;
+const MAX_SNAPSHOT_BYTES: usize = 3 * 1024 * 1024;
+const GAME_FILE: &str = "WindowsClient/GameUserSettings.ini";
+const RIOT_FILE: &str = "Windows/RiotUserSettings.ini";
+const ALLOWED_FILES: [&str; 2] = [GAME_FILE, RIOT_FILE];
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantIniEntry {
+    pub section: String,
+    pub key: String,
+    #[serde(default)]
+    pub operator: String,
+    pub value: String,
+    pub categories: Vec<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantConfigFile {
+    pub relative_id: String,
+    pub entries: Vec<ValorantIniEntry>,
+    pub sha256: String,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantCategorySummary {
+    pub gameplay: usize,
+    pub keybinds: usize,
+    pub graphics: usize,
+    pub audio: usize,
+    pub crosshair: usize,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantNormalizedSettings {
+    pub width: Option<u32>,
+    pub height: Option<u32>,
+    pub display_mode: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantPayload {
+    pub schema_version: u32,
+    pub captured_at: String,
+    pub game: String,
+    pub files: Vec<ValorantConfigFile>,
+    pub normalized: ValorantNormalizedSettings,
+    pub captured_categories: ValorantCategorySummary,
+    pub unsupported_categories: Vec<String>,
+    pub warnings: Vec<String>,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantDiagnostics {
+    pub valorant_detected: bool,
+    pub config_directory: Option<String>,
+    pub config_files_found: Vec<String>,
+    pub candidate_profiles: usize,
+    pub process_running: bool,
+    pub capture_result: Option<String>,
+    pub apply_result: Option<String>,
+    pub backup_result: Option<String>,
+    pub restore_result: Option<String>,
+    pub categories: ValorantCategorySummary,
+    pub unsupported_settings: Vec<String>,
+    pub parse_errors: Vec<String>,
+    pub write_errors: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValorantCommandResponse {
+    state: String,
+    message: String,
+    details: Vec<String>,
+    retryable: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    payload: Option<ValorantPayload>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    diagnostics: Option<ValorantDiagnostics>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    backup_token: Option<String>,
+}
+
+impl ValorantCommandResponse {
+    fn unsupported(message: &str) -> Self {
+        Self {
+            state: "unsupported".into(),
+            message: message.into(),
+            details: vec![],
+            retryable: false,
+            payload: None,
+            diagnostics: None,
+            backup_token: None,
+        }
+    }
+    fn error(
+        message: impl Into<String>,
+        details: Vec<String>,
+        retryable: bool,
+        diagnostics: Option<ValorantDiagnostics>,
+    ) -> Self {
+        Self {
+            state: "error".into(),
+            message: message.into(),
+            details,
+            retryable,
+            payload: None,
+            diagnostics,
+            backup_token: None,
+        }
+    }
+}
+
+pub fn license_denied(message: String) -> ValorantCommandResponse {
+    ValorantCommandResponse {
+        state: "error".into(),
+        message,
+        details: vec!["DEVICE_LICENSE_REQUIRED".into()],
+        retryable: true,
+        payload: None,
+        diagnostics: None,
+        backup_token: None,
+    }
+}
+
+fn safe_file_id(value: &str) -> bool {
+    ALLOWED_FILES
+        .iter()
+        .any(|name| name.eq_ignore_ascii_case(value))
+        && !value.contains("..")
+        && !value.starts_with(['/', '\\'])
+        && !value.ends_with(['/', '\\'])
+}
+
+fn forbidden_entry(section: &str, key: &str, value: &str) -> bool {
+    let name = format!("{section} {key}").to_ascii_lowercase();
+    let data = value.to_ascii_lowercase();
+    [
+        "password",
+        "token",
+        "cookie",
+        "session",
+        "authorization",
+        "accountid",
+        "userid",
+        "puuid",
+        "riotid",
+        "email",
+        "login",
+        "machineid",
+        "deviceid",
+        "monitorid",
+        "monitorname",
+        "gpuadapter",
+        "graphicsadapter",
+        "audiooutputdevice",
+        "audioinputdevice",
+        "voicedevice",
+        "preferredmonitor",
+        "windowpos",
+        "benchmarkresult",
+        "lastrecommended",
+    ]
+    .iter()
+    .any(|marker| name.contains(marker))
+        || [
+            "access_token",
+            "refresh_token",
+            "bearer ",
+            "authorization:",
+            "cookie:",
+        ]
+        .iter()
+        .any(|marker| data.contains(marker))
+}
+
+fn categories_for(file: &str, section: &str, key: &str, value: &str) -> Vec<String> {
+    let text = format!("{file} {section} {key} {value}").to_ascii_lowercase();
+    let mut result = BTreeSet::new();
+    let mut add = |name: &str, needles: &[&str]| {
+        if needles.iter().any(|needle| text.contains(needle)) {
+            result.insert(name.to_string());
+        }
+    };
+    add(
+        "graphics",
+        &[
+            "resolution",
+            "fullscreen",
+            "window",
+            "vsync",
+            "framerate",
+            "fps",
+            "materialquality",
+            "texturequality",
+            "detailquality",
+            "uiquality",
+            "bloom",
+            "anisotropic",
+            "distortion",
+            "reflex",
+            "gamma",
+            "quality",
+            "letterbox",
+            "shadow",
+            "scalability",
+            "render",
+        ],
+    );
+    add(
+        "crosshair",
+        &[
+            "crosshair",
+            "reticle",
+            "outline",
+            "centerdot",
+            "innerline",
+            "outerline",
+        ],
+    );
+    add(
+        "keybinds",
+        &[
+            "keybind",
+            "binding",
+            "actionmapping",
+            "keymapping",
+            "axismapping",
+            "inputkey",
+        ],
+    );
+    add(
+        "audio",
+        &["audio", "sound", "volume", "voice", "music", "mic"],
+    );
+    add(
+        "gameplay",
+        &[
+            "sensitivity",
+            "mouse",
+            "aim",
+            "scope",
+            "minimap",
+            "enemyhighlight",
+            "movement",
+            "toggle",
+            "hold",
+        ],
+    );
+    if result.is_empty() && file.eq_ignore_ascii_case(RIOT_FILE) {
+        result.insert("gameplay".into());
+    }
+    result.into_iter().collect()
+}
+
+fn entry_allowed(file: &str, section: &str, key: &str, value: &str) -> bool {
+    if forbidden_entry(section, key, value) {
+        return false;
+    }
+    let section = section.to_ascii_lowercase();
+    if file.eq_ignore_ascii_case(GAME_FILE) {
+        return section.contains("gameusersettings") || section.contains("scalabilitygroups");
+    }
+    file.eq_ignore_ascii_case(RIOT_FILE) && section == "settings"
+}
+
+pub fn parse_portable_ini(
+    file: &str,
+    text: &str,
+) -> Result<(Vec<ValorantIniEntry>, usize), String> {
+    if !safe_file_id(file) {
+        return Err("Unsafe VALORANT configuration file identifier.".into());
+    }
+    if text.contains('\0') {
+        return Err(format!("{file} contains a NUL byte."));
+    }
+    let mut section = String::new();
+    let mut entries = vec![];
+    let mut excluded = 0;
+    for (index, raw) in text.lines().enumerate() {
+        if raw.len() > MAX_VALUE_BYTES {
+            return Err(format!(
+                "{file} line {} exceeds the safe size limit.",
+                index + 1
+            ));
+        }
+        let line = raw.trim();
+        if line.is_empty() || line.starts_with(';') || line.starts_with('#') {
+            continue;
+        }
+        if line.starts_with('[') && line.ends_with(']') {
+            section = line[1..line.len() - 1].trim().to_string();
+            if section.is_empty() || section.len() > 512 {
+                return Err(format!(
+                    "Malformed section in {file} at line {}.",
+                    index + 1
+                ));
+            }
+            continue;
+        }
+        let Some((raw_key, value)) = line.split_once('=') else {
+            continue;
+        };
+        let raw_key = raw_key.trim();
+        let (operator, key) = match raw_key.chars().next() {
+            Some(character @ ('+' | '-' | '!' | '.')) => (
+                character.to_string(),
+                raw_key[character.len_utf8()..].trim(),
+            ),
+            _ => (String::new(), raw_key),
+        };
+        if section.is_empty() || key.is_empty() || key.len() > 512 {
+            return Err(format!("Malformed key in {file} at line {}.", index + 1));
+        }
+        let value = value.trim();
+        if !entry_allowed(file, &section, key, value) {
+            excluded += 1;
+            continue;
+        }
+        entries.push(ValorantIniEntry {
+            section: section.clone(),
+            key: key.into(),
+            operator,
+            value: value.into(),
+            categories: categories_for(file, &section, key, value),
+        });
+        if entries.len() > MAX_ENTRIES {
+            return Err(format!("{file} contains too many portable settings."));
+        }
+    }
+    Ok((entries, excluded))
+}
+
+fn canonical_entries(entries: &[ValorantIniEntry]) -> String {
+    entries
+        .iter()
+        .map(|entry| {
+            format!(
+                "[{}]\n{}{}={}\n",
+                entry.section, entry.operator, entry.key, entry.value
+            )
+        })
+        .collect()
+}
+
+fn file_hash(entries: &[ValorantIniEntry]) -> String {
+    format!(
+        "{:x}",
+        Sha256::digest(canonical_entries(entries).as_bytes())
+    )
+}
+
+pub fn summarize(files: &[ValorantConfigFile]) -> ValorantCategorySummary {
+    let mut result = ValorantCategorySummary::default();
+    for category in files
+        .iter()
+        .flat_map(|file| &file.entries)
+        .flat_map(|entry| &entry.categories)
+    {
+        match category.as_str() {
+            "gameplay" => result.gameplay += 1,
+            "keybinds" => result.keybinds += 1,
+            "graphics" => result.graphics += 1,
+            "audio" => result.audio += 1,
+            "crosshair" => result.crosshair += 1,
+            _ => {}
+        }
+    }
+    result
+}
+
+fn normalized(files: &[ValorantConfigFile]) -> ValorantNormalizedSettings {
+    let entries = files
+        .iter()
+        .find(|file| file.relative_id.eq_ignore_ascii_case(GAME_FILE))
+        .map(|file| file.entries.as_slice())
+        .unwrap_or_default();
+    let number = |name: &str| {
+        entries
+            .iter()
+            .rev()
+            .find(|entry| entry.key.eq_ignore_ascii_case(name))
+            .and_then(|entry| entry.value.trim_matches('"').parse::<u32>().ok())
+    };
+    let mode = number("FullscreenMode").or_else(|| number("LastConfirmedFullscreenMode"));
+    ValorantNormalizedSettings {
+        width: number("ResolutionSizeX").or_else(|| number("LastUserConfirmedResolutionSizeX")),
+        height: number("ResolutionSizeY").or_else(|| number("LastUserConfirmedResolutionSizeY")),
+        display_mode: match mode {
+            Some(0) => "fullscreen",
+            Some(1) => "borderless",
+            Some(2) => "windowed",
+            _ => "unknown",
+        }
+        .into(),
+    }
+}
+
+pub fn validate_payload(payload: &ValorantPayload) -> Result<(), String> {
+    if payload.schema_version != SCHEMA_VERSION || payload.game != "valorant" {
+        return Err("Unsupported or corrupted VALORANT snapshot.".into());
+    }
+    if payload.files.is_empty() || payload.files.len() > MAX_FILES {
+        return Err("VALORANT snapshot has an invalid file count.".into());
+    }
+    let mut seen = BTreeSet::new();
+    let mut entries = 0;
+    let mut bytes = 0;
+    for file in &payload.files {
+        if !safe_file_id(&file.relative_id) || !seen.insert(file.relative_id.to_ascii_lowercase()) {
+            return Err(
+                "VALORANT snapshot contains an unsafe or duplicate file identifier.".into(),
+            );
+        }
+        entries += file.entries.len();
+        bytes += canonical_entries(&file.entries).len();
+        if entries > MAX_ENTRIES
+            || bytes > MAX_SNAPSHOT_BYTES
+            || file.entries.iter().any(|entry| {
+                entry.section.is_empty()
+                    || entry.key.is_empty()
+                    || entry.value.len() > MAX_VALUE_BYTES
+                    || !entry_allowed(&file.relative_id, &entry.section, &entry.key, &entry.value)
+            })
+        {
+            return Err("VALORANT snapshot contains unsafe or malformed settings.".into());
+        }
+        if file.sha256 != file_hash(&file.entries) {
+            return Err("VALORANT snapshot integrity check failed.".into());
+        }
+    }
+    Ok(())
+}
+
+fn is_valorant_process_name(name: &str) -> bool {
+    [
+        "VALORANT-Win64-Shipping.exe",
+        "VALORANT.exe",
+        "ShooterGame.exe",
+    ]
+    .iter()
+    .any(|expected| expected.eq_ignore_ascii_case(name))
+}
+
+pub fn merge_ini(current: &str, saved: &[ValorantIniEntry]) -> Result<String, String> {
+    if current.contains('\0') {
+        return Err("Target VALORANT config contains a NUL byte.".into());
+    }
+    let keys = saved
+        .iter()
+        .map(|entry| {
+            (
+                entry.section.to_ascii_lowercase(),
+                entry.key.to_ascii_lowercase(),
+            )
+        })
+        .collect::<BTreeSet<_>>();
+    let mut section = String::new();
+    let mut output = vec![];
+    for raw in current.lines() {
+        let line = raw.trim();
+        if line.starts_with('[') && line.ends_with(']') {
+            section = line[1..line.len() - 1].trim().to_ascii_lowercase();
+            output.push(raw.to_string());
+            continue;
+        }
+        if let Some((raw_key, _)) = line.split_once('=') {
+            let key = raw_key
+                .trim()
+                .trim_start_matches(['+', '-', '!', '.'])
+                .trim()
+                .to_ascii_lowercase();
+            if keys.contains(&(section.clone(), key)) {
+                continue;
+            }
+        }
+        output.push(raw.to_string());
+    }
+    let mut grouped: BTreeMap<&str, Vec<&ValorantIniEntry>> = BTreeMap::new();
+    for entry in saved {
+        grouped.entry(&entry.section).or_default().push(entry);
+    }
+    output.push(String::new());
+    output.push("; FastPlay portable VALORANT settings".into());
+    for (section, entries) in grouped {
+        output.push(format!("[{section}]"));
+        for entry in entries {
+            output.push(format!("{}{}={}", entry.operator, entry.key, entry.value));
+        }
+    }
+    Ok(format!("{}\r\n", output.join("\r\n")))
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn capture() -> ValorantCommandResponse {
+    ValorantCommandResponse::unsupported(
+        "VALORANT settings are supported only in the Windows desktop application.",
+    )
+}
+#[cfg(not(target_os = "windows"))]
+pub fn apply(_payload: ValorantPayload) -> ValorantCommandResponse {
+    ValorantCommandResponse::unsupported(
+        "VALORANT settings are supported only in the Windows desktop application.",
+    )
+}
+#[cfg(not(target_os = "windows"))]
+pub fn preflight() -> ValorantCommandResponse {
+    ValorantCommandResponse::unsupported(
+        "VALORANT preflight is supported only in the Windows desktop application.",
+    )
+}
+#[cfg(not(target_os = "windows"))]
+pub fn restore(_backup_token: Option<String>) -> ValorantCommandResponse {
+    ValorantCommandResponse::unsupported(
+        "VALORANT restore is supported only in the Windows desktop application.",
+    )
+}
+#[cfg(not(target_os = "windows"))]
+pub fn diagnostics() -> ValorantCommandResponse {
+    ValorantCommandResponse::unsupported(
+        "VALORANT diagnostics are supported only in the Windows desktop application.",
+    )
+}
+
+#[cfg(target_os = "windows")]
+mod windows {
+    use super::*;
+    use base64::{engine::general_purpose::STANDARD as BASE64, Engine};
+    use chrono::Utc;
+    use std::{
+        env,
+        ffi::OsStr,
+        fs,
+        mem::{size_of, zeroed},
+        os::windows::ffi::OsStrExt,
+        path::{Path, PathBuf},
+        sync::{Mutex, OnceLock},
+        time::{SystemTime, UNIX_EPOCH},
+    };
+    use windows_sys::Win32::{
+        Foundation::{CloseHandle, INVALID_HANDLE_VALUE},
+        Storage::FileSystem::{MoveFileExW, MOVEFILE_REPLACE_EXISTING, MOVEFILE_WRITE_THROUGH},
+        System::Diagnostics::ToolHelp::{
+            CreateToolhelp32Snapshot, Process32FirstW, Process32NextW, PROCESSENTRY32W,
+            TH32CS_SNAPPROCESS,
+        },
+    };
+
+    #[derive(Default, Clone)]
+    struct LastResults {
+        capture: Option<String>,
+        apply: Option<String>,
+        backup: Option<String>,
+        restore: Option<String>,
+        parse: Vec<String>,
+        write: Vec<String>,
+        categories: ValorantCategorySummary,
+    }
+    static LAST: OnceLock<Mutex<LastResults>> = OnceLock::new();
+    fn last() -> &'static Mutex<LastResults> {
+        LAST.get_or_init(|| Mutex::new(LastResults::default()))
+    }
+
+    #[derive(Serialize, Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct BackupFile {
+        relative_id: String,
+        existed: bool,
+        content_base64: String,
+        sha256: String,
+    }
+    #[derive(Serialize, Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Backup {
+        schema_version: u32,
+        captured_at: String,
+        target_directory: String,
+        files: Vec<BackupFile>,
+    }
+
+    pub fn preflight() -> ValorantCommandResponse {
+        if let Err(message) = ensure_game_closed() {
+            return ValorantCommandResponse::error(message, vec!["Закройте VALORANT и нажмите «Повторить проверку». Riot Client можно оставить открытым.".into()], true, Some(current_diagnostics()));
+        }
+        ValorantCommandResponse {
+            state: "success".into(),
+            message: "VALORANT закрыт. Настройки можно изменять безопасно.".into(),
+            details: vec![],
+            retryable: false,
+            payload: None,
+            diagnostics: Some(current_diagnostics()),
+            backup_token: None,
+        }
+    }
+
+    pub fn capture() -> ValorantCommandResponse {
+        if let Err(message) = ensure_game_closed() {
+            return ValorantCommandResponse::error(
+                message,
+                vec![],
+                true,
+                Some(current_diagnostics()),
+            );
+        }
+        let (directory, candidates) = match config_directory() {
+            Ok(value) => value,
+            Err(message) => {
+                return ValorantCommandResponse::error(
+                    message,
+                    vec!["Запустите VALORANT хотя бы один раз, закройте игру и повторите.".into()],
+                    true,
+                    Some(current_diagnostics()),
+                )
+            }
+        };
+        let mut files = vec![];
+        let mut warnings = vec![];
+        let mut errors = vec![];
+        if candidates > 1 {
+            warnings.push(
+                "Найдено несколько локальных профилей Riot; использованы самые свежие настройки."
+                    .into(),
+            );
+        }
+        for name in ALLOWED_FILES {
+            if let Err(message) = ensure_game_closed() {
+                errors.push(message);
+                break;
+            }
+            let path = join_relative(&directory, name);
+            if !path.is_file() {
+                warnings.push(format!("Optional file not found: {name}"));
+                continue;
+            }
+            match fs::read_to_string(&path)
+                .map_err(|error| error.to_string())
+                .and_then(|text| parse_portable_ini(name, &text))
+            {
+                Ok((entries, excluded)) => {
+                    if excluded > 0 {
+                        warnings.push(format!("{name}: исключено небезопасных или аппаратно-зависимых значений: {excluded}."));
+                    }
+                    if entries.is_empty() {
+                        warnings.push(format!("{name}: переносимые настройки не найдены."));
+                    } else {
+                        files.push(ValorantConfigFile {
+                            relative_id: name.into(),
+                            sha256: file_hash(&entries),
+                            entries,
+                        });
+                    }
+                }
+                Err(error) => errors.push(error),
+            }
+        }
+        if !errors.is_empty() || files.is_empty() {
+            if let Ok(mut state) = last().lock() {
+                state.capture = Some("error".into());
+                state.parse = errors.clone();
+            }
+            return ValorantCommandResponse::error(
+                "Не удалось безопасно считать настройки VALORANT.",
+                errors,
+                true,
+                Some(current_diagnostics()),
+            );
+        }
+        let categories = summarize(&files);
+        let normalized = normalized(&files);
+        for (name, count) in [
+            ("графика", categories.graphics),
+            ("управление", categories.gameplay),
+            ("клавиши", categories.keybinds),
+            ("звук", categories.audio),
+            ("прицел", categories.crosshair),
+        ] {
+            if count == 0 {
+                warnings.push(format!(
+                    "В текущих файлах не удалось подтвердить категорию: {name}."
+                ));
+            }
+        }
+        let payload = ValorantPayload {
+            schema_version: SCHEMA_VERSION,
+            captured_at: Utc::now().to_rfc3339(),
+            game: "valorant".into(),
+            files,
+            normalized,
+            captured_categories: categories.clone(),
+            unsupported_categories: vec![
+                "Riot Client login, tokens and account identifiers".into(),
+                "Vanguard and anti-cheat state".into(),
+                "monitor/GPU/audio device identifiers".into(),
+            ],
+            warnings: warnings.clone(),
+        };
+        if let Ok(mut state) = last().lock() {
+            state.capture = Some(
+                if warnings.is_empty() {
+                    "success"
+                } else {
+                    "warning"
+                }
+                .into(),
+            );
+            state.parse.clear();
+            state.categories = categories.clone();
+        }
+        ValorantCommandResponse {
+            state: if warnings.is_empty() {
+                "success"
+            } else {
+                "warning"
+            }
+            .into(),
+            message: "Настройки VALORANT считаны из реальных файлов Windows.".into(),
+            details: category_details(&categories, &warnings),
+            retryable: !warnings.is_empty(),
+            payload: Some(payload),
+            diagnostics: Some(current_diagnostics()),
+            backup_token: None,
+        }
+    }
+
+    pub fn apply(payload: ValorantPayload) -> ValorantCommandResponse {
+        if let Err(message) = ensure_game_closed() {
+            return ValorantCommandResponse::error(
+                message,
+                vec![],
+                true,
+                Some(current_diagnostics()),
+            );
+        }
+        if let Err(message) = validate_payload(&payload) {
+            return ValorantCommandResponse::error(
+                message,
+                vec![],
+                false,
+                Some(current_diagnostics()),
+            );
+        }
+        let (directory, _) = match config_directory() {
+            Ok(value) => value,
+            Err(message) => {
+                return ValorantCommandResponse::error(
+                    message,
+                    vec!["Сначала запустите VALORANT один раз на этом компьютере.".into()],
+                    true,
+                    Some(current_diagnostics()),
+                )
+            }
+        };
+        let backup_path = match write_backup(&directory) {
+            Ok(value) => value,
+            Err(message) => {
+                return ValorantCommandResponse::error(
+                    message,
+                    vec![],
+                    true,
+                    Some(current_diagnostics()),
+                )
+            }
+        };
+        if let Ok(mut state) = last().lock() {
+            state.backup = Some(backup_path.display().to_string());
+            state.write.clear();
+        }
+        let mut applied = 0;
+        let mut errors = vec![];
+        for file in &payload.files {
+            if let Err(message) = ensure_game_closed() {
+                errors.push(message);
+                break;
+            }
+            let target = join_relative(&directory, &file.relative_id);
+            if let Some(parent) = target.parent() {
+                if let Err(error) = fs::create_dir_all(parent) {
+                    errors.push(format!("{}: {error}", file.relative_id));
+                    continue;
+                }
+            }
+            let current = if target.exists() {
+                match fs::read_to_string(&target) {
+                    Ok(value) => value,
+                    Err(error) => {
+                        errors.push(format!("{}: {error}", file.relative_id));
+                        continue;
+                    }
+                }
+            } else {
+                String::new()
+            };
+            let merged = match merge_ini(&current, &file.entries) {
+                Ok(value) => value,
+                Err(error) => {
+                    errors.push(error);
+                    continue;
+                }
+            };
+            if let Err(error) = atomic_write(&target, merged.as_bytes()) {
+                errors.push(format!("{}: {error}", file.relative_id));
+                continue;
+            }
+            match fs::read_to_string(&target)
+                .map_err(|error| error.to_string())
+                .and_then(|text| parse_portable_ini(&file.relative_id, &text))
+            {
+                Ok((entries, _)) if entries_multiset_contains(&entries, &file.entries) => {
+                    applied += 1
+                }
+                Ok(_) => errors.push(format!(
+                    "{}: повторная проверка не совпала со снимком.",
+                    file.relative_id
+                )),
+                Err(error) => errors.push(format!(
+                    "{}: verification failed: {error}",
+                    file.relative_id
+                )),
+            }
+        }
+        if !errors.is_empty() {
+            let rollback = restore_path(&backup_path)
+                .map(|_| "Автоматический откат VALORANT выполнен.".to_string())
+                .unwrap_or_else(|error| {
+                    format!("Автоматический откат VALORANT не выполнен: {error}")
+                });
+            if let Ok(mut state) = last().lock() {
+                state.apply = Some("error".into());
+                state.write = errors.clone();
+            }
+            return ValorantCommandResponse {
+                state: "error".into(),
+                message: "Настройки VALORANT применены не полностью; выполнена попытка отката."
+                    .into(),
+                details: errors.into_iter().chain([rollback]).collect(),
+                retryable: true,
+                payload: None,
+                diagnostics: Some(current_diagnostics()),
+                backup_token: Some(backup_path.display().to_string()),
+            };
+        }
+        if let Ok(mut state) = last().lock() {
+            state.apply = Some("success".into());
+            state.write.clear();
+            state.categories = payload.captured_categories.clone();
+        }
+        ValorantCommandResponse {
+            state: "success".into(),
+            message: "Настройки VALORANT записаны и подтверждены повторным чтением.".into(),
+            details: vec![
+                format!("Применено файлов: {applied}"),
+                format!(
+                    "Графика: {} · Управление: {} · Клавиши: {} · Звук: {} · Прицел: {}",
+                    payload.captured_categories.graphics,
+                    payload.captured_categories.gameplay,
+                    payload.captured_categories.keybinds,
+                    payload.captured_categories.audio,
+                    payload.captured_categories.crosshair
+                ),
+            ],
+            retryable: false,
+            payload: None,
+            diagnostics: Some(current_diagnostics()),
+            backup_token: Some(backup_path.display().to_string()),
+        }
+    }
+
+    pub fn restore(backup_token: Option<String>) -> ValorantCommandResponse {
+        if let Err(message) = ensure_game_closed() {
+            return ValorantCommandResponse::error(
+                message,
+                vec![],
+                true,
+                Some(current_diagnostics()),
+            );
+        }
+        let Some(token) = backup_token else {
+            return ValorantCommandResponse::error(
+                "Резервная копия VALORANT не указана.",
+                vec![],
+                false,
+                Some(current_diagnostics()),
+            );
+        };
+        let path = PathBuf::from(token);
+        if !safe_backup_path(&path) {
+            return ValorantCommandResponse::error(
+                "Недопустимый путь резервной копии VALORANT.",
+                vec![],
+                false,
+                Some(current_diagnostics()),
+            );
+        }
+        match restore_path(&path) {
+            Ok(count) => {
+                if let Ok(mut state) = last().lock() {
+                    state.restore = Some("success".into());
+                }
+                ValorantCommandResponse {
+                    state: "success".into(),
+                    message: "Точная резервная копия VALORANT восстановлена.".into(),
+                    details: vec![format!("Восстановлено файлов: {count}")],
+                    retryable: false,
+                    payload: None,
+                    diagnostics: Some(current_diagnostics()),
+                    backup_token: Some(path.display().to_string()),
+                }
+            }
+            Err(message) => {
+                if let Ok(mut state) = last().lock() {
+                    state.restore = Some("error".into());
+                    state.write.push(message.clone());
+                }
+                ValorantCommandResponse::error(message, vec![], true, Some(current_diagnostics()))
+            }
+        }
+    }
+
+    pub fn diagnostics() -> ValorantCommandResponse {
+        let diagnostics = current_diagnostics();
+        ValorantCommandResponse {
+            state: if diagnostics.valorant_detected {
+                "success"
+            } else {
+                "warning"
+            }
+            .into(),
+            message: if diagnostics.valorant_detected {
+                "Конфигурация VALORANT найдена."
+            } else {
+                "Конфигурация VALORANT ещё не найдена. Запустите игру хотя бы один раз."
+            }
+            .into(),
+            details: vec![],
+            retryable: !diagnostics.valorant_detected,
+            payload: None,
+            diagnostics: Some(diagnostics),
+            backup_token: None,
+        }
+    }
+
+    fn config_root() -> Result<PathBuf, String> {
+        env::var_os("LOCALAPPDATA")
+            .map(PathBuf::from)
+            .map(|path| path.join("VALORANT").join("Saved").join("Config"))
+            .ok_or_else(|| "Windows LOCALAPPDATA is unavailable.".into())
+    }
+
+    fn config_directory() -> Result<(PathBuf, usize), String> {
+        let root = config_root()?;
+        let mut candidates = vec![];
+        for entry in fs::read_dir(&root)
+            .map_err(|_| "Локальные настройки VALORANT не найдены.".to_string())?
+            .filter_map(Result::ok)
+        {
+            let path = entry.path();
+            if !path.is_dir() {
+                continue;
+            }
+            let game = path.join("WindowsClient").join("GameUserSettings.ini");
+            let riot = path.join("Windows").join("RiotUserSettings.ini");
+            if !game.is_file() && !riot.is_file() {
+                continue;
+            }
+            let modified = [game, riot]
+                .iter()
+                .filter_map(|file| file.metadata().ok()?.modified().ok())
+                .max()
+                .unwrap_or(UNIX_EPOCH);
+            candidates.push((modified, path));
+        }
+        candidates.sort_by(|a, b| b.0.cmp(&a.0));
+        let count = candidates.len();
+        candidates
+            .into_iter()
+            .next()
+            .map(|(_, path)| (path, count))
+            .ok_or_else(|| "Локальные настройки VALORANT не найдены.".into())
+    }
+
+    fn join_relative(directory: &Path, relative: &str) -> PathBuf {
+        relative
+            .split('/')
+            .fold(directory.to_path_buf(), |path, component| {
+                path.join(component)
+            })
+    }
+
+    fn current_diagnostics() -> ValorantDiagnostics {
+        let selected = config_directory().ok();
+        let directory = selected.as_ref().map(|value| &value.0);
+        let files = directory
+            .map(|root| {
+                ALLOWED_FILES
+                    .iter()
+                    .filter(|file| join_relative(root, file).is_file())
+                    .map(|file| (*file).to_string())
+                    .collect()
+            })
+            .unwrap_or_default();
+        let state = last().lock().map(|value| value.clone()).unwrap_or_default();
+        ValorantDiagnostics {
+            valorant_detected: directory.is_some(),
+            config_directory: directory.map(|path| path.display().to_string()),
+            config_files_found: files,
+            candidate_profiles: selected.map(|value| value.1).unwrap_or(0),
+            process_running: game_running().unwrap_or(true),
+            capture_result: state.capture,
+            apply_result: state.apply,
+            backup_result: state.backup,
+            restore_result: state.restore,
+            categories: state.categories,
+            unsupported_settings: vec![
+                "Riot login/tokens".into(),
+                "Vanguard".into(),
+                "hardware identifiers".into(),
+            ],
+            parse_errors: state.parse,
+            write_errors: state.write,
+        }
+    }
+
+    fn ensure_game_closed() -> Result<(), String> {
+        match game_running() {
+            Ok(false) => Ok(()),
+            Ok(true) => Err(
+                "VALORANT запущен. Полностью закройте игру; Riot Client можно оставить открытым."
+                    .into(),
+            ),
+            Err(error) => Err(format!(
+                "Не удалось безопасно проверить процесс VALORANT: {error}"
+            )),
+        }
+    }
+
+    fn game_running() -> Result<bool, String> {
+        unsafe {
+            let snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+            if snapshot == INVALID_HANDLE_VALUE {
+                return Err("process snapshot failed".into());
+            }
+            let mut entry: PROCESSENTRY32W = zeroed();
+            entry.dwSize = size_of::<PROCESSENTRY32W>() as u32;
+            let mut running = false;
+            if Process32FirstW(snapshot, &mut entry) == 0 {
+                CloseHandle(snapshot);
+                return Err("process enumeration failed".into());
+            }
+            loop {
+                let length = entry
+                    .szExeFile
+                    .iter()
+                    .position(|value| *value == 0)
+                    .unwrap_or(entry.szExeFile.len());
+                let name = String::from_utf16_lossy(&entry.szExeFile[..length]);
+                if is_valorant_process_name(&name) {
+                    running = true;
+                    break;
+                }
+                if Process32NextW(snapshot, &mut entry) == 0 {
+                    break;
+                }
+            }
+            CloseHandle(snapshot);
+            Ok(running)
+        }
+    }
+
+    fn backup_root() -> Result<PathBuf, String> {
+        env::var_os("LOCALAPPDATA")
+            .map(PathBuf::from)
+            .map(|path| path.join("FastPlay").join("Backups").join("VALORANT"))
+            .ok_or_else(|| "Windows LOCALAPPDATA is unavailable.".into())
+    }
+
+    fn write_backup(directory: &Path) -> Result<PathBuf, String> {
+        let root = backup_root()?;
+        fs::create_dir_all(&root)
+            .map_err(|error| format!("Could not create VALORANT backup directory: {error}"))?;
+        let mut files = vec![];
+        for relative in ALLOWED_FILES {
+            let path = join_relative(directory, relative);
+            let existed = path.is_file();
+            let bytes = if existed {
+                fs::read(&path).map_err(|error| format!("Could not back up {relative}: {error}"))?
+            } else {
+                vec![]
+            };
+            files.push(BackupFile {
+                relative_id: relative.into(),
+                existed,
+                content_base64: BASE64.encode(&bytes),
+                sha256: format!("{:x}", Sha256::digest(&bytes)),
+            });
+        }
+        let backup = Backup {
+            schema_version: 1,
+            captured_at: Utc::now().to_rfc3339(),
+            target_directory: directory.display().to_string(),
+            files,
+        };
+        let stamp = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|error| error.to_string())?
+            .as_millis();
+        let path = root.join(format!("valorant-{stamp}.json"));
+        let bytes = serde_json::to_vec_pretty(&backup).map_err(|error| error.to_string())?;
+        atomic_write(&path, &bytes)?;
+        Ok(path)
+    }
+
+    fn restore_path(path: &Path) -> Result<usize, String> {
+        if !safe_backup_path(path) {
+            return Err("Unsafe VALORANT backup path.".into());
+        }
+        let bytes =
+            fs::read(path).map_err(|error| format!("Could not read VALORANT backup: {error}"))?;
+        let backup: Backup = serde_json::from_slice(&bytes)
+            .map_err(|error| format!("Invalid VALORANT backup: {error}"))?;
+        if backup.schema_version != 1 {
+            return Err("Unsupported VALORANT backup version.".into());
+        }
+        let directory = PathBuf::from(&backup.target_directory);
+        let expected = config_root()?
+            .canonicalize()
+            .map_err(|error| error.to_string())?;
+        let candidate = directory
+            .canonicalize()
+            .map_err(|error| error.to_string())?;
+        if !candidate.starts_with(expected) {
+            return Err("VALORANT backup targets an unsafe directory.".into());
+        }
+        let mut restored = 0;
+        for file in backup.files {
+            if !safe_file_id(&file.relative_id) {
+                return Err("VALORANT backup contains an unsafe file.".into());
+            }
+            let data = BASE64
+                .decode(file.content_base64)
+                .map_err(|error| error.to_string())?;
+            if format!("{:x}", Sha256::digest(&data)) != file.sha256 {
+                return Err("VALORANT backup integrity check failed.".into());
+            }
+            let target = join_relative(&directory, &file.relative_id);
+            if file.existed {
+                if let Some(parent) = target.parent() {
+                    fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+                }
+                atomic_write(&target, &data)?;
+            } else if target.exists() {
+                fs::remove_file(&target).map_err(|error| error.to_string())?;
+            }
+            restored += 1;
+        }
+        Ok(restored)
+    }
+
+    fn safe_backup_path(path: &Path) -> bool {
+        let Ok(root) = backup_root() else {
+            return false;
+        };
+        path.extension()
+            .and_then(OsStr::to_str)
+            .map(|value| value.eq_ignore_ascii_case("json"))
+            .unwrap_or(false)
+            && path.parent().map(|parent| parent == root).unwrap_or(false)
+    }
+
+    fn atomic_write(path: &Path, data: &[u8]) -> Result<(), String> {
+        let parent = path
+            .parent()
+            .ok_or("Target file has no parent directory.")?;
+        fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+        let temp = parent.join(format!(
+            ".fastplay-{}.tmp",
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map_err(|error| error.to_string())?
+                .as_nanos()
+        ));
+        fs::write(&temp, data).map_err(|error| error.to_string())?;
+        let source: Vec<u16> = OsStr::new(&temp).encode_wide().chain([0]).collect();
+        let target: Vec<u16> = OsStr::new(path).encode_wide().chain([0]).collect();
+        let result = unsafe {
+            MoveFileExW(
+                source.as_ptr(),
+                target.as_ptr(),
+                MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+            )
+        };
+        if result == 0 {
+            let error = std::io::Error::last_os_error();
+            let _ = fs::remove_file(&temp);
+            return Err(error.to_string());
+        }
+        Ok(())
+    }
+
+    fn entries_multiset_contains(
+        actual: &[ValorantIniEntry],
+        expected: &[ValorantIniEntry],
+    ) -> bool {
+        let counts = |entries: &[ValorantIniEntry]| {
+            let mut result = BTreeMap::new();
+            for entry in entries {
+                *result
+                    .entry((
+                        entry.section.to_ascii_lowercase(),
+                        entry.key.to_ascii_lowercase(),
+                        entry.operator.clone(),
+                        entry.value.clone(),
+                    ))
+                    .or_insert(0usize) += 1;
+            }
+            result
+        };
+        let actual = counts(actual);
+        counts(expected)
+            .into_iter()
+            .all(|(key, count)| actual.get(&key).copied().unwrap_or(0) >= count)
+    }
+
+    fn category_details(categories: &ValorantCategorySummary, warnings: &[String]) -> Vec<String> {
+        let mut details = vec![format!(
+            "Графика: {} · Управление: {} · Клавиши: {} · Звук: {} · Прицел: {}",
+            categories.graphics,
+            categories.gameplay,
+            categories.keybinds,
+            categories.audio,
+            categories.crosshair
+        )];
+        details.extend(warnings.iter().cloned());
+        details
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub use windows::{apply, capture, diagnostics, preflight, restore};
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_portable_settings_and_rejects_secrets() {
+        let text = "[/Script/ShooterGame.ShooterGameUserSettings]\nResolutionSizeX=1920\nResolutionSizeY=1080\nFullscreenMode=0\nAuthToken=secret\n";
+        let (entries, excluded) = parse_portable_ini(GAME_FILE, text).unwrap();
+        assert_eq!(entries.len(), 3);
+        assert_eq!(excluded, 1);
+        assert_eq!(
+            normalized(&[ValorantConfigFile {
+                relative_id: GAME_FILE.into(),
+                sha256: file_hash(&entries),
+                entries
+            }])
+            .display_mode,
+            "fullscreen"
+        );
+    }
+
+    #[test]
+    fn merges_without_overwriting_unrelated_values() {
+        let current = "[Settings]\nKeepMe=1\nEAresIntSettingName::MaterialQuality=3\n";
+        let saved = vec![ValorantIniEntry {
+            section: "Settings".into(),
+            key: "EAresIntSettingName::MaterialQuality".into(),
+            operator: String::new(),
+            value: "1".into(),
+            categories: vec!["graphics".into()],
+        }];
+        let merged = merge_ini(current, &saved).unwrap();
+        assert!(merged.contains("KeepMe=1"));
+        assert!(merged.contains("EAresIntSettingName::MaterialQuality=1"));
+        assert!(!merged.contains("EAresIntSettingName::MaterialQuality=3"));
+    }
+
+    #[test]
+    fn rejects_path_traversal_and_riot_tokens() {
+        assert!(!safe_file_id("../RiotUserSettings.ini"));
+        assert!(forbidden_entry("Settings", "AccessToken", "secret"));
+        assert!(forbidden_entry("Settings", "Safe", "Bearer secret"));
+    }
+
+    #[test]
+    fn detects_known_process_names() {
+        assert!(is_valorant_process_name("VALORANT-Win64-Shipping.exe"));
+        assert!(is_valorant_process_name("valorant.exe"));
+        assert!(!is_valorant_process_name("RiotClientServices.exe"));
+    }
+}
