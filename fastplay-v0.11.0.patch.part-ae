+    fn capture_gamma_ramp() -> Result<NvidiaGammaRamp, String> {
+        let hdc = unsafe { GetDC(std::ptr::null_mut()) };
+        if hdc.is_null() {
+            return Err("Windows could not open the primary display context.".into());
+        }
+        let mut ramp = [[0_u16; 256]; 3];
+        let ok = unsafe { GetDeviceGammaRamp(hdc, ramp.as_mut_ptr().cast()) } != 0;
+        unsafe { ReleaseDC(std::ptr::null_mut(), hdc) };
+        if !ok {
+            return Err("The current display driver did not expose its gamma ramp.".into());
+        }
+        Ok(NvidiaGammaRamp {
+            red: ramp[0].to_vec(),
+            green: ramp[1].to_vec(),
+            blue: ramp[2].to_vec(),
+        })
+    }
+
+    fn apply_and_verify_gamma_ramp(gamma: &NvidiaGammaRamp) -> Result<(), String> {
+        if gamma.red.len() != 256 || gamma.green.len() != 256 || gamma.blue.len() != 256 {
+            return Err("The saved gamma ramp is corrupted.".into());
+        }
+        let mut ramp = [[0_u16; 256]; 3];
+        ramp[0].copy_from_slice(&gamma.red);
+        ramp[1].copy_from_slice(&gamma.green);
+        ramp[2].copy_from_slice(&gamma.blue);
+        let hdc = unsafe { GetDC(std::ptr::null_mut()) };
+        if hdc.is_null() {
+            return Err("Windows could not open the primary display context.".into());
+        }
+        let applied = unsafe { SetDeviceGammaRamp(hdc, ramp.as_ptr().cast()) } != 0;
+        unsafe { ReleaseDC(std::ptr::null_mut(), hdc) };
+        if !applied {
+            return Err("The display driver rejected the saved gamma ramp.".into());
+        }
+        let verified = capture_gamma_ramp()?;
+        if verified.red == gamma.red && verified.green == gamma.green && verified.blue == gamma.blue
+        {
+            Ok(())
+        } else {
+            Err("Windows accepted the gamma ramp, but verification did not match.".into())
+        }
+    }
+
