+            let cfg_audio = "snd_roundstart_volume 0.15\nvoice_modenable 1\n";
+            let mut captured = Vec::new();
+            let mut details = Vec::new();
+            for (scope, name, text, sanitize) in [
+                ("userdata", REQUIRED_CORE[0], user_audio, false),
