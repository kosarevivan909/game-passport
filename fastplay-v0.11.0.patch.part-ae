+            }
+            for file in &captured {
+                let decoded = BASE64.decode(&file.content_base64).unwrap();
+                assert_eq!(decoded.len() as u64, file.size);
+                assert_eq!(format!("{:x}", Sha256::digest(&decoded)), file.sha256);
+                assert!(!String::from_utf8(decoded).unwrap().contains("source-pc"));
+            }
+            fixture.payload.files.retain(|file| {
