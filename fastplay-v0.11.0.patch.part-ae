 Ok(None);
+        }
+        let raw = payload.launch_options.as_deref().unwrap_or("");
+        validate_launch_options(raw)?;
+        let value = normalize_launch_options(raw, profile_display_mode_intent(payload)?);
+        validate_launch_options(&value)?;
+        Ok(Some(value))
+    }
+
+    fn prepare_launch_options_update(
+        payload: &Cs2Payload,
+        context: &SteamContext,
+        steam_running: bool,
+    ) -> Result<LaunchOptionsUpdate, UserFacingError> {
+        let Some(value) = saved_launch_options(payload)? else {
+            return Ok(LaunchOptionsUpdate::NotCaptured);
+        };
+        // No read/write of localconfig.vdf is needed while Steam owns it.
+        if steam_running {
+            return Ok(LaunchOptionsUpdate::Manual(value));
+        }
+        // A missing/new/locked Steam config must not prevent applying game files.
+        let item = (|| {
+            if fs::metadata(&context.localconfig_vdf).ok()?.len() > MAX_LOCALCONFIG_BYTES {
+                return None;
+            }
+            let text = fs::read_to_string(&context.localconfig_vdf).ok()?;
+            let updated = set_launch_options(&text, &value).ok()?;
+            Some(DecodedFile {
+                scope: "steam".into(),
+                relative_path: "localconfig.vdf".into(),
+                target: context.localconfig_vdf.clone(),
+                content: updated.into_bytes(),
+            })
+        })();
+        Ok(match item {
+            Some(item) => LaunchOptionsUpdate::Staged(item),
+            None => LaunchOptionsUpdate::Manual(value),
+        })
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    enum DisplayModeIntent {
+        ExclusiveFullscreen,
+        Other,
+        Unknown,
+    }
+
+    fn display_mode_intent(bytes: &[u8]) -> Result<DisplayModeIntent, UserFacingError> {
+        let values = video_key_values(bytes)?;
+        let fullscreen = values.get("setting.fullscreen").map(String::as_str);
+        let coop_fullscreen = values.get("setting.coop_fullscreen").map(String::as_str);
+        Ok(match fullscreen {
+            Some("1") if coop_fullscreen != Some("1") => DisplayModeIntent::ExclusiveFullscreen,
+            Some(_) => DisplayModeIntent::Other,
+            None => DisplayModeIntent::Unknown,
+        })
+    }
+
+    fn profile_display_mode_intent(
+        payload: &Cs2Payload,
+    ) -> Result<DisplayModeIntent, UserFacingError> {
+        let Some(video) = payload.files.iter().find(|file| {
+            file.scope == "userdata" && file.relative_path.eq_ignore_ascii_case("cs2_video.txt")
+        }) else {
+            return Ok(DisplayModeIntent::Unknown);
+        };
+        let bytes = BASE64.decode(&video.content_base64).map_err(|_| {
+            UserFacingError::new("The saved CS2 profile contains invalid video data.", false)
+        })?;
+        display_mode_intent(&bytes)
+    }
+
+    fn normalize_launch_options(value: &str, display_mode: DisplayModeIntent) -> String {
+        let windowed = ["-windowed", "-window", "-sw", "-startwindowed", "-noborder"];
+        let mut tokens = value
+            .split_whitespace()
+            .filter(|token| {
+                if token.eq_ignore_ascii_case("-fullscreen") {
+                    return display_mode == DisplayModeIntent::Unknown;
+                }
+                display_mode != DisplayModeIntent::ExclusiveFullscreen
+                    || !windowed
+                        .iter()
+                        .any(|blocked| token.eq_ignore_ascii_case(blocked))
+            })
+            .map(str::to_string)
+            .collect::<Vec<_>>();
+        if display_mode == DisplayModeIntent::ExclusiveFullscreen {
+            tokens.push("-fullscreen".into());
+        }
+        tokens.join(" ")
+    }
+
+    fn validate_launch_options(value: &str) -> Result<(), UserFacingError> {
+        if value.len() > MAX_LAUNCH_OPTIONS_BYTES {
+            return Err(UserFacingError::new(
+                "строка не должна превышать 1024 символа.",
+                false,
+            ));
+        }
+        if value.chars().any(|character| {
+            character == '\0' || character == '\r' || character == '\n' || character.is_control()
+        }) {
+            return Err(UserFacingError::new(
+                "строка содержит недопустимые управляющие символы.",
+                false,
+            ));
+        }
+        let lower = value.to_ascii_lowercase();
+        let blocked = [
+            "password", "token", "authkey", "cookie", "+connect", "-connect", "rcon", "setinfo",
+            "apikey", "api_key", "webapi", "://",
+        ];
+        if blocked.iter().any(|marker| lower.contains(marker)) {
+            return Err(UserFacingError::new(
+                "обнаружена команда, которая может содержать адрес сервера, пароль или токен.",
+                false,
+            ));
+        }
+        Ok(())
+    }
+
+    fn find_launch_options(text: &str) -> Option<String> {
+        let (line, _, _) = locate_cs2_vdf_entries(text);
+        line.and_then(|index| quoted_tokens(text.lines().nth(index)?).get(1).cloned())
+    }
+
+    fn set_launch_options(text: &str, value: &str) -> Result<String, UserFacingError> {
+        let (launch_line, block_close, block_indent) = locate_cs2_vdf_entries(text);
+        let newline = if text.contains("\r\n") { "\r\n" } else { "\n" };
+        let mut lines = text.lines().map(str::to_string).collect::<Vec<_>>();
+        let escaped = value.replace('\\', "\\\\").replace('"', "\\\"");
+        if let Some(index) = launch_line {
+            let indent = lines[index]
+                .chars()
+                .take_while(|character| character.is_whitespace())
+                .collect::<String>();
+            lines[index] = format!("{indent}\"LaunchOptions\"\t\t\"{escaped}\"");
+        } else if let Some(index) = block_close {
+            lines.insert(
+                index,
+                format!("{block_indent}\t\"LaunchOptions\"\t\t\"{escaped}\""),
+            );
+        } else if let Some((index, indent)) =
+            locate_vdf_block_close(text, &["Software", "Valve", "Steam", "apps"])
+        {
+            lines.splice(
+                index..index,
+                [
+                    format!("{indent}\t\"730\""),
+                    format!("{indent}\t{{"),
+                    format!("{indent}\t\t\"LaunchOptions\"\t\t\"{escaped}\""),
+                    format!("{indent}\t}}"),
+                ],
+            );
+        } else if let Some((index, indent)) =
+            locate_vdf_block_close(text, &["Software", "Valve", "Steam"])
+        {
+            lines.splice(
+                index..index,
+                [
+                    format!("{indent}\t\"apps\""),
+                    format!("{indent}\t{{"),
+                    format!("{indent}\t\t\"730\""),
+                    format!("{indent}\t\t{{"),
+                    format!("{indent}\t\t\t\"LaunchOptions\"\t\t\"{escaped}\""),
+                    format!("{indent}\t\t}}"),
+                    format!("{indent}\t}}"),
+                ],
+            );
+        } else {
+            return Err(UserFacingError::new(
+                "В локальных настройках Steam не найден базовый раздел Steam; игровые файлы применены без параметров запуска.",
+                true,
+            ));
+        }
+        let mut result = lines.join(newline);
+        if text.ends_with('\n') {
+            result.push_str(newline);
+        }
+        Ok(result)
+    }
+
+    fn locate_cs2_vdf_entries(text: &str) -> (Option<usize>, Option<usize>, String) {
+        const PATH: [&str; 5] = ["Software", "Valve", "Steam", "apps", "730"];
+        let mut stack = Vec::<String>::new();
+        let mut pending = None::<String>;
+        let mut launch_line = None;
+        let mut block_close = None;
+        let mut block_indent = String::new();
+        for (index, line) in text.lines().enumerate() {
+            let tokens = quoted_tokens(line);
+            if path_ends_with(&stack, &PATH)
+                && tokens.len() >= 2
+                && tokens[0].eq_ignore_ascii_case("LaunchOptions")
+            {
+                launch_line = Some(index);
+            }
+            if tokens.len() == 1 {
+                pending = Some(tokens[0].clone());
+            }
+            let (opens, closes) = unquoted_braces(line);
+            for _ in 0..opens {
+                if let Some(key) = pending.take() {
+                    stack.push(key);
+                    if path_ends_with(&stack, &PATH) {
+                        block_indent = line
+                            .chars()
+                            .take_while(|character| character.is_whitespace())
+                            .collect();
+                    }
+                }
+            }
+            for _ in 0..closes {
+                if path_ends_with(&stack, &PATH) {
+                    block_close = Some(index);
+                    block_indent = line
+                        .chars()
+                        .take_while(|character| character.is_whitespace())
+                        .collect();
+                }
+                stack.pop();
+            }
+        }
+        (launch_line, block_close, block_indent)
+    }
+
+    fn locate_vdf_block_close(text: &str, expected: &[&str]) -> Option<(usize, String)> {
+        let mut stack = Vec::<String>::new();
+        let mut pending = None::<String>;
+        for (index, line) in text.lines().enumerate() {
+            let tokens = quoted_tokens(line);
+            if tokens.len() == 1 {
+                pending = Some(tokens[0].clone());
+            }
+            let (opens, closes) = unquoted_braces(line);
+            for _ in 0..opens {
+                if let Some(key) = pending.take() {
+                    stack.push(key);
+                }
+            }
+            for _ in 0..closes {
+                if path_ends_with(&stack, expected) {
+                    let indent = line
+                        .chars()
+                        .take_while(|character| character.is_whitespace())
+                        .collect();
+                    return Some((index, indent));
+                }
+                stack.pop();
+            }
+        }
+        None
+    }
+
+    fn path_ends_with(stack: &[String], expected: &[&str]) -> bool {
+        stack.len() >= expected.len()
+            && stack[stack.len() - expected.len()..]
+                .iter()
+                .zip(expected)
+                .all(|(actual, expected)| actual.eq_ignore_ascii_case(expected))
+    }
+
+    fn unquoted_braces(line: &str) -> (usize, usize) {
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut opens = 0;
+        let mut closes = 0;
+        for character in line.chars() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            if quoted && character == '\\' {
+                escaped = true;
+            } else if character == '"' {
+                quoted = !quoted;
+            } else if !quoted && character == '{' {
+                opens += 1;
+            } else if !quoted && character == '}' {
+                closes += 1;
+            }
+        }
+        (opens, closes)
+    }
