+                if apply_lock::is_active() {
+                    api.prevent_close();
+                }
+            }
+        })
         .invoke_handler(tauri::generate_handler![
             get_platform_info,
             check_cs2_closed,
@@ -163,6 +371,7 @@ pub fn run() {
             restore_display_settings,
             capture_nvidia_settings,
             apply_nvidia_settings,
+            apply_nvidia_display_controls,
             get_nvidia_diagnostics,
             restore_nvidia_settings,
             capture_mouse_settings,
@@ -174,10 +383,28 @@ pub fn run() {
             apply_pubg_settings,
             restore_pubg_settings,
             get_pubg_diagnostics,
+            check_valorant_closed,
+            capture_valorant_settings,
+            apply_valorant_settings,
+            restore_valorant_settings,
+            get_valorant_diagnostics,
+            get_device_identity,
+            sign_device_challenge,
+            accept_device_license_grant,
+            get_cached_device_license,
+            clear_device_license,
+            begin_apply_lock,
+            heartbeat_apply_lock,
+            finish_apply_lock,
+            get_apply_lock_status,
+            clear_interrupted_apply,
+            secure_storage_get,
+            secure_storage_set,
+            secure_storage_remove,
