+fn is_independent_desktop_snapshot(payload: &DisplayPayload) -> bool {
+    payload.schema_version == 2 && payload.capture_source.as_deref() == Some("windows_desktop")
+}
+
+// Only accepts the current mode read from Windows, never CS2/PUBG video settings.
+fn desktop_snapshot(current: &DisplayMode, captured_at: String) -> Result<DisplayPayload, String> {
+    if !(320..=16384).contains(&current.width) || !(200..=16384).contains(&current.height) {
+        return Err(
+            "Windows reported invalid desktop dimensions. No display snapshot was saved.".into(),
+        );
+    }
+    Ok(DisplayPayload {
+        schema_version: 2,
+        capture_source: Some("windows_desktop".into()),
+        captured_at,
+        width: current.width,
+        height: current.height,
+        aspect_ratio: aspect_ratio(current.width, current.height),
+        display_mode: "unknown".into(), // Fullscreen/windowed describes the game, not the desktop.
+        scaling_preference: "driver_managed".into(), // NVIDIA scaling lives in its own snapshot.
+        refresh_rate_policy: "MAX_AVAILABLE".into(),
+    })
+}
+
