+    fn ensure_file_within(root: &Path, path: &Path) -> Result<(), UserFacingError> {
+        let metadata = fs::symlink_metadata(path)
+            .map_err(|error| io_error("Could not inspect a CS2 configuration file.", error))?;
+        if !metadata.file_type().is_file() || metadata.file_type().is_symlink() {
+            return Err(UserFacingError::new(
+                "A linked or non-regular CS2 configuration file was rejected.",
+                false,
+            ));
+        }
+        let canonical_root = root
+            .canonicalize()
+            .map_err(|error| io_error("Could not validate the CS2 configuration folder.", error))?;
+        let canonical_path = path
+            .canonicalize()
+            .map_err(|error| io_error("Could not validate a CS2 configuration path.", error))?;
+        if !canonical_path.starts_with(canonical_root) {
+            return Err(UserFacingError::new(
+                "A CS2 configuration path points outside the allowed folder.",
+                false,
+            ));
+        }
+        Ok(())
+    }
